[Unit]
Description=AWG Pi Gateway periodic bounded Xray subscription scan

[Timer]
OnBootSec=3min
# A bounded 30-second scheduler heartbeat drains changing large feeds;
# each exact node is still requalified no more than every five minutes.
OnUnitInactiveSec=30s
AccuracySec=30s
RandomizedDelaySec=15s
Unit=awg-xray-subscription-scan.service
Persistent=true

[Install]
WantedBy=timers.target
