[Unit]
Description=AWG Pi Gateway Telegram notification delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/awg-notify flush
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/awg-pbr/notify
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=65
