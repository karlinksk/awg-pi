[Unit]
Description=AWG Pi Gateway optional read-only service evidence schedule
Documentation=https://github.com/karlinksk/awg-pi/issues/83

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
RandomizedDelaySec=10s
AccuracySec=5s
Persistent=false
Unit=awg-service-evidence.service

[Install]
WantedBy=timers.target
