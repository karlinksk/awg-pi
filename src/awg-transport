#!/usr/bin/env bash
set -Eeuo pipefail

AWG_ENV_FILE="${AWG_ENV_FILE:-/etc/awg-pbr/env}"
AWG_COMMON_FILE="${AWG_COMMON_FILE:-/usr/local/lib/awg-pi/common.sh}"
MIHOMO_API="${MIHOMO_API:-http://127.0.0.1:9090}"
MIHOMO_PROXY="${MIHOMO_PROXY:-http://127.0.0.1:7890}"
MIHOMO_PROBE_URL="${MIHOMO_PROBE_URL:-https://api.ipify.org}"
MIHOMO_EXPECTED_EGRESS_IP_FILE="${MIHOMO_EXPECTED_EGRESS_IP_FILE:-${MIHOMO_EXPECTED_IP_FILE:-/etc/awg-pbr/transports/mihomo/expected-egress-ip}}"
MIHOMO_TUN_IF="${MIHOMO_TUN_IF:-mihomo0}"

[[ -r "$AWG_ENV_FILE" ]] && source "$AWG_ENV_FILE"
# shellcheck disable=SC1090
source "$AWG_COMMON_FILE"

VPN_IF="${VPN_IF:-awg0}"
HANDSHAKE_MAX_AGE="${HANDSHAKE_MAX_AGE:-180}"
IP_BIN="${IP_BIN:-ip}"
AWG_BIN="${AWG_BIN:-awg}"
CURL_BIN="${CURL_BIN:-curl}"
DATE_BIN="${DATE_BIN:-date}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
AWG_ROUTE_BIN="${AWG_ROUTE_BIN:-/usr/local/sbin/awg-route}"
HEALTH_SERVICE="${AWG_HEALTH_SERVICE:-awg-pbr-health.service}"
MIHOMO_SERVICE="${MIHOMO_SERVICE:-awg-mihomo.service}"
MAINTENANCE_LOCK="${AWG_LOCK_FILE:-/run/awg-maintenance.lock}"
SLEEP_BIN="${SLEEP_BIN:-sleep}"

usage(){
  cat <<'USAGE'
Usage:
  awg-transport get
  awg-transport status
  awg-transport list
  awg-transport check [awg|mihomo]
  awg-transport select awg|mihomo
USAGE
}

check_awg(){
  local raw hs now
  "$IP_BIN" link show "$VPN_IF" >/dev/null 2>&1 || return 1
  if ! raw="$("$AWG_BIN" show "$VPN_IF" latest-handshakes 2>/dev/null)"; then
    (( ${EUID:-$(id -u)} != 0 )) && return 3
    return 1
  fi
  hs="$(awk '$2>m{m=$2}END{print m+0}' <<<"$raw")"
  [[ "$hs" -gt 0 ]] || return 1
  now="$("$DATE_BIN" +%s)"
  (( now - hs <= HANDSHAKE_MAX_AGE ))
}

check_mihomo(){
  local egress expected
  "$IP_BIN" link show "$MIHOMO_TUN_IF" >/dev/null 2>&1 || return 1
  "$CURL_BIN" -fsS --max-time 2 "$MIHOMO_API/version" >/dev/null 2>&1 || return 1
  egress="$("$CURL_BIN" -4fsS -x "$MIHOMO_PROXY" --connect-timeout 5 --max-time 10 "$MIHOMO_PROBE_URL" 2>/dev/null)" || return 1
  [[ -n "$egress" ]] || return 1
  if [[ -r "$MIHOMO_EXPECTED_EGRESS_IP_FILE" ]]; then
    expected="$(tr -d '\r\n[:space:]' <"$MIHOMO_EXPECTED_EGRESS_IP_FILE")"
    [[ -n "$expected" && "$egress" == "$expected" ]] || return 1
  fi
}

check_transport(){
  case "${1:-}" in
    awg) check_awg ;;
    mihomo) check_mihomo ;;
    *) return 2 ;;
  esac
}

health_word(){
  local rc
  if check_transport "$1"; then
    printf '%s\n' healthy
  else
    rc=$?
    if (( rc == 3 )); then
      printf '%s\n' requires-root
    else
      printf '%s\n' down
    fi
  fi
}

atomic_transport_set(){
  local transport="$1" dir tmp
  dir="$(dirname "$AWG_TRANSPORT_FILE")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.transport.XXXXXX")"
  printf '%s\n' "$transport" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$AWG_TRANSPORT_FILE"
}

wait_transport_healthy(){
  local transport="$1" _
  for _ in $(seq 1 25); do
    if check_transport "$transport"; then
      return 0
    fi
    "$SLEEP_BIN" 0.2
  done
  return 1
}

select_transport(){
  local target="$1" previous had_state=0 previous_state="" started_mihomo=0 rc

  awg_transport_valid "$target" || {
    echo "Unsupported transport: $target" >&2
    return 2
  }

  if (( ${EUID:-$(id -u)} != 0 )); then
    exec sudo "$0" select "$target"
  fi

  exec 9>"$MAINTENANCE_LOCK"
  flock -x 9

  previous="$(awg_transport_get)"
  if [[ -e "$AWG_TRANSPORT_FILE" ]]; then
    had_state=1
    previous_state="$(cat "$AWG_TRANSPORT_FILE")"
  fi

  if [[ "$target" == "$previous" ]]; then
    if check_transport "$target"; then
      printf 'Transport already selected: %s\n' "$(awg_transport_label "$target")"
      return 0
    fi
    printf 'Selected transport is unhealthy: %s\n' "$target" >&2
    return 1
  fi

  case "$target" in
    awg)
      "$SYSTEMCTL_BIN" start "awg-quick@$VPN_IF.service"
      ;;
    mihomo)
      if ! "$SYSTEMCTL_BIN" is-active --quiet "$MIHOMO_SERVICE" 2>/dev/null; then
        "$SYSTEMCTL_BIN" start "$MIHOMO_SERVICE"
        started_mihomo=1
      fi
      ;;
  esac

  if ! wait_transport_healthy "$target"; then
    (( started_mihomo == 1 )) && "$SYSTEMCTL_BIN" stop "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
    printf 'Target transport is unhealthy; state unchanged: %s\n' "$target" >&2
    return 1
  fi

  "$SYSTEMCTL_BIN" stop "$HEALTH_SERVICE" >/dev/null 2>&1 || true

  rollback(){
    rc=$?
    trap - ERR
    "$SYSTEMCTL_BIN" stop "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    if (( had_state == 1 )); then
      printf '%s\n' "$previous_state" >"$AWG_TRANSPORT_FILE"
      chmod 600 "$AWG_TRANSPORT_FILE"
    else
      rm -f "$AWG_TRANSPORT_FILE"
    fi
    AWG_MAINTENANCE=1 "$AWG_ROUTE_BIN" reload >/dev/null 2>&1 || true
    (( started_mihomo == 1 )) && "$SYSTEMCTL_BIN" stop "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
    printf 'Transport switch failed; rollback restored %s.\n' "$previous" >&2
    exit "$rc"
  }
  trap rollback ERR

  atomic_transport_set "$target"
  AWG_MAINTENANCE=1 "$AWG_ROUTE_BIN" reload
  wait_transport_healthy "$target"
  "$SYSTEMCTL_BIN" is-active --quiet "$HEALTH_SERVICE"

  trap - ERR

  if [[ "$target" == awg && "$previous" == mihomo ]]; then
    "$SYSTEMCTL_BIN" stop "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
  fi

  printf 'Transport activated: %s\n' "$(awg_transport_label "$target")"
  printf 'Transport ID: %s\n' "$target"
}

cmd="${1:-status}"
case "$cmd" in
  get)
    awg_transport_get
    ;;
  check)
    transport="${2:-$(awg_transport_get)}"
    awg_transport_valid "$transport" || { echo "Unsupported transport: $transport" >&2; exit 2; }
    if check_transport "$transport"; then
      echo healthy
    else
      rc=$?
      if (( rc == 3 )); then
        echo requires-root
        exit 3
      fi
      echo down
      exit 1
    fi
    ;;
  status)
    transport="$(awg_transport_get)"
    printf 'Active transport: %s\n' "$(awg_transport_label "$transport")"
    printf 'Transport ID: %s\n' "$transport"
    printf 'Transport health: %s\n' "$(health_word "$transport")"
    ;;
  list)
    for transport in awg mihomo; do
      printf '%-8s %-12s %s\n' "$transport" "$(awg_transport_label "$transport")" "$(health_word "$transport")"
    done
    ;;
  select)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    select_transport "$2"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
