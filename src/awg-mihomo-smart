def assess_services_with_stage18(gate, proxy_port: int, *, force_media=False,
                                 video_module=None) -> dict:
    result = gate.assess(
        lambda url, **kw: gate.fetch(proxy_port, url, timeout=6, **kw))
    checks = result["checks"]
    if (checks["youtube_video"]["state"] != "UNKNOWN"
            or checks["openai_api"]["state"] != "PASS"
            or (checks["chatgpt_web"]["state"] != "PASS" and not force_media)):
        return result
    module = video_module if video_module is not None else load_video_decode_code()
    if module is None:
        return result
    state, reason = module.decode_24_frames(proxy_port)
    checks["youtube_video"] = {"state": state, "reason": reason}
    statuses = [checks[key]["state"] for key in
                ("openai_api", "chatgpt_web", "youtube_video")]
    result["status"] = "PASS" if all(s == "PASS" for s in statuses) else (
        "FAIL" if "FAIL" in statuses else "UNKNOWN")
    return result


