    [[ -r "$MIHOMO_XRAY_SELECTED" && -x "$MIHOMO_XRAY_CORE" ]] || {
      echo "Xray bridge selected but helper/core not installed" >&2
      exit 2
    }
    _xray_proxy_yaml=$'proxies:\n  - name: AWG-XRAY-VLESS-LOCAL\n    type: socks5\n    server: 127.0.0.1\n    port: 17892\n    udp: false'
    _xray_group_yaml=$'    proxies:\n      - AWG-XRAY-VLESS-LOCAL'
    ;;
  *) echo "MIHOMO_XRAY_VLESS_BRIDGE must be 0 or 1" >&2; exit 2 ;;
esac


