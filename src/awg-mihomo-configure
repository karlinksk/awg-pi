#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

AWG_COMMON_FILE="${AWG_COMMON_FILE:-/usr/local/lib/awg-pi/common.sh}"
AWG_LOCK_FILE="${AWG_LOCK_FILE:-/run/awg-maintenance.lock}"
MIHOMO_ENV_FILE="${MIHOMO_ENV_FILE:-/etc/awg-pbr/transports/mihomo/provider.env}"
MIHOMO_ENDPOINT_IP_FILE="${MIHOMO_ENDPOINT_IP_FILE:-/etc/awg-pbr/transports/mihomo/endpoint-ip}"
MIHOMO_EXPECTED_EGRESS_IP_FILE="${MIHOMO_EXPECTED_EGRESS_IP_FILE:-/etc/awg-pbr/transports/mihomo/expected-egress-ip}"
MIHOMO_LAST_FETCH_FILE="${MIHOMO_LAST_FETCH_FILE:-/var/lib/awg-pbr/mihomo/last-fetch-path}"
MIHOMO_LAST_FORMAT_FILE="${MIHOMO_LAST_FORMAT_FILE:-/var/lib/awg-pbr/mihomo/last-provider-format}"
MIHOMO_PROVIDER_FILE="${MIHOMO_PROVIDER_FILE:-/var/lib/awg-pbr/mihomo/providers/subscription.yaml}"
MIHOMO_CANDIDATE_FILE="${MIHOMO_CANDIDATE_FILE:-/var/lib/awg-pbr/mihomo/providers/candidate.yaml}"
MIHOMO_CANDIDATE_ENV_FILE="${MIHOMO_CANDIDATE_ENV_FILE:-/var/lib/awg-pbr/mihomo/providers/candidate.env}"
MIHOMO_CANDIDATE_FETCH_FILE="${MIHOMO_CANDIDATE_FETCH_FILE:-/var/lib/awg-pbr/mihomo/candidate-fetch-path}"
MIHOMO_CANDIDATE_FORMAT_FILE="${MIHOMO_CANDIDATE_FORMAT_FILE:-/var/lib/awg-pbr/mihomo/candidate-provider-format}"
MIHOMO_CONFIG_FILE="${MIHOMO_CONFIG_FILE:-/etc/awg-pbr/transports/mihomo/config.yaml}"
MIHOMO_INSTALLER="${MIHOMO_INSTALLER:-/usr/local/sbin/awg-mihomo-install}"
MIHOMO_UPDATER="${MIHOMO_UPDATER:-/usr/local/sbin/awg-mihomo-update}"
MIHOMO_PREPARE="${MIHOMO_PREPARE:-/usr/local/sbin/awg-mihomo-prepare}"
MIHOMO_PROVIDER_HELPER="${MIHOMO_PROVIDER_HELPER:-/usr/local/lib/awg-pi/mihomo-provider.py}"
MIHOMO_NODE_NAME_FILE="${MIHOMO_NODE_NAME_FILE:-/etc/awg-pbr/transports/mihomo/node-name}"
PYTHON_BIN="${PYTHON_BIN:-python3}"
TRANSPORT_CLI="${AWG_TRANSPORT_CLI:-/usr/local/sbin/awg-transport}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
AWG_FAILOPEN="${AWG_FAILOPEN:-/usr/local/sbin/awg-pbr-failopen}"
TRANSIT_ROUTING="${AWG_TRANSIT_ROUTING:-/usr/local/sbin/awg-transit-routing}"
HEALTH_SERVICE="${AWG_HEALTH_SERVICE:-awg-pbr-health.service}"
MIHOMO_SERVICE="${MIHOMO_SERVICE:-awg-mihomo.service}"
MIHOMO_UPDATE_SERVICE="${MIHOMO_UPDATE_SERVICE:-awg-mihomo-update.service}"
MIHOMO_UPDATE_TIMER="${MIHOMO_UPDATE_TIMER:-awg-mihomo-update.timer}"
MIHOMO_BIN="${MIHOMO_BIN:-/usr/local/bin/mihomo}"
SLEEP_BIN="${SLEEP_BIN:-sleep}"
OPENSSL_BIN="${OPENSSL_BIN:-openssl}"

# shellcheck disable=SC1090
source "$AWG_COMMON_FILE"

usage(){
  cat <<'USAGE'
Usage:
  awg-mihomo-configure init FILE
  awg-mihomo-configure apply FILE
  awg-mihomo-configure status
  awg-mihomo-configure provider-url set URL
  awg-mihomo-configure provider-url set-file FILE
  awg-mihomo-configure provider update [auto|mihomo|awg|router]
  awg-mihomo-configure provider import FILE
  awg-mihomo-configure provider stage-url-file FILE
  awg-mihomo-configure provider stage-file FILE [keep-source|local-only]
  awg-mihomo-configure provider candidate list
  awg-mihomo-configure provider candidate prepare NAME
  awg-mihomo-configure provider candidate commit NAME ENDPOINT_IP
  awg-mihomo-configure provider candidate clear
  awg-mihomo-configure provider format set auto|mihomo|vless|base64
  awg-mihomo-configure node list
  awg-mihomo-configure node prepare NAME
  awg-mihomo-configure node select NAME ENDPOINT_IP

For init FILE is a root-trusted environment file. Required:
  MIHOMO_PROVIDER_URL
Optional:
  MIHOMO_PROVIDER_PROFILE=standard|remnawave
  MIHOMO_PROVIDER_FORMAT=auto|mihomo|vless|base64
  MIHOMO_PROVIDER_HWID          # reuse an existing stable HWID if available
  MIHOMO_PROVIDER_AUTHORIZATION

For apply FILE is a root-trusted environment file. Required:
  MIHOMO_PROVIDER_URL
  MIHOMO_NODE_FILTER
  MIHOMO_ENDPOINT_IP

Optional:
  MIHOMO_EXPECTED_EGRESS_IP
  MIHOMO_PROVIDER_HWID
  MIHOMO_UPDATE_INTERFACE
  MIHOMO_UPDATE_SUFFIX
  MIHOMO_PROVIDER_AUTHORIZATION
USAGE
}

valid_ipv4(){
  local ip="$1" a b c d octet
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r a b c d <<<"$ip"
  for octet in "$a" "$b" "$c" "$d"; do
    (( 10#$octet >= 0 && 10#$octet <= 255 )) || return 1
  done
}

trusted_config_file(){
  local path="$1" owner mode
  [[ -f "$path" && ! -L "$path" ]] || return 1
  owner="$(stat -c '%u' -- "$path" 2>/dev/null)" || return 1
  mode="$(stat -c '%a' -- "$path" 2>/dev/null)" || return 1
  [[ "$owner" == 0 && "$mode" == 600 ]]
}

snapshot_path(){
  local path="$1" key="$2" snapshot="$3"
  if [[ -e "$path" ]]; then
    cp -a "$path" "$snapshot/$key"
    : >"$snapshot/$key.exists"
  fi
}

restore_path(){
  local path="$1" key="$2" snapshot="$3"
  if [[ -e "$snapshot/$key.exists" ]]; then
    mkdir -p "$(dirname "$path")"
    rm -f "$path"
    cp -a "$snapshot/$key" "$path"
  else
    rm -f "$path"
  fi
}

unit_enabled(){
  "$SYSTEMCTL_BIN" is-enabled --quiet "$1" >/dev/null 2>&1
}

unit_active(){
  "$SYSTEMCTL_BIN" is-active --quiet "$1" >/dev/null 2>&1
}

restore_unit_state(){
  local unit="$1" was_enabled="$2" was_active="$3"
  if [[ "$was_enabled" == 1 ]]; then
    "$SYSTEMCTL_BIN" enable "$unit" >/dev/null 2>&1 || true
  else
    "$SYSTEMCTL_BIN" disable "$unit" >/dev/null 2>&1 || true
  fi
  if [[ "$was_active" == 1 ]]; then
    "$SYSTEMCTL_BIN" start "$unit" >/dev/null 2>&1 || true
  else
    "$SYSTEMCTL_BIN" stop "$unit" >/dev/null 2>&1 || true
  fi
}

provider_format_requested(){
  local value=auto
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$MIHOMO_ENV_FILE"
    value="${MIHOMO_PROVIDER_FORMAT:-auto}"
  fi
  case "$value" in
    auto|mihomo|vless|base64) printf '%s\n' "$value" ;;
    *) printf '%s\n' invalid ;;
  esac
}

provider_url_redacted(){
  local value=""
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$MIHOMO_ENV_FILE"
    value="${MIHOMO_PROVIDER_URL:-}"
  fi
  if [[ "$value" =~ ^(https?://[^/]+) ]]; then
    printf '%s/[redacted]\n' "${BASH_REMATCH[1]}"
  elif [[ -n "$value" ]]; then
    printf '%s\n' configured-invalid
  else
    printf '%s\n' none
  fi
}

status_cmd(){
  printf 'Configured: %s\n' "$([[ -r "$MIHOMO_ENV_FILE" ]] && echo yes || echo no)"
  printf 'Provider URL: %s\n' "$(provider_url_redacted)"
  printf 'Provider format requested: %s\n' "$(provider_format_requested)"
  printf 'Provider format detected: %s\n' "$([[ -r "$MIHOMO_LAST_FORMAT_FILE" ]] && cat "$MIHOMO_LAST_FORMAT_FILE" || echo none)"
  printf 'Provider cache: %s\n' "$([[ -r "$MIHOMO_PROVIDER_FILE" ]] && echo ready || echo missing)"
  printf 'Provider candidate: %s\n' "$([[ -r "$MIHOMO_CANDIDATE_FILE" ]] && echo staged || echo none)"
  printf 'Selected node: %s\n' "$([[ -r "$MIHOMO_NODE_NAME_FILE" ]] && cat "$MIHOMO_NODE_NAME_FILE" || echo unknown)"
  printf 'Endpoint: %s\n' "$([[ -r "$MIHOMO_ENDPOINT_IP_FILE" ]] && cat "$MIHOMO_ENDPOINT_IP_FILE" || echo none)"
  printf 'Last fetch path: %s\n' "$([[ -r "$MIHOMO_LAST_FETCH_FILE" ]] && cat "$MIHOMO_LAST_FETCH_FILE" || echo none)"
  printf 'Runtime config: %s\n' "$([[ -r "$MIHOMO_CONFIG_FILE" ]] && echo ready || echo missing)"
  printf 'Binary: %s\n' "$([[ -x "$MIHOMO_BIN" ]] && "$MIHOMO_BIN" -v 2>/dev/null | head -n1 || echo missing)"
  printf 'Service: %s\n' "$("$SYSTEMCTL_BIN" is-active "$MIHOMO_SERVICE" 2>/dev/null || true)"
  printf 'Update timer: %s\n' "$("$SYSTEMCTL_BIN" is-active "$MIHOMO_UPDATE_TIMER" 2>/dev/null || true)"
  if [[ -x "$TRANSPORT_CLI" ]]; then
    "$TRANSPORT_CLI" check mihomo 2>/dev/null || true
  fi
}

write_env_key(){
  local file="$1" key="$2" value="$3" dir tmp
  dir="$(dirname "$file")"
  mkdir -p "$dir"
  chmod 700 "$dir"
  tmp="$(mktemp "$dir/.provider-env.XXXXXX")"
  if [[ -r "$file" ]]; then
    grep -Ev "^${key}=" "$file" >"$tmp" || true
  fi
  printf '%s=%q\n' "$key" "$value" >>"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

provider_url_set(){
  local url="$1" snapshot
  [[ "$url" =~ ^https?://[^[:space:]]+$ ]] || {
    echo "Provider URL must be an http(s) URL without whitespace" >&2
    return 2
  }

  snapshot="$(mktemp)"
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    cp -a "$MIHOMO_ENV_FILE" "$snapshot"
  else
    : >"$snapshot"
  fi

  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_PROVIDER_URL "$url"

  if ! MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
       MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
       MIHOMO_BIN="$MIHOMO_BIN" \
       MIHOMO_LAST_FETCH_FILE="$MIHOMO_LAST_FETCH_FILE" \
       MIHOMO_LAST_FORMAT_FILE="$MIHOMO_LAST_FORMAT_FILE" \
       MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
       "$MIHOMO_UPDATER" --mode auto; then
    if [[ -s "$snapshot" ]]; then
      install -m 600 "$snapshot" "$MIHOMO_ENV_FILE"
    else
      rm -f "$MIHOMO_ENV_FILE"
    fi
    rm -f "$snapshot"
    echo "Provider URL update failed; previous URL restored." >&2
    return 1
  fi

  rm -f "$snapshot"
  printf 'MIHOMO_PROVIDER_URL=UPDATED\n'
}

provider_url_set_file(){
  local source_file="$1"
  local MIHOMO_PROVIDER_URL=""

  trusted_config_file "$source_file" || {
    echo "Provider URL file must be root-owned mode 0600: $source_file" >&2
    return 2
  }

  # shellcheck disable=SC1090
  source "$source_file"
  [[ -n "$MIHOMO_PROVIDER_URL" ]] || {
    echo "Provider URL file does not define MIHOMO_PROVIDER_URL" >&2
    return 2
  }
  provider_url_set "$MIHOMO_PROVIDER_URL"
}

provider_update(){
  local mode="${1:-auto}"
  [[ "$mode" == router ]] && mode=direct
  case "$mode" in auto|direct|mihomo|awg) ;; *) return 2 ;; esac
  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
  MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
  MIHOMO_BIN="$MIHOMO_BIN" \
  MIHOMO_LAST_FETCH_FILE="$MIHOMO_LAST_FETCH_FILE" \
  MIHOMO_LAST_FORMAT_FILE="$MIHOMO_LAST_FORMAT_FILE" \
  MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
    "$MIHOMO_UPDATER" --mode "$mode"
}

provider_import(){
  local file="$1"
  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
  MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
  MIHOMO_BIN="$MIHOMO_BIN" \
  MIHOMO_LAST_FETCH_FILE="$MIHOMO_LAST_FETCH_FILE" \
  MIHOMO_LAST_FORMAT_FILE="$MIHOMO_LAST_FORMAT_FILE" \
  MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
    "$MIHOMO_UPDATER" --file "$file"
}

prepare_candidate_env(){
  local dir
  dir="$(dirname "$MIHOMO_CANDIDATE_ENV_FILE")"
  mkdir -p "$dir"
  chmod 700 "$dir"
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    install -m 600 "$MIHOMO_ENV_FILE" "$MIHOMO_CANDIDATE_ENV_FILE"
  else
    {
      printf 'MIHOMO_PROVIDER_PROFILE=%q\n' standard
      printf 'MIHOMO_PROVIDER_FORMAT=%q\n' auto
      printf 'MIHOMO_FETCH_MODE=%q\n' auto
    } >"$MIHOMO_CANDIDATE_ENV_FILE"
    chmod 600 "$MIHOMO_CANDIDATE_ENV_FILE"
  fi
}

candidate_clear(){
  rm -f "$MIHOMO_CANDIDATE_FILE" "$MIHOMO_CANDIDATE_ENV_FILE" \
    "$MIHOMO_CANDIDATE_FETCH_FILE" "$MIHOMO_CANDIDATE_FORMAT_FILE"
  printf 'MIHOMO_PROVIDER_CANDIDATE=CLEARED\n'
}

provider_stage_url_file(){
  local source_file="$1" MIHOMO_PROVIDER_URL=""
  trusted_config_file "$source_file" || {
    echo "Provider URL file must be root-owned mode 0600: $source_file" >&2
    return 2
  }
  # shellcheck disable=SC1090
  source "$source_file"
  [[ "$MIHOMO_PROVIDER_URL" =~ ^https?://[^[:space:]]+$ ]] || {
    echo "Provider URL file does not contain a valid MIHOMO_PROVIDER_URL" >&2
    return 2
  }

  prepare_candidate_env
  write_env_key "$MIHOMO_CANDIDATE_ENV_FILE" MIHOMO_PROVIDER_URL "$MIHOMO_PROVIDER_URL"
  if ! MIHOMO_ENV_FILE="$MIHOMO_CANDIDATE_ENV_FILE" \
       MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
       MIHOMO_CANDIDATE_FILE="$MIHOMO_CANDIDATE_FILE" \
       MIHOMO_CANDIDATE_FETCH_FILE="$MIHOMO_CANDIDATE_FETCH_FILE" \
       MIHOMO_CANDIDATE_FORMAT_FILE="$MIHOMO_CANDIDATE_FORMAT_FILE" \
       MIHOMO_BIN="$MIHOMO_BIN" MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
       "$MIHOMO_UPDATER" --stage-only --mode auto; then
    rm -f "$MIHOMO_CANDIDATE_ENV_FILE"
    return 1
  fi
  printf 'MIHOMO_PROVIDER_SOURCE=URL_STAGED\n'
}

provider_stage_file(){
  local file="$1" source_mode="${2:-keep-source}"
  [[ -f "$file" && -r "$file" && ! -L "$file" ]] || {
    echo "Provider input is not a readable regular file: $file" >&2
    return 2
  }
  case "$source_mode" in keep-source|local-only) ;; *) return 2 ;; esac

  prepare_candidate_env
  if [[ "$source_mode" == local-only ]]; then
    remove_env_key "$MIHOMO_CANDIDATE_ENV_FILE" MIHOMO_PROVIDER_URL
    remove_env_key "$MIHOMO_CANDIDATE_ENV_FILE" MIHOMO_UPDATE_SUFFIX
  fi
  if ! MIHOMO_ENV_FILE="$MIHOMO_CANDIDATE_ENV_FILE" \
       MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
       MIHOMO_CANDIDATE_FILE="$MIHOMO_CANDIDATE_FILE" \
       MIHOMO_CANDIDATE_FETCH_FILE="$MIHOMO_CANDIDATE_FETCH_FILE" \
       MIHOMO_CANDIDATE_FORMAT_FILE="$MIHOMO_CANDIDATE_FORMAT_FILE" \
       MIHOMO_BIN="$MIHOMO_BIN" MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
       "$MIHOMO_UPDATER" --stage-only --file "$file"; then
    rm -f "$MIHOMO_CANDIDATE_ENV_FILE"
    return 1
  fi
  printf 'MIHOMO_PROVIDER_SOURCE=%s\n' "$source_mode"
}

candidate_info_json(){
  local name="$1"
  [[ -r "$MIHOMO_CANDIDATE_FILE" ]] || {
    echo "No staged Mihomo provider candidate" >&2
    return 1
  }
  "$PYTHON_BIN" "$MIHOMO_PROVIDER_HELPER" info "$MIHOMO_CANDIDATE_FILE" "$name"
}

candidate_list(){
  [[ -r "$MIHOMO_CANDIDATE_FILE" ]] || {
    echo "No staged Mihomo provider candidate" >&2
    return 1
  }
  "$PYTHON_BIN" "$MIHOMO_PROVIDER_HELPER" list "$MIHOMO_CANDIDATE_FILE" --format tsv
}

candidate_prepare(){
  local name="$1" info
  info="$(candidate_info_json "$name")" || return
  printf 'Candidate node: %s\n' "$(jq -r '.name' <<<"$info")"
  printf 'Type: %s\n' "$(jq -r '.type' <<<"$info")"
  printf 'Provider server: %s:%s\n' "$(jq -r '.server' <<<"$info")" "$(jq -r '.port' <<<"$info")"
  printf 'Resolved IPv4 endpoints:\n'
  jq -r '.endpoint_ips[] | "  - " + .' <<<"$info"
}

candidate_commit(){
  local name="$1" endpoint="$2" current mode info filter snapshot rc healthy=0 provider_has_url=0
  local service_enabled=0 service_active=0 timer_enabled=0 timer_active=0 health_was_active=0

  valid_ipv4 "$endpoint" || { echo "Selected endpoint must be valid IPv4" >&2; return 2; }
  info="$(candidate_info_json "$name")" || return
  jq -e --arg ip "$endpoint" '.endpoint_ips | index($ip) != null' <<<"$info" >/dev/null || {
    echo "Selected endpoint is not one of the candidate node IPv4 addresses" >&2
    return 2
  }
  filter="$(jq -r '.filter_regex' <<<"$info")"
  current="$(awg_transport_get)"
  mode="$(awg_mode_get)"

  exec 9>"$AWG_LOCK_FILE"
  flock -x 9
  [[ "$(awg_transport_get)" == "$current" ]] || { echo "Transport changed; retry candidate commit." >&2; return 1; }

  snapshot="$(mktemp -d)"
  chmod 700 "$snapshot"
  snapshot_path "$MIHOMO_ENV_FILE" env "$snapshot"
  snapshot_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
  snapshot_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
  snapshot_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
  snapshot_path "$MIHOMO_NODE_NAME_FILE" node "$snapshot"
  snapshot_path "$MIHOMO_CONFIG_FILE" config "$snapshot"
  snapshot_path "$MIHOMO_LAST_FETCH_FILE" fetch "$snapshot"
  snapshot_path "$MIHOMO_LAST_FORMAT_FILE" format "$snapshot"

  unit_enabled "$MIHOMO_SERVICE" && service_enabled=1 || true
  unit_active "$MIHOMO_SERVICE" && service_active=1 || true
  unit_enabled "$MIHOMO_UPDATE_TIMER" && timer_enabled=1 || true
  unit_active "$MIHOMO_UPDATE_TIMER" && timer_active=1 || true
  unit_active "$HEALTH_SERVICE" && health_was_active=1 || true

  rollback_candidate(){
    rc=$?
    trap - ERR
    "$SYSTEMCTL_BIN" stop "$MIHOMO_UPDATE_TIMER" "$MIHOMO_UPDATE_SERVICE" "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
    restore_path "$MIHOMO_ENV_FILE" env "$snapshot"
    restore_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
    restore_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
    restore_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
    restore_path "$MIHOMO_NODE_NAME_FILE" node "$snapshot"
    restore_path "$MIHOMO_CONFIG_FILE" config "$snapshot"
    restore_path "$MIHOMO_LAST_FETCH_FILE" fetch "$snapshot"
    restore_path "$MIHOMO_LAST_FORMAT_FILE" format "$snapshot"
    "$SYSTEMCTL_BIN" daemon-reload >/dev/null 2>&1 || true
    restore_unit_state "$MIHOMO_SERVICE" "$service_enabled" "$service_active"
    restore_unit_state "$MIHOMO_UPDATE_TIMER" "$timer_enabled" "$timer_active"
    if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
      "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    fi
    rm -rf "$snapshot"
    echo "Candidate commit failed; previous live provider/node restored and candidate preserved." >&2
    exit "$rc"
  }
  trap rollback_candidate ERR

  if [[ "$current" == mihomo ]]; then
    "$SYSTEMCTL_BIN" stop "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    case "$mode" in
      selective) "$AWG_FAILOPEN" >/dev/null 2>&1 || true ;;
      transit) "$TRANSIT_ROUTING" disable >/dev/null ;;
      *) return 1 ;;
    esac
  fi

  "$SYSTEMCTL_BIN" stop "$MIHOMO_UPDATE_TIMER" "$MIHOMO_UPDATE_SERVICE" "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
  mkdir -p "$(dirname "$MIHOMO_PROVIDER_FILE")" "$(dirname "$MIHOMO_ENV_FILE")" \
    "$(dirname "$MIHOMO_ENDPOINT_IP_FILE")" "$(dirname "$MIHOMO_NODE_NAME_FILE")"
  chmod 700 "$(dirname "$MIHOMO_PROVIDER_FILE")" "$(dirname "$MIHOMO_ENV_FILE")"
  install -m 600 "$MIHOMO_CANDIDATE_FILE" "$MIHOMO_PROVIDER_FILE"
  [[ ! -r "$MIHOMO_CANDIDATE_ENV_FILE" ]] || install -m 600 "$MIHOMO_CANDIDATE_ENV_FILE" "$MIHOMO_ENV_FILE"
  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_NODE_FILTER "$filter"
  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_ENDPOINT_IP "$endpoint"
  remove_env_key "$MIHOMO_ENV_FILE" MIHOMO_EXPECTED_EGRESS_IP
  printf '%s\n' "$endpoint" >"$MIHOMO_ENDPOINT_IP_FILE"; chmod 600 "$MIHOMO_ENDPOINT_IP_FILE"
  printf '%s\n' "$name" >"$MIHOMO_NODE_NAME_FILE"; chmod 600 "$MIHOMO_NODE_NAME_FILE"
  rm -f "$MIHOMO_EXPECTED_EGRESS_IP_FILE"
  [[ ! -r "$MIHOMO_CANDIDATE_FETCH_FILE" ]] || install -m 600 "$MIHOMO_CANDIDATE_FETCH_FILE" "$MIHOMO_LAST_FETCH_FILE"
  [[ ! -r "$MIHOMO_CANDIDATE_FORMAT_FILE" ]] || install -m 600 "$MIHOMO_CANDIDATE_FORMAT_FILE" "$MIHOMO_LAST_FORMAT_FILE"

  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
    MIHOMO_CONFIG_FILE="$MIHOMO_CONFIG_FILE" MIHOMO_BIN="$MIHOMO_BIN" "$MIHOMO_PREPARE"
  "$SYSTEMCTL_BIN" daemon-reload
  "$SYSTEMCTL_BIN" enable --now "$MIHOMO_SERVICE"

  for _ in $(seq 1 30); do
    if "$TRANSPORT_CLI" check mihomo >/dev/null 2>&1; then healthy=1; break; fi
    "$SLEEP_BIN" 0.2
  done
  (( healthy == 1 ))

  # shellcheck disable=SC1090
  source "$MIHOMO_ENV_FILE"
  [[ -n "${MIHOMO_PROVIDER_URL:-}" ]] && provider_has_url=1 || true
  if (( provider_has_url == 1 )); then
    "$SYSTEMCTL_BIN" enable --now "$MIHOMO_UPDATE_TIMER" >/dev/null 2>&1 || true
  else
    "$SYSTEMCTL_BIN" disable "$MIHOMO_UPDATE_TIMER" >/dev/null 2>&1 || true
  fi
  if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
    "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE"
  fi

  trap - ERR
  rm -rf "$snapshot"
  candidate_clear >/dev/null
  printf 'MIHOMO_PROVIDER=COMMITTED\n'
  printf 'MIHOMO_NODE=%s\n' "$name"
  printf 'MIHOMO_ENDPOINT_IP=%s\n' "$endpoint"
  printf 'MIHOMO_HEALTH=healthy\n'
  printf 'ACTIVE_TRANSPORT=%s\n' "$(awg_transport_get)"
}

provider_format_set(){
  local format="$1" snapshot
  case "$format" in
    auto|mihomo|vless|base64) ;;
    *)
      echo "Unsupported provider format: $format" >&2
      return 2
      ;;
  esac

  [[ -r "$MIHOMO_ENV_FILE" ]] || {
    echo "Mihomo provider is not initialized" >&2
    return 1
  }

  snapshot="$(mktemp)"
  cp -a "$MIHOMO_ENV_FILE" "$snapshot"
  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_PROVIDER_FORMAT "$format"

  if ! MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
       MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
       MIHOMO_BIN="$MIHOMO_BIN" \
       MIHOMO_LAST_FETCH_FILE="$MIHOMO_LAST_FETCH_FILE" \
       MIHOMO_LAST_FORMAT_FILE="$MIHOMO_LAST_FORMAT_FILE" \
       MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
       "$MIHOMO_UPDATER" --mode auto --format "$format"; then
    install -m 600 "$snapshot" "$MIHOMO_ENV_FILE"
    rm -f "$snapshot"
    echo "Provider format change failed; previous format restored." >&2
    return 1
  fi

  rm -f "$snapshot"
  printf 'MIHOMO_PROVIDER_FORMAT=%s\n' "$format"
}

remove_env_key(){
  local file="$1" key="$2" dir tmp
  [[ -r "$file" ]] || return 0
  dir="$(dirname "$file")"
  tmp="$(mktemp "$dir/.provider-env.XXXXXX")"
  grep -Ev "^${key}=" "$file" >"$tmp" || true
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

node_info_json(){
  local name="$1"
  [[ -r "$MIHOMO_PROVIDER_FILE" ]] || {
    echo "Provider cache is missing: $MIHOMO_PROVIDER_FILE" >&2
    return 1
  }
  [[ -x "$MIHOMO_PROVIDER_HELPER" || -r "$MIHOMO_PROVIDER_HELPER" ]] || {
    echo "Mihomo provider helper is unavailable: $MIHOMO_PROVIDER_HELPER" >&2
    return 2
  }
  "$PYTHON_BIN" "$MIHOMO_PROVIDER_HELPER" info "$MIHOMO_PROVIDER_FILE" "$name"
}

node_list(){
  [[ -r "$MIHOMO_PROVIDER_FILE" ]] || {
    echo "Provider cache is missing: $MIHOMO_PROVIDER_FILE" >&2
    return 1
  }
  "$PYTHON_BIN" "$MIHOMO_PROVIDER_HELPER" list "$MIHOMO_PROVIDER_FILE" --format tsv
}

node_prepare(){
  local name="$1" info
  info="$(node_info_json "$name")" || return
  printf 'Node: %s\n' "$(jq -r '.name' <<<"$info")"
  printf 'Type: %s\n' "$(jq -r '.type' <<<"$info")"
  printf 'Provider server: %s:%s\n' "$(jq -r '.server' <<<"$info")" "$(jq -r '.port' <<<"$info")"
  printf 'Resolved IPv4 endpoints:\n'
  jq -r '.endpoint_ips[] | "  - " + .' <<<"$info"
  printf 'Gateway DIRECT policy required: yes\n'
  printf 'Required scope: all Pi-originated transport/control traffic must bypass router-side VPN policy\n'
  printf 'Selected endpoint: %s:%s\n' "$(jq -r '.server' <<<"$info")" "$(jq -r '.port' <<<"$info")"
  printf 'NEXT: node select does not require a per-endpoint MikroTik rule.\n'
}

node_select(){
  local name="$1" endpoint="$2"
  local current mode info filter snapshot rc service_enabled=0 service_active=0 healthy=0
  local health_was_active=0 provider_has_url=0

  valid_ipv4 "$endpoint" || {
    echo "Selected endpoint must be a valid IPv4 address" >&2
    return 2
  }

  current="$(awg_transport_get)"
  mode="$(awg_mode_get)"

  info="$(node_info_json "$name")" || return
  jq -e --arg ip "$endpoint" '.endpoint_ips | index($ip) != null' <<<"$info" >/dev/null || {
    echo "Selected endpoint is not one of the current IPv4 addresses for this node" >&2
    return 2
  }
  filter="$(jq -r '.filter_regex' <<<"$info")"

  exec 9>"$AWG_LOCK_FILE"
  flock -x 9

  [[ "$(awg_transport_get)" == "$current" ]] || {
    echo "Transport changed while preparing node selection; retry." >&2
    return 1
  }

  snapshot="$(mktemp -d)"
  chmod 700 "$snapshot"
  snapshot_path "$MIHOMO_ENV_FILE" env "$snapshot"
  snapshot_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
  snapshot_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
  snapshot_path "$MIHOMO_NODE_NAME_FILE" node "$snapshot"
  snapshot_path "$MIHOMO_CONFIG_FILE" config "$snapshot"

  unit_enabled "$MIHOMO_SERVICE" && service_enabled=1 || true
  unit_active "$MIHOMO_SERVICE" && service_active=1 || true
  unit_active "$HEALTH_SERVICE" && health_was_active=1 || true

  rollback_node(){
    rc=$?
    trap - ERR
    "$SYSTEMCTL_BIN" stop "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
    restore_path "$MIHOMO_ENV_FILE" env "$snapshot"
    restore_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
    restore_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
    restore_path "$MIHOMO_NODE_NAME_FILE" node "$snapshot"
    restore_path "$MIHOMO_CONFIG_FILE" config "$snapshot"
    "$SYSTEMCTL_BIN" daemon-reload >/dev/null 2>&1 || true
    restore_unit_state "$MIHOMO_SERVICE" "$service_enabled" "$service_active"
    if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
      "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    fi
    rm -rf "$snapshot"
    echo "Mihomo node change failed; previous node configuration restored." >&2
    exit "$rc"
  }
  trap rollback_node ERR

  # Reconfiguring the active Mihomo transport must never depend on AWG.
  # Quiesce only the client dataplane: Selective becomes FAIL-OPEN, while
  # Transit drops new forwarded traffic because its forward guard stays closed.
  if [[ "$current" == mihomo ]]; then
    "$SYSTEMCTL_BIN" stop "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    case "$mode" in
      selective) "$AWG_FAILOPEN" >/dev/null 2>&1 || true ;;
      transit) "$TRANSIT_ROUTING" disable >/dev/null ;;
      *) echo "Invalid operating mode during Mihomo node change: $mode" >&2; return 1 ;;
    esac
  fi

  "$SYSTEMCTL_BIN" stop "$MIHOMO_SERVICE" >/dev/null 2>&1 || true

  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_NODE_FILTER "$filter"
  write_env_key "$MIHOMO_ENV_FILE" MIHOMO_ENDPOINT_IP "$endpoint"
  remove_env_key "$MIHOMO_ENV_FILE" MIHOMO_EXPECTED_EGRESS_IP
  printf '%s\n' "$endpoint" >"$MIHOMO_ENDPOINT_IP_FILE"
  chmod 600 "$MIHOMO_ENDPOINT_IP_FILE"
  printf '%s\n' "$name" >"$MIHOMO_NODE_NAME_FILE"
  chmod 600 "$MIHOMO_NODE_NAME_FILE"
  rm -f "$MIHOMO_EXPECTED_EGRESS_IP_FILE"

  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
  MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
  MIHOMO_CONFIG_FILE="$MIHOMO_CONFIG_FILE" \
  MIHOMO_BIN="$MIHOMO_BIN" \
    "$MIHOMO_PREPARE"

  "$SYSTEMCTL_BIN" daemon-reload
  "$SYSTEMCTL_BIN" enable --now "$MIHOMO_SERVICE"

  for _ in $(seq 1 30); do
    if "$TRANSPORT_CLI" check mihomo >/dev/null 2>&1; then
      healthy=1
      break
    fi
    "$SLEEP_BIN" 0.2
  done
  (( healthy == 1 ))

  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$MIHOMO_ENV_FILE"
    [[ -n "${MIHOMO_PROVIDER_URL:-}" ]] && provider_has_url=1 || true
  fi
  if (( provider_has_url == 1 )); then
    "$SYSTEMCTL_BIN" enable --now "$MIHOMO_UPDATE_TIMER" >/dev/null 2>&1 || true
  else
    "$SYSTEMCTL_BIN" disable "$MIHOMO_UPDATE_TIMER" >/dev/null 2>&1 || true
  fi

  if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
    "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE"
  fi

  trap - ERR
  rm -rf "$snapshot"

  printf 'MIHOMO_NODE=%s\n' "$name"
  printf 'MIHOMO_ENDPOINT_IP=%s\n' "$endpoint"
  printf 'DIRECT_POLICY=gateway-wide\n'
  printf 'MIHOMO_HEALTH=healthy\n'
  printf 'ACTIVE_TRANSPORT=%s\n' "$(awg_transport_get)"
  if [[ "$current" == mihomo ]]; then
    printf 'DATAPLANE=restored\n'
  else
    printf 'NEXT=awg-transport select mihomo\n'
  fi
}

init_cmd(){
  local source_file="$1" tmp_input tmp_env snapshot rc profile provider_format url hwid="" suffix=""
  local hwid_generated=0 node_count=0

  trusted_config_file "$source_file" || {
    echo "Init file must be a root-owned regular file with mode 0600: $source_file" >&2
    return 2
  }

  [[ "$(awg_transport_get)" != mihomo ]] || {
    echo "Refusing initial Mihomo setup while Mihomo is the active transport" >&2
    return 1
  }

  if [[ -r "$MIHOMO_ENV_FILE" || -r "$MIHOMO_PROVIDER_FILE" ]]; then
    echo "Mihomo provider is already initialized; use provider-url/provider update instead." >&2
    return 1
  fi

  tmp_input="$(mktemp)"
  tmp_env="$(mktemp)"
  snapshot="$(mktemp -d)"
  chmod 700 "$snapshot"
  install -m 600 "$source_file" "$tmp_input"

  # shellcheck disable=SC1090
  source "$tmp_input"

  : "${MIHOMO_PROVIDER_URL:?MIHOMO_PROVIDER_URL is required}"
  url="$MIHOMO_PROVIDER_URL"
  profile="${MIHOMO_PROVIDER_PROFILE:-standard}"
  provider_format="${MIHOMO_PROVIDER_FORMAT:-auto}"

  case "$provider_format" in
    auto|mihomo|vless|base64) ;;
    *)
      echo "Unsupported MIHOMO_PROVIDER_FORMAT: $provider_format" >&2
      rm -f "$tmp_input" "$tmp_env"
      rm -rf "$snapshot"
      return 2
      ;;
  esac

  [[ "$url" =~ ^https?://[^[:space:]]+$ ]] || {
    echo "MIHOMO_PROVIDER_URL must be an http(s) URL without whitespace" >&2
    rm -f "$tmp_input" "$tmp_env"
    rm -rf "$snapshot"
    return 2
  }

  case "$profile" in
    standard)
      ;;
    remnawave)
      hwid="${MIHOMO_PROVIDER_HWID:-}"
      if [[ -z "$hwid" ]]; then
        hwid="$("$OPENSSL_BIN" rand -hex 16)"
        hwid_generated=1
      fi
      [[ "$hwid" =~ ^[A-Za-z0-9._:-]{8,128}$ ]] || {
        echo "MIHOMO_PROVIDER_HWID has an invalid format" >&2
        rm -f "$tmp_input" "$tmp_env"
        rm -rf "$snapshot"
        return 2
      }
      if [[ "${url%/}" != */mihomo ]]; then
        suffix=mihomo
      fi
      ;;
    *)
      echo "Unsupported MIHOMO_PROVIDER_PROFILE: $profile" >&2
      rm -f "$tmp_input" "$tmp_env"
      rm -rf "$snapshot"
      return 2
      ;;
  esac

  {
    printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
    printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
    printf 'MIHOMO_PROVIDER_FORMAT=%q\n' "$provider_format"
    printf 'MIHOMO_FETCH_MODE=%q\n' auto
    [[ -z "$hwid" ]] || printf 'MIHOMO_PROVIDER_HWID=%q\n' "$hwid"
    [[ -z "$suffix" ]] || printf 'MIHOMO_UPDATE_SUFFIX=%q\n' "$suffix"
    [[ -z "${MIHOMO_PROVIDER_AUTHORIZATION:-}" ]] ||       printf 'MIHOMO_PROVIDER_AUTHORIZATION=%q\n' "$MIHOMO_PROVIDER_AUTHORIZATION"
    [[ -z "${MIHOMO_PROVIDER_USER_AGENT:-}" ]] ||       printf 'MIHOMO_PROVIDER_USER_AGENT=%q\n' "$MIHOMO_PROVIDER_USER_AGENT"
  } >"$tmp_env"
  chmod 600 "$tmp_env"

  exec 9>"$AWG_LOCK_FILE"
  flock -x 9

  snapshot_path "$MIHOMO_ENV_FILE" env "$snapshot"
  snapshot_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
  snapshot_path "$MIHOMO_LAST_FETCH_FILE" fetch "$snapshot"
  snapshot_path "$MIHOMO_LAST_FORMAT_FILE" format "$snapshot"

  rollback_init(){
    rc=$?
    trap - ERR
    restore_path "$MIHOMO_ENV_FILE" env "$snapshot"
    restore_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
    restore_path "$MIHOMO_LAST_FETCH_FILE" fetch "$snapshot"
    restore_path "$MIHOMO_LAST_FORMAT_FILE" format "$snapshot"
    rm -f "$tmp_input" "$tmp_env"
    rm -rf "$snapshot"
    echo "Mihomo initialization failed; previous provider state restored." >&2
    exit "$rc"
  }
  trap rollback_init ERR

  mkdir -p "$(dirname "$MIHOMO_ENV_FILE")" "$(dirname "$MIHOMO_PROVIDER_FILE")"
  chmod 700 "$(dirname "$MIHOMO_ENV_FILE")" "$(dirname "$MIHOMO_PROVIDER_FILE")"
  install -m 600 "$tmp_env" "$MIHOMO_ENV_FILE"

  [[ -x "$MIHOMO_BIN" ]] || "$MIHOMO_INSTALLER"

  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
  MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
  MIHOMO_BIN="$MIHOMO_BIN" \
  MIHOMO_LAST_FETCH_FILE="$MIHOMO_LAST_FETCH_FILE" \
  MIHOMO_LAST_FORMAT_FILE="$MIHOMO_LAST_FORMAT_FILE" \
  MIHOMO_PROVIDER_HELPER="$MIHOMO_PROVIDER_HELPER" \
    "$MIHOMO_UPDATER" --cache-only --mode auto --format "$provider_format"

  if [[ -r "$MIHOMO_PROVIDER_FILE" && -r "$MIHOMO_PROVIDER_HELPER" ]]; then
    node_count="$("$PYTHON_BIN" "$MIHOMO_PROVIDER_HELPER" list "$MIHOMO_PROVIDER_FILE" 2>/dev/null |
      jq 'length' 2>/dev/null || echo 0)"
  fi

  trap - ERR
  rm -f "$tmp_input" "$tmp_env"
  rm -rf "$snapshot"

  printf 'MIHOMO_INITIALIZED=1\n'
  printf 'MIHOMO_PROVIDER_PROFILE=%s\n' "$profile"
  printf 'MIHOMO_PROVIDER_FORMAT=%s\n' "$provider_format"
  printf 'MIHOMO_PROVIDER_FORMAT_DETECTED=%s\n' "$([[ -r "$MIHOMO_LAST_FORMAT_FILE" ]] && cat "$MIHOMO_LAST_FORMAT_FILE" || echo unknown)"
  printf 'MIHOMO_HWID_GENERATED=%s\n' "$hwid_generated"
  printf 'MIHOMO_NODE_COUNT=%s\n' "$node_count"
  printf 'ACTIVE_TRANSPORT=%s\n' "$(awg_transport_get)"
  printf 'NEXT=awg-mihomo-configure node list\n'
}

apply_cmd(){
  local source_file="$1" current mode tmp_env snapshot rc
  local service_enabled=0 service_active=0 timer_enabled=0 timer_active=0 health_was_active=0
  local expected_egress=""

  [[ -r "$source_file" ]] || {
    echo "Configuration file is not readable: $source_file" >&2
    return 2
  }
  trusted_config_file "$source_file" || {
    echo "Configuration file must be a root-owned regular file with mode 0600: $source_file" >&2
    return 2
  }

  current="$(awg_transport_get)"
  mode="$(awg_mode_get)"

  exec 9>"$AWG_LOCK_FILE"
  flock -x 9

  tmp_env="$(mktemp)"
  snapshot="$(mktemp -d)"
  chmod 700 "$snapshot"
  trap "$(printf 'rm -f -- %q; rm -rf -- %q' "$tmp_env" "$snapshot")" EXIT
  install -m 600 "$source_file" "$tmp_env"

  # shellcheck disable=SC1090
  source "$tmp_env"

  : "${MIHOMO_PROVIDER_URL:?MIHOMO_PROVIDER_URL is required}"
  : "${MIHOMO_NODE_FILTER:?MIHOMO_NODE_FILTER is required}"
  : "${MIHOMO_ENDPOINT_IP:?MIHOMO_ENDPOINT_IP is required}"

  case "${MIHOMO_PROVIDER_FORMAT:-auto}" in
    auto|mihomo|vless|base64) ;;
    *)
      echo "Unsupported MIHOMO_PROVIDER_FORMAT: ${MIHOMO_PROVIDER_FORMAT}" >&2
      return 2
      ;;
  esac

  [[ "$MIHOMO_PROVIDER_URL" =~ ^https?://[^[:space:]]+$ ]] || {
    echo "MIHOMO_PROVIDER_URL must be an http(s) URL without whitespace" >&2
    return 2
  }
  [[ "$MIHOMO_NODE_FILTER" != *$'\n'* ]] || {
    echo "MIHOMO_NODE_FILTER must be one line" >&2
    return 2
  }
  valid_ipv4 "$MIHOMO_ENDPOINT_IP" || {
    echo "MIHOMO_ENDPOINT_IP must be a valid IPv4 address" >&2
    return 2
  }

  expected_egress="${MIHOMO_EXPECTED_EGRESS_IP:-}"
  if [[ -n "$expected_egress" ]]; then
    valid_ipv4 "$expected_egress" || {
      echo "MIHOMO_EXPECTED_EGRESS_IP must be a valid IPv4 address" >&2
      return 2
    }
  fi

  snapshot_path "$MIHOMO_ENV_FILE" env "$snapshot"
  snapshot_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
  snapshot_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
  snapshot_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
  snapshot_path "$MIHOMO_CONFIG_FILE" config "$snapshot"

  unit_enabled "$MIHOMO_SERVICE" && service_enabled=1 || true
  unit_active "$MIHOMO_SERVICE" && service_active=1 || true
  unit_enabled "$MIHOMO_UPDATE_TIMER" && timer_enabled=1 || true
  unit_active "$MIHOMO_UPDATE_TIMER" && timer_active=1 || true
  unit_active "$HEALTH_SERVICE" && health_was_active=1 || true

  rollback(){
    rc=$?
    trap - ERR
    "$SYSTEMCTL_BIN" stop "$MIHOMO_UPDATE_TIMER" "$MIHOMO_UPDATE_SERVICE" "$MIHOMO_SERVICE" >/dev/null 2>&1 || true
    restore_path "$MIHOMO_ENV_FILE" env "$snapshot"
    restore_path "$MIHOMO_ENDPOINT_IP_FILE" endpoint "$snapshot"
    restore_path "$MIHOMO_EXPECTED_EGRESS_IP_FILE" egress "$snapshot"
    restore_path "$MIHOMO_PROVIDER_FILE" provider "$snapshot"
    restore_path "$MIHOMO_CONFIG_FILE" config "$snapshot"
    "$SYSTEMCTL_BIN" daemon-reload >/dev/null 2>&1 || true
    restore_unit_state "$MIHOMO_SERVICE" "$service_enabled" "$service_active"
    restore_unit_state "$MIHOMO_UPDATE_TIMER" "$timer_enabled" "$timer_active"
    if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
      "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    fi
    rm -f "$tmp_env"
    rm -rf "$snapshot"
    echo "Mihomo configuration failed; previous state restored." >&2
    exit "$rc"
  }
  trap rollback ERR

  if [[ "$current" == mihomo ]]; then
    "$SYSTEMCTL_BIN" stop "$HEALTH_SERVICE" >/dev/null 2>&1 || true
    case "$mode" in
      selective) "$AWG_FAILOPEN" >/dev/null 2>&1 || true ;;
      transit) "$TRANSIT_ROUTING" disable >/dev/null ;;
      *) echo "Invalid operating mode during Mihomo reconfiguration: $mode" >&2; return 1 ;;
    esac
  fi

  "$SYSTEMCTL_BIN" stop "$MIHOMO_UPDATE_TIMER" "$MIHOMO_UPDATE_SERVICE" "$MIHOMO_SERVICE" >/dev/null 2>&1 || true

  mkdir -p "$(dirname "$MIHOMO_ENV_FILE")" "$(dirname "$MIHOMO_PROVIDER_FILE")"
  chmod 700 "$(dirname "$MIHOMO_ENV_FILE")" "$(dirname "$MIHOMO_PROVIDER_FILE")"
  install -m 600 "$tmp_env" "$MIHOMO_ENV_FILE"
  printf '%s\n' "$MIHOMO_ENDPOINT_IP" >"$MIHOMO_ENDPOINT_IP_FILE"
  chmod 600 "$MIHOMO_ENDPOINT_IP_FILE"

  if [[ -n "$expected_egress" ]]; then
    printf '%s\n' "$expected_egress" >"$MIHOMO_EXPECTED_EGRESS_IP_FILE"
    chmod 600 "$MIHOMO_EXPECTED_EGRESS_IP_FILE"
  else
    rm -f "$MIHOMO_EXPECTED_EGRESS_IP_FILE"
  fi

  [[ -x "$MIHOMO_BIN" ]] || "$MIHOMO_INSTALLER"

  MIHOMO_ENV_FILE="$MIHOMO_ENV_FILE" \
  MIHOMO_PROVIDER_FILE="$MIHOMO_PROVIDER_FILE" \
  MIHOMO_BIN="$MIHOMO_BIN" \
    "$MIHOMO_UPDATER"

  "$SYSTEMCTL_BIN" daemon-reload
  "$SYSTEMCTL_BIN" enable --now "$MIHOMO_SERVICE"
  "$SYSTEMCTL_BIN" enable --now "$MIHOMO_UPDATE_TIMER"

  healthy=0
  for _ in $(seq 1 30); do
    if "$TRANSPORT_CLI" check mihomo >/dev/null 2>&1; then
      healthy=1
      break
    fi
    "$SLEEP_BIN" 0.2
  done
  (( healthy == 1 ))

  if [[ "$current" == mihomo && "$health_was_active" == 1 ]]; then
    "$SYSTEMCTL_BIN" restart "$HEALTH_SERVICE"
  fi

  trap - ERR
  rm -f "$tmp_env"
  rm -rf "$snapshot"
  trap - EXIT

  printf 'MIHOMO_CONFIGURED=1\n'
  printf 'MIHOMO_HEALTH=healthy\n'
  printf 'ACTIVE_TRANSPORT=%s\n' "$(awg_transport_get)"
  printf 'NEXT=awg-transport select mihomo\n'
}

case "${1:-}" in
  init)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    init_cmd "$2"
    ;;
  apply)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    apply_cmd "$2"
    ;;
  status)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    status_cmd
    ;;
  provider-url)
    case "${2:-}" in
      set)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        provider_url_set "$3"
        ;;
      set-file)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        provider_url_set_file "$3"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  node)
    case "${2:-}" in
      list)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        node_list
        ;;
      prepare)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        node_prepare "$3"
        ;;
      select)
        [[ $# -eq 4 ]] || { usage >&2; exit 2; }
        node_select "$3" "$4"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  provider)
    case "${2:-}" in
      update)
        [[ $# -le 3 ]] || { usage >&2; exit 2; }
        provider_update "${3:-auto}"
        ;;
      import)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        provider_import "$3"
        ;;
      stage-url-file)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        provider_stage_url_file "$3"
        ;;
      stage-file)
        [[ $# -ge 3 && $# -le 4 ]] || { usage >&2; exit 2; }
        provider_stage_file "$3" "${4:-keep-source}"
        ;;
      candidate)
        case "${3:-}" in
          list)
            [[ $# -eq 3 ]] || { usage >&2; exit 2; }
            candidate_list
            ;;
          prepare)
            [[ $# -eq 4 ]] || { usage >&2; exit 2; }
            candidate_prepare "$4"
            ;;
          commit)
            [[ $# -eq 5 ]] || { usage >&2; exit 2; }
            candidate_commit "$4" "$5"
            ;;
          clear)
            [[ $# -eq 3 ]] || { usage >&2; exit 2; }
            candidate_clear
            ;;
          *)
            usage >&2
            exit 2
            ;;
        esac
        ;;
      format)
        [[ $# -eq 4 && "${3:-}" == set ]] || { usage >&2; exit 2; }
        provider_format_set "$4"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
