#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

# Persistent explicit user opt-in. Each invocation reloads this file; the monitor
# invokes node-policy afresh, so no transient systemd environment required.
MIHOMO_XRAY_AUTO_MODE_FILE="${MIHOMO_XRAY_AUTO_MODE_FILE:-/etc/awg-pbr/transports/mihomo/xray-auto.mode}"
_xray_auto_mode="$(cat "$MIHOMO_XRAY_AUTO_MODE_FILE" 2>/dev/null || echo 0)"
[[ "$_xray_auto_mode" == 0 || "$_xray_auto_mode" == 1 ]] || { echo XRAY_AUTO_INVALID_STATE >&2; exit 2; }
if [[ "$_xray_auto_mode" == 1 ]]; then
  MIHOMO_XRAY_AUTO_FAILOVER_CANARY=1
  MIHOMO_XRAY_SELECTIVE_CANARY=1
elif [[ -z "${MIHOMO_XRAY_AUTO_FAILOVER_CANARY+x}" ]]; then
  MIHOMO_XRAY_AUTO_FAILOVER_CANARY=0
fi
export MIHOMO_XRAY_AUTO_FAILOVER_CANARY MIHOMO_XRAY_SELECTIVE_CANARY

MIHOMO_NODE_POLICY_MODE_FILE="${MIHOMO_NODE_POLICY_MODE_FILE:-/etc/awg-pbr/transports/mihomo/node-policy.mode}"
MIHOMO_NODE_POLICY_ORDER_FILE="${MIHOMO_NODE_POLICY_ORDER_FILE:-/etc/awg-pbr/transports/mihomo/node-policy.nodes}"
MIHOMO_NODE_NAME_FILE="${MIHOMO_NODE_NAME_FILE:-/etc/awg-pbr/transports/mihomo/node-name}"
MIHOMO_CONFIGURE="${MIHOMO_CONFIGURE_BIN:-/usr/local/sbin/awg-mihomo-configure}"
MIHOMO_POOL_CLI="${MIHOMO_POOL_CLI:-/usr/local/sbin/awg-mihomo-pool}"
MIHOMO_HOT_POOL_CLI="${MIHOMO_HOT_POOL_CLI:-/usr/local/sbin/awg-mihomo-hot-pool}"
# Persist Hot Pool READY-priority independently of the node's AUTO/FIXED mode.
# Existing installations remain OFF until explicitly enabled. A clean
# installation enables this after all guarded helpers have been provisioned.
MIHOMO_READY_AUTO_MODE_FILE="${MIHOMO_READY_AUTO_MODE_FILE:-/etc/awg-pbr/transports/mihomo/ready-auto.mode}"
if [[ -z "${MIHOMO_READY_AUTO_CANARY+x}" ]]; then
  MIHOMO_READY_AUTO_CANARY="$(cat "$MIHOMO_READY_AUTO_MODE_FILE" 2>/dev/null || echo 0)"
fi
[[ "$MIHOMO_READY_AUTO_CANARY" == 0 || "$MIHOMO_READY_AUTO_CANARY" == 1 ]] || {
  echo 'Invalid Hot Pool READY policy state' >&2
  exit 2
}
MIHOMO_READY_GUARD_BIN="${MIHOMO_READY_GUARD_BIN:-/usr/local/sbin/awg-mihomo-ready-live-match}"
MIHOMO_READY_POSTCHECK_BIN="${MIHOMO_READY_POSTCHECK_BIN:-/usr/local/sbin/awg-mihomo-ready-postcheck-tun}"
MIHOMO_READY_LIVE_PROVIDER="${MIHOMO_READY_LIVE_PROVIDER:-/var/lib/awg-pbr/mihomo/providers/subscription.yaml}"
MIHOMO_READY_UNION_PROVIDER="${MIHOMO_READY_UNION_PROVIDER:-/run/awg-pbr/hot-pool/continuity/provider.yaml}"
MIHOMO_READY_UNION_POOL="${MIHOMO_READY_UNION_POOL:-/run/awg-pbr/hot-pool/continuity/pool.json}"
MIHOMO_READY_UNION_STATE="${MIHOMO_READY_UNION_STATE:-/run/awg-pbr/hot-pool/continuity/state.json}"
# Used only after every service-qualified candidate has been rejected. Never
# re-enable a broken Mihomo dataplane merely to restore its previous name.
MIHOMO_AUTO_MODE_FILE="${MIHOMO_AUTO_MODE_FILE:-/etc/awg-pbr/mode}"
MIHOMO_AUTO_TRANSIT_ROUTING="${MIHOMO_AUTO_TRANSIT_ROUTING:-/usr/local/sbin/awg-transit-routing}"
MIHOMO_AUTO_FAILOPEN="${MIHOMO_AUTO_FAILOPEN:-/usr/local/sbin/awg-pbr-failopen}"
MIHOMO_AUTO_VPN_ENABLED_FILE="${MIHOMO_AUTO_VPN_ENABLED_FILE:-/etc/awg-pbr/vpn-enabled}"
MIHOMO_AUTO_SYSTEMCTL="${MIHOMO_AUTO_SYSTEMCTL:-systemctl}"
MIHOMO_AUTO_SERVICE="${MIHOMO_AUTO_SERVICE:-awg-mihomo.service}"
MIHOMO_STRATEGY_SYSTEMCTL="${MIHOMO_STRATEGY_SYSTEMCTL:-systemctl}"
MIHOMO_HOT_TIMER="${MIHOMO_HOT_TIMER:-awg-mihomo-hot-pool.timer}"
MIHOMO_HOT_SERVICE="${MIHOMO_HOT_SERVICE:-awg-mihomo-hot-pool.service}"

# Explicit one-shot standby repair MUST NOT alter a healthy AWG transport.
MIHOMO_AUTO_TRANSPORT_CLI="${MIHOMO_AUTO_TRANSPORT_CLI:-/usr/local/sbin/awg-transport}"
MIHOMO_STANDBY_CURL_BIN="${MIHOMO_STANDBY_CURL_BIN:-curl}"
MIHOMO_STANDBY_TUN_IF="${MIHOMO_STANDBY_TUN_IF:-mihomo0}"

# OFF preserves the pre-existing live policy until service gating is explicitly
# enabled, tested and approved. REQUIRE rejects stale/missing/UNKNOWN results.
MIHOMO_SERVICE_GATE_MODE_FILE="${MIHOMO_SERVICE_GATE_MODE_FILE:-/etc/awg-pbr/transports/mihomo/service-eligibility.mode}"
if [[ -z "${MIHOMO_SERVICE_GATE_MODE+x}" ]]; then
  MIHOMO_SERVICE_GATE_MODE="$(cat "$MIHOMO_SERVICE_GATE_MODE_FILE" 2>/dev/null || echo off)"
  # READY-priority never falls back to an UNQUALIFIED low-latency node.
  # If no READY is available, each fallback candidate must pass a fresh,
  # isolated OpenAI + ChatGPT + 24-frame YouTube medium-confidence scan.
  # Only the node selector uses this override: the live monitor's health
  # policy remains unchanged, preventing false failover on Cloudflare 403.
  if [[ "$MIHOMO_READY_AUTO_CANARY" == 1 && "$MIHOMO_SERVICE_GATE_MODE" == off ]]; then
    MIHOMO_SERVICE_GATE_MODE=balanced
  fi
fi
MIHOMO_SERVICE_GATE_BIN="${MIHOMO_SERVICE_GATE_BIN:-/usr/local/sbin/awg-mihomo-service-eligibility.py}"
MIHOMO_SERVICE_QUICKCHECK_BIN="${MIHOMO_SERVICE_QUICKCHECK_BIN:-/usr/local/sbin/awg-mihomo-smart}"
MIHOMO_NETWORK_GATE_BIN="${MIHOMO_NETWORK_GATE_BIN:-/usr/local/sbin/awg-mihomo-network-eligibility.py}"

usage(){
  cat <<'USAGE'
Usage:
  awg-mihomo-node-policy status
  awg-mihomo-node-policy mode manual
  awg-mihomo-node-policy mode fixed NODE [FALLBACK_NODE...]
  awg-mihomo-node-policy mode auto
  awg-mihomo-node-policy ready-auto enable|disable|status
  awg-mihomo-node-policy auto-strategy status|ready|classic
  awg-mihomo-node-policy xray-auto enable|disable|status
  awg-mihomo-node-policy standby-repair  # AWG must be healthy and active; no route change
  awg-mihomo-node-policy manual-selection preview NODE
  awg-mihomo-node-policy manual-selection apply NODE

FIXED uses exact node names from the current live provider. The first name is
the preferred/primary node; later names form an explicit one-way fallback chain.
Only nodes after the current node may be tried automatically; there is no wrap-back.
A healthy current allowed node is sticky. No automatic return for performance.

This policy never infers country from a node name and never adds an unlisted
node. Therefore a country change can happen automatically only if the user
explicitly placed a node from another country in the fallback list.

AUTO with ready-auto ENABLED prefers twice-confirmed, service-qualified
Hot Pool READY nodes (current live credentials must match). If no READY exists,
every health-pool alternative needs a NEW isolated service scan and post-switch
TUN validation before being used. On a confirmed active-node failure, a
rejected READY candidate is skipped in favor of another READY candidate;
the original broken node is never reactivated as the recovery result.
When no verified Mihomo candidate remains, the dataplane is quiesced and
Transit remains FAIL-CLOSED. Configured standby AWG may then be tried. A healthy
active Mihomo is NEVER changed for speed. Disable ready-auto explicitly to
retain legacy network-only fallback behavior.
USAGE
}

# A strategy changes only the READY priority and SHADOW timer. Existing
# manual/FIXED chains are never overwritten. Service gate remains independent.
strategy_enabled(){ "$MIHOMO_STRATEGY_SYSTEMCTL" is-enabled --quiet "$MIHOMO_HOT_TIMER"; }
strategy_active(){ "$MIHOMO_STRATEGY_SYSTEMCTL" is-active --quiet "$MIHOMO_HOT_TIMER"; }
strategy_status(){
  local priority policy timer=inactive enabled=disabled
  priority="$(cat "$MIHOMO_READY_AUTO_MODE_FILE" 2>/dev/null || echo 0)"
  strategy_active && timer=active
  strategy_enabled && enabled=enabled
  policy="$(mode_get 2>/dev/null || echo invalid)"
  local result=MIXED_CONFIGURATION
  case "$priority:$timer:$enabled" in
    1:active:enabled) result=HOT_POOL_READY ;;
    0:inactive:disabled) result=CLASSIC_AUTO ;;
  esac
  printf 'MIHOMO_AUTO_STRATEGY=%s\n' "$result"
  printf 'MIHOMO_NODE_POLICY=%s\n' "$policy"
  printf 'MIHOMO_HOT_TIMER_ACTIVE=%s\n' "$timer"
  printf 'MIHOMO_HOT_TIMER_ENABLED=%s\n' "$enabled"
  printf 'MIHOMO_READY_AUTO=%s\n' "$priority"
  printf 'MIHOMO_SERVICE_GATE=%s\n' "$MIHOMO_SERVICE_GATE_MODE"
}
strategy_restore(){
  local enabled="$1" active="$2" fail=0
  if [[ "$enabled" == yes ]]; then
    "$MIHOMO_STRATEGY_SYSTEMCTL" enable "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
  else
    "$MIHOMO_STRATEGY_SYSTEMCTL" disable "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
  fi
  if [[ "$active" == yes ]]; then
    "$MIHOMO_STRATEGY_SYSTEMCTL" start "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
  else
    "$MIHOMO_STRATEGY_SYSTEMCTL" stop "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
  fi
  (( fail == 0 ))
}
select_auto_strategy(){
  local target="$1" was_ready was_active=no was_enabled=no wanted=0 fail=0
  [[ "$target" == ready || "$target" == classic ]] || return 2
  if [[ "$(mode_get 2>/dev/null || echo invalid)" != auto ]]; then
    echo 'MIHOMO_AUTO_STRATEGY=REQUIRES_NODE_POLICY_AUTO' >&2
    return 2
  fi
  if "$MIHOMO_STRATEGY_SYSTEMCTL" is-active --quiet "$MIHOMO_HOT_SERVICE"; then
    echo 'MIHOMO_AUTO_STRATEGY=SCANNER_RUNNING_RETRY_LATER' >&2
    return 2
  fi
  was_ready="$(cat "$MIHOMO_READY_AUTO_MODE_FILE" 2>/dev/null || echo 0)"
  [[ "$was_ready" == 0 || "$was_ready" == 1 ]] || return 2
  strategy_active && was_active=yes
  strategy_enabled && was_enabled=yes
  [[ "$target" == ready ]] && wanted=1
  if [[ "$wanted" == 1 ]]; then
    local helper
    for helper in "$MIHOMO_HOT_POOL_CLI" "$MIHOMO_POOL_CLI"       "$MIHOMO_READY_GUARD_BIN" "$MIHOMO_READY_POSTCHECK_BIN"       "$MIHOMO_SERVICE_QUICKCHECK_BIN" "$MIHOMO_NETWORK_GATE_BIN"; do
      [[ -x "$helper" ]] || {
        echo 'MIHOMO_AUTO_STRATEGY=REJECTED_MISSING_GUARD' >&2
        return 2
      }
    done
    "$MIHOMO_STRATEGY_SYSTEMCTL" enable --now "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
    if (( fail == 0 )); then set_ready_auto enable >/dev/null || fail=1; fi
  else
    set_ready_auto disable >/dev/null || fail=1
    if (( fail == 0 )); then
      "$MIHOMO_STRATEGY_SYSTEMCTL" disable --now "$MIHOMO_HOT_TIMER" >/dev/null || fail=1
    fi
  fi
  # Timer may have raced into a new scan. Never silently claim a safe change.
  if "$MIHOMO_STRATEGY_SYSTEMCTL" is-active --quiet "$MIHOMO_HOT_SERVICE"; then fail=1; fi
  local actual="$(cat "$MIHOMO_READY_AUTO_MODE_FILE" 2>/dev/null || echo invalid)"
  local live_timer=0 enabled_timer=0
  strategy_active && live_timer=1
  strategy_enabled && enabled_timer=1
  if [[ "$actual" != "$wanted" || "$live_timer" != "$wanted" ||
        "$enabled_timer" != "$wanted" ]]; then fail=1; fi
  if (( fail )); then
    local rollback=0
    if [[ "$was_ready" == 1 ]]; then
      set_ready_auto enable >/dev/null || rollback=1
    else
      set_ready_auto disable >/dev/null || rollback=1
    fi
    strategy_restore "$was_enabled" "$was_active" || rollback=1
    if (( rollback )); then
      echo 'MIHOMO_AUTO_STRATEGY=ROLLBACK_FAILED_MANUAL_REVIEW' >&2
    else
      echo 'MIHOMO_AUTO_STRATEGY=FAILED_ROLLED_BACK' >&2
    fi
    return 1
  fi
  strategy_status
}

mode_get(){
  local mode
  mode="$(cat "$MIHOMO_NODE_POLICY_MODE_FILE" 2>/dev/null || echo manual)"
  case "$mode" in manual|fixed|auto) printf '%s\n' "$mode" ;; *) return 1 ;; esac
}

atomic_mode(){
  local value="$1" dir tmp
  dir="$(dirname "$MIHOMO_NODE_POLICY_MODE_FILE")"
  mkdir -p "$dir"; chmod 700 "$dir"
  tmp="$(mktemp "$dir/.node-policy-mode.XXXXXX")"
  printf '%s\n' "$value" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$MIHOMO_NODE_POLICY_MODE_FILE"
}

atomic_order(){
  local dir tmp node
  dir="$(dirname "$MIHOMO_NODE_POLICY_ORDER_FILE")"
  mkdir -p "$dir"; chmod 700 "$dir"
  tmp="$(mktemp "$dir/.node-policy-nodes.XXXXXX")"
  : >"$tmp"
  for node in "$@"; do
    printf '%s\n' "$node" >>"$tmp"
  done
  chmod 600 "$tmp"
  mv -f "$tmp" "$MIHOMO_NODE_POLICY_ORDER_FILE"
}

validate_node_name(){
  local node="$1"
  [[ -n "$node" && "$node" != *$'\n'* && "$node" != *$'\r'* && "$node" != *$'\t'* ]]
}

validate_nodes(){
  local node existing
  local -a seen_nodes=()
  (( $# > 0 )) || { echo "fixed mode requires at least one exact node name" >&2; return 2; }
  for node in "$@"; do
    validate_node_name "$node" || { echo "Invalid node name" >&2; return 2; }
    for existing in "${seen_nodes[@]}"; do
      [[ "$existing" != "$node" ]] || {
        echo "Duplicate node in failover order: $node" >&2
        return 2
      }
    done
    "$MIHOMO_CONFIGURE" node prepare "$node" >/dev/null || {
      echo "Node is not present/resolvable in the live provider: $node" >&2
      return 2
    }
    seen_nodes+=("$node")
  done
}

set_manual(){
  atomic_mode manual
  rm -f "$MIHOMO_NODE_POLICY_ORDER_FILE"
  printf 'MIHOMO_NODE_POLICY=manual\n'
}

set_fixed(){
  validate_nodes "$@" || return
  atomic_order "$@"
  atomic_mode fixed
  printf 'MIHOMO_NODE_POLICY=fixed\n'
  printf 'MIHOMO_NODE_ORDER='
  local first=1 node
  for node in "$@"; do
    (( first == 1 )) || printf ' -> '
    printf '%s' "$node"
    first=0
  done
  printf '\n'
}

set_auto(){
  [[ -x "$MIHOMO_POOL_CLI" ]] || {
    echo "Mihomo health-pool helper is unavailable: $MIHOMO_POOL_CLI" >&2
    return 2
  }
  rm -f "$MIHOMO_NODE_POLICY_ORDER_FILE"
  atomic_mode auto
  printf 'MIHOMO_NODE_POLICY=auto\n'
  "$MIHOMO_POOL_CLI" policy status 2>/dev/null || true
}

set_ready_auto(){
  local value="${1:-}"
  case "$value" in
    enable)
      for helper in "$MIHOMO_HOT_POOL_CLI" "$MIHOMO_POOL_CLI" \
                    "$MIHOMO_READY_GUARD_BIN" "$MIHOMO_READY_POSTCHECK_BIN" \
                    "$MIHOMO_SERVICE_QUICKCHECK_BIN" "$MIHOMO_NETWORK_GATE_BIN"; do
        [[ -x "$helper" ]] || {
          echo "READY_AUTO=REJECTED_MISSING_GUARD" >&2
          return 2
        }
      done
      value=1
      ;;
    disable) value=0 ;;
    *) echo 'Usage: awg-mihomo-node-policy ready-auto enable|disable|status' >&2; return 2 ;;
  esac
  local dir tmp
  dir="$(dirname "$MIHOMO_READY_AUTO_MODE_FILE")"
  mkdir -p "$dir"; chmod 700 "$dir"
  tmp="$(mktemp "$dir/.ready-auto.XXXXXXXX")"
  printf '%s\n' "$value" >"$tmp"
  chmod 600 "$tmp"
  mv -fT -- "$tmp" "$MIHOMO_READY_AUTO_MODE_FILE"
  if [[ "$value" == 1 ]]; then
    printf 'MIHOMO_READY_AUTO=enabled\n'
    printf 'CANDIDATE_ORDER=HOT_POOL_READY_FIRST_THEN_FRESH_SERVICE_CHECK\n'
  else
    printf 'MIHOMO_READY_AUTO=disabled\n'
  fi
}

manual_selection_order(){
  local selected="$1" mode first=1 node
  local -a old_nodes=() new_nodes=()

  validate_node_name "$selected" || {
    echo "Invalid node name" >&2
    return 2
  }

  mode="$(mode_get)" || return 1
  [[ "$mode" == fixed ]] || {
    printf 'FIXED_CHAIN_CHANGE=no\n'
    return 0
  }
  [[ -s "$MIHOMO_NODE_POLICY_ORDER_FILE" ]] || {
    echo "FIXED policy has no saved node order" >&2
    return 1
  }

  mapfile -t old_nodes <"$MIHOMO_NODE_POLICY_ORDER_FILE"
  new_nodes=("$selected")
  # Manual selection replaces only the old primary (position 1). Preserve the
  # existing tail exactly, except for a duplicate of the newly selected node.
  for (( i=1; i<${#old_nodes[@]}; i++ )); do
    node="${old_nodes[i]}"
    [[ -n "$node" && "$node" != "$selected" ]] || continue
    new_nodes+=("$node")
  done

  printf 'FIXED_CHAIN_CHANGE=yes\n'
  printf 'FIXED_CHAIN_NEW='
  for node in "${new_nodes[@]}"; do
    (( first == 1 )) || printf ' -> '
    printf '%s' "$node"
    first=0
  done
  printf '\n'
}

manual_selection_apply(){
  local selected="$1" current node
  local -a old_nodes=() new_nodes=()

  validate_node_name "$selected" || {
    echo "Invalid node name" >&2
    return 2
  }

  [[ "$(mode_get)" == fixed ]] || {
    printf 'FIXED_CHAIN_UPDATED=no\n'
    return 0
  }
  [[ -s "$MIHOMO_NODE_POLICY_ORDER_FILE" ]] || {
    echo "FIXED policy has no saved node order" >&2
    return 1
  }

  current="$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || true)"
  [[ "$current" == "$selected" ]] || {
    echo "Refusing FIXED head update: selected node is not the active Mihomo node" >&2
    return 1
  }

  mapfile -t old_nodes <"$MIHOMO_NODE_POLICY_ORDER_FILE"
  new_nodes=("$selected")
  for (( i=1; i<${#old_nodes[@]}; i++ )); do
    node="${old_nodes[i]}"
    [[ -n "$node" && "$node" != "$selected" ]] || continue
    new_nodes+=("$node")
  done

  atomic_order "${new_nodes[@]}"
  printf 'FIXED_CHAIN_UPDATED=yes\n'
  printf 'MIHOMO_NODE_ORDER='
  local first=1
  for node in "${new_nodes[@]}"; do
    (( first == 1 )) || printf ' -> '
    printf '%s' "$node"
    first=0
  done
  printf '\n'
}

status(){
  local mode current node n=0
  mode="$(mode_get)" || {
    echo "Invalid Mihomo node policy state" >&2
    return 1
  }
  current="$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || echo unknown)"
  printf 'Mihomo node policy: %s\n' "$mode"
  printf 'Current Mihomo node: %s\n' "$current"
  case "$mode" in
    fixed)
      printf 'Allowed exact-node order:\n'
      if [[ -r "$MIHOMO_NODE_POLICY_ORDER_FILE" ]]; then
        while IFS= read -r node || [[ -n "$node" ]]; do
          [[ -n "$node" ]] || continue
          n=$((n+1))
          printf '  %d. %s\n' "$n" "$node"
        done <"$MIHOMO_NODE_POLICY_ORDER_FILE"
      fi
      (( n > 0 )) || printf '  (invalid/empty)\n'
      printf 'Automatic trigger: repeated active-Mihomo health failure\n'
      printf 'Pool region filter: ignored by explicit FIXED chain\n'
      ;;
    auto)
      if [[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]]; then
        printf 'Automatic Mihomo node switching: Hot Pool READY-priority AUTO\n'
        printf 'Fallback candidates: fresh service scan mandatory\n'
      else
        printf 'Automatic Mihomo node switching: health-pool AUTO\n'
      fi
      printf 'Automatic trigger: repeated active-Mihomo health failure\n'
      if [[ -x "$MIHOMO_POOL_CLI" ]]; then
        "$MIHOMO_POOL_CLI" policy status 2>/dev/null || true
        "$MIHOMO_POOL_CLI" status live 2>/dev/null || true
      fi
      ;;
    *)
      printf 'Automatic Mihomo node switching: disabled\n'
      ;;
  esac
  printf 'Hot Pool READY priority: %s\n' "$([[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]] && echo enabled || echo disabled)"
  printf 'Service eligibility gate: %s\n' "$MIHOMO_SERVICE_GATE_MODE"
  printf 'Country inference from node names: disabled\n'
}

is_fixed(){
  [[ "$(mode_get 2>/dev/null || echo invalid)" == fixed ]] &&
    [[ -s "$MIHOMO_NODE_POLICY_ORDER_FILE" ]]
}

is_enabled(){
  local mode
  mode="$(mode_get 2>/dev/null || echo invalid)"
  case "$mode" in
    fixed) [[ -s "$MIHOMO_NODE_POLICY_ORDER_FILE" ]] ;;
    auto) [[ -x "$MIHOMO_POOL_CLI" ]] ;;
    *) return 1 ;;
  esac
}

service_candidate_allowed(){
  local candidate="$1" response
  case "$MIHOMO_SERVICE_GATE_MODE" in
    off) return 0 ;;
    balanced)
      # Medium NETWORK confidence, explicitly not authenticated chat.
      # HTTPS challenge or login page is sufficient only alongside API PASS
      # and a NEW actual 24-frame Stage18 video decode for this exact node.
      [[ -x "$MIHOMO_SERVICE_QUICKCHECK_BIN" && -x "$MIHOMO_NETWORK_GATE_BIN" ]] || return 1
      response="$("$MIHOMO_SERVICE_QUICKCHECK_BIN" service-scan --node "$candidate" 2>/dev/null)" || true
      # service-scan also emits safe diagnostic metadata such as
      # SERVICE_IP_CONNECT_STATE / SERVICE_REASON_YOUTUBE_VIDEO. The strict
      # network gate accepts EXACTLY five service-evidence fields and rejects
      # unknown fields. Feed ONLY those five, preserving their original
      # values and duplicate lines so the gate still rejects malformed input.
      # Hot Pool scan_one() already follows this same verified contract.
      local gate_output gate_reason
      if gate_output="$(printf '%s\n' "$response" | awk -F= '
        $1 == "SERVICE_ELIGIBILITY" ||
        $1 == "SERVICE_CHECK_OPENAI_API" ||
        $1 == "SERVICE_CHECK_CHATGPT_WEB" ||
        $1 == "SERVICE_CHECK_YOUTUBE_VIDEO" ||
        $1 == "SERVICE_REASON_CHATGPT_WEB" { print }
      ' | "$MIHOMO_NETWORK_GATE_BIN" 2>/dev/null)"; then
        return 0
      fi
      gate_reason="$(sed -nE 's/^NETWORK_REASON=([A-Z0-9_]{1,64})$/\1/p' <<<"$gate_output" | head -1)"
      [[ -n "$gate_reason" ]] || gate_reason=UNKNOWN
      printf 'READY_AUTO=CANDIDATE_SERVICE_REJECTED REASON=%s\n' "$gate_reason" >&2
      return 1
      ;;
    require)
      [[ -x "$MIHOMO_SERVICE_GATE_BIN" ]] || return 1
      if response="$("$MIHOMO_SERVICE_GATE_BIN" --node "$candidate" 2>/dev/null)" &&
         grep -Fxq 'SERVICE_ELIGIBILITY=PASS' <<<"$response"; then
        return 0
      fi
      # A stale cache is not a denial of the node itself: recheck only this
      # candidate through a separate, RAM-only TUN-disabled Mihomo instance.
      [[ -x "$MIHOMO_SERVICE_QUICKCHECK_BIN" ]] || return 1
      response="$("$MIHOMO_SERVICE_QUICKCHECK_BIN" service-scan --node "$candidate" 2>/dev/null)" || return 1
      grep -Fxq 'SERVICE_ELIGIBILITY=PASS' <<<"$response"
      ;;
    *) return 1 ;;
  esac
}

failover_fixed(){
  local current="$1" node found_current=0 attempts=0 failed_mihomo_candidates=0
  while IFS= read -r node || [[ -n "$node" ]]; do
    [[ -n "$node" ]] || continue
    if (( found_current == 0 )); then
      if [[ "$node" == "$current" ]]; then
        found_current=1
      fi
      continue
    fi
    if [[ "$MIHOMO_SERVICE_GATE_MODE" == require || "$MIHOMO_SERVICE_GATE_MODE" == balanced ]]; then
      (( attempts < 3 )) || break
      attempts=$((attempts+1))
    fi
    # An unproven ChatGPT/YouTube candidate must never be selected when
    # service gating is required. Continue to the next explicit FIXED node.
    service_candidate_allowed "$node" || continue
    # Engine-aware FIXED. Xray is an opt-in, TEST-PI-ONLY transaction.
    # The old Mihomo-only selector must never receive a Reality VLESS name.
    if [[ -e "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]]; then
      [[ -x "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]] || { echo "MIHOMO_NODE_FAILOVER=ENGINE_RESOLVER_UNAVAILABLE" >&2; return 1; }
      local resolved engine
      resolved="$("${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" resolve "$node" 2>/dev/null)" || continue
      engine="$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolved")"
      if [[ "$engine" == XRAY ]]; then
        if [[ "${MIHOMO_XRAY_FIXED_FAILOVER_CANARY:-0}" != 1 ]]; then
          echo "MIHOMO_NODE_FAILOVER=XRAY_TRANSACTION_NOT_CERTIFIED" >&2
          continue
        fi
        if [[ "$(hostname)" != awg-upgrade || "$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null)" != transit ||
              "$(sed -n 's/^NODE_BASIC_NETWORK=//p' <<<"$resolved")" != NETWORK_OK ]]; then
          echo "MIHOMO_NODE_FAILOVER=XRAY_EXPERIMENTAL_PREFLIGHT_REJECTED" >&2
          continue
        fi
        if [[ ! -x "${MIHOMO_XRAY_TRANSACTION_CLI:-/usr/local/sbin/awg-xray-live-backend}" ]]; then
          echo "MIHOMO_NODE_FAILOVER=XRAY_TRANSACTION_EXECUTOR_MISSING" >&2
          return 1
        fi
        # Only the independent guarded transaction can make a cross-core
        # decision. It rechecks failed-TUN HTTPS twice under maintenance lock,
        # validates exact provider/credentials, arms 300s watchdog BEFORE
        # mutation, and fails Transit CLOSED if its candidate cannot commit.
        if AWG_XRAY_EXPERIMENTAL_APPLY=TEST_PI_AUTHORIZED \
             AWG_XRAY_DEGRADED_FIXED="$failed_mihomo_candidates" \
             "${MIHOMO_XRAY_TRANSACTION_CLI:-/usr/local/sbin/awg-xray-live-backend}" apply "$current" "$node" >/dev/null; then
          printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$node"
          return 0
        fi
        # Transaction might already have quiesced Mihomo. Never try the
        # Mihomo-only selector or start the known-failed predecessor again.
        echo "MIHOMO_NODE_FAILOVER=XRAY_TRANSACTION_ABORTED_REVIEW_REQUIRED" >&2
        return 1
      fi
      [[ "$engine" == MIHOMO ]] || { echo "MIHOMO_NODE_FAILOVER=ENGINE_UNSUPPORTED" >&2; continue; }
    fi
    if xray_bridge_present; then
      # Only installer-owned native recovery can bypass a dead Xray bridge.
      local dead_native_rc=0
      "${MIHOMO_XRAY_NATIVE_RECOVERY_CLI:-/usr/local/sbin/awg-xray-manual-switch}" dead-xray-native "$node" >/dev/null || dead_native_rc=$?
      if (( dead_native_rc == 0 )); then
        printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$node"
        return 0
      fi
      # RC2=no mutation, continue FIXED chain; RC1=aborted, require AWG.
      (( dead_native_rc == 2 )) && continue
      echo 'MIHOMO_NODE_FAILOVER=FIXED_DEAD_XRAY_ABORT_AWG_FALLBACK' >&2
      return 1
    fi
    if MIHOMO_NODE_FAILOVER_RECOVERY=1 "$MIHOMO_CONFIGURE" node select-auto "$node" >/dev/null; then
      # The configure transaction validated the new Pi-bound TUN, but left
      # Transit disabled to keep forwarded clients FAIL-CLOSED during switch.
      # Reapply the policy rule only after a verified successful new node.
      if [[ "$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null)" == transit ]]; then
        if ! "$MIHOMO_AUTO_TRANSIT_ROUTING" apply >/dev/null; then
          echo "MIHOMO_NODE_FAILOVER=TRANSIT_REAPPLY_FAILED_FAIL_CLOSED" >&2
          return 1
        fi
        local transit_status
        transit_status="$("$MIHOMO_AUTO_TRANSIT_ROUTING" status 2>/dev/null)" || return 1
        if ! grep -Fxq "Transit guard: SAFE" <<<"$transit_status" ||
           ! grep -Fxq "Transit policy rule: ACTIVE" <<<"$transit_status" ||
           ! grep -Fxq "Transit VPN table: READY" <<<"$transit_status"; then
          echo "MIHOMO_NODE_FAILOVER=TRANSIT_UNVERIFIED_FAIL_CLOSED" >&2
          return 1
        fi
      fi
      printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$node"
      return 0
    fi
    # The configure rollback kept the original metadata, but MUST NOT
    # restart the already-failed incumbent. Next Xray sees a deliberately
    # stopped Mihomo and disabled Transit policy rule, not normal traffic.
    failed_mihomo_candidates=1
  done <"$MIHOMO_NODE_POLICY_ORDER_FILE"
  (( found_current == 1 )) || return 1
  return 1
}

# In conservative AUTO, AWG can be the healthy active transport while Mihomo
# standby's formerly selected endpoint has gone offline. Requalify at most the
# existing READY/fresh fallback bound WITHOUT changing active transport/rules.
standby_routes_safe(){
  local tbl route
  [[ "$("$MIHOMO_AUTO_TRANSPORT_CLI" get 2>/dev/null)" == awg ]] || return 1
  for tbl in 100 101; do
    route="$(ip -4 route show table "$tbl" 2>/dev/null)" || return 1
    awk '$1 == "default" && $2 == "dev" && $3 == "awg0" {ok=1} END {exit !ok}' <<<"$route" || return 1
  done
  "$MIHOMO_AUTO_TRANSPORT_CLI" check awg >/dev/null 2>&1
}
standby_postcheck(){
  local node="$1" code addr
  [[ "$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || true)" == "$node" ]] || {
    echo 'READY_TUN_CHECK=NODE_CHANGED'
    return 1
  }
  standby_routes_safe || { echo 'READY_TUN_CHECK=ROUTE_MISSING'; return 1; }
  ip link show dev "$MIHOMO_STANDBY_TUN_IF" >/dev/null 2>&1 || {
    echo 'READY_TUN_CHECK=IF_DOWN'; return 1
  }
  # No HTTP_PROXY inheritance and no global routing change. This validates
  # the actual Pi-bound TUN, independently of the localhost proxy preflight.
  code="$("$MIHOMO_STANDBY_CURL_BIN" -q -4 -sS --noproxy '*' \
    --interface "$MIHOMO_STANDBY_TUN_IF" --connect-timeout 5 --max-time 12 \
    -o /dev/null -w '%{http_code}' https://api.openai.com/v1/models 2>/dev/null)" || {
      echo 'READY_TUN_CHECK=OPENAI_NETWORK_FAILED'; return 1
    }
  [[ "$code" == 401 ]] || { echo 'READY_TUN_CHECK=OPENAI_NOT_QUALIFIED'; return 1; }
  addr="$("$MIHOMO_STANDBY_CURL_BIN" -q -4 -fsS --noproxy '*' \
    --interface "$MIHOMO_STANDBY_TUN_IF" --connect-timeout 5 --max-time 12 \
    https://api.ipify.org 2>/dev/null)" || {
      echo 'READY_TUN_CHECK=EGRESS_FAILED'; return 1
    }
  python3 -c 'import ipaddress,sys
try:
 a=ipaddress.IPv4Address(sys.stdin.read().strip())
 sys.exit(0 if a.is_global else 1)
except ValueError:
 sys.exit(1)' <<<"$addr" || { echo 'READY_TUN_CHECK=EGRESS_INVALID'; return 1; }
  standby_routes_safe || { echo 'READY_TUN_CHECK=MARK_MISMATCH'; return 1; }
  echo READY_TUN_CHECK=PASS
}
standby_repair(){
  local previous
  standby_routes_safe || {
    echo 'STANDBY_REPAIR=REFUSED_AWG_NOT_HEALTHY_OR_ROUTE_NOT_SAFE' >&2
    return 1
  }
  [[ "$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)" == transit ||
     "$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)" == selective ]] || {
    echo 'STANDBY_REPAIR=INVALID_MODE' >&2; return 1
  }
  [[ "$(mode_get 2>/dev/null)" == auto ]] || {
    echo 'STANDBY_REPAIR=REQUIRES_NODE_AUTO_POLICY' >&2; return 1
  }
  previous="$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || true)"
  [[ -n "$previous" ]] || { echo 'STANDBY_REPAIR=NO_SELECTED_NODE' >&2; return 1; }
  # No background task and no performance-based switching: explicit one-shot.
  if MIHOMO_STANDBY_REPAIR=1 failover_auto "$previous"; then
    standby_routes_safe || {
      echo 'STANDBY_REPAIR=AWG_ROUTE_CHANGED' >&2; return 1
    }
    echo 'STANDBY_REPAIR=PASS_AWG_STILL_ACTIVE'
    return 0
  fi
  standby_routes_safe || {
    echo 'STANDBY_REPAIR=AWG_ROUTE_CHANGED' >&2; return 1
  }
  echo 'STANDBY_REPAIR=NO_VERIFIED_NODE_AWG_UNCHANGED' >&2
  return 1
}

# On an exhausted recovery path, stop the unverified backend instead of
# returning to the originally failed node. Do not touch router, DNS or SSH.
# In Transit, remove the policy rule under the existing nftables drop guard
# BEFORE stopping the interface. Never claim a successful node failover here.
quiesce_failed_mihomo(){
  local mode
  mode="$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)"
  case "$mode" in
    transit)
      "$MIHOMO_AUTO_TRANSIT_ROUTING" disable >/dev/null || return 1
      ;;
    selective)
      "$MIHOMO_AUTO_FAILOPEN" >/dev/null || return 1
      ;;
    *)
      echo 'READY_AUTO=INVALID_OPERATING_MODE' >&2
      return 1
      ;;
  esac
  "$MIHOMO_AUTO_SYSTEMCTL" stop "$MIHOMO_AUTO_SERVICE" >/dev/null || return 1
  echo 'READY_AUTO=NO_WORKING_MIHOMO_NODE' >&2
}

# Experimental cross-core AUTO, deliberately OFF by default. Unlike the
# existing FIXED canary, this operates only on one exact, freshly qualified
# Xray candidate picked by the current health pool. The live executor owns
# the double-dead-TUN proof, provider credential check, independent watchdog,
# guarded TUN activation, and fail-closed abort. This dispatcher never retries
# the known failed node or routes VLESS through the legacy Mihomo selector.
auto_xray_candidate(){
  local current="$1" candidate="$2" resolved="$3" executor
  if [[ "${MIHOMO_XRAY_AUTO_FAILOVER_CANARY:-0}" != 1 ]]; then
    echo "MIHOMO_NODE_FAILOVER=XRAY_TRANSACTION_NOT_CERTIFIED" >&2
    return 2
  fi
  # Cache status is historical evidence, never a veto or proof of this
  # exact current provider profile. ALWAYS fresh-probe the selected Xray
  # index in an isolated sidecar before arming any live transaction. This
  # also applies to callers of the older bounded AUTO dispatcher.
  local engine index probe
  engine="$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolved")"
  index="$(sed -n 's/^NODE_INDEX=//p' <<<"$resolved")"
  probe="${MIHOMO_XRAY_NATIVE_RECOVERY_CLI:-/usr/local/sbin/awg-xray-manual-switch}"
  if [[ "$engine" != XRAY || ! "$index" =~ ^[1-9][0-9]{0,4}$ ||
        ! -x "$probe" ]] ||
     ! "$probe" probe-xray "$index" >/dev/null 2>&1; then
    echo "MIHOMO_NODE_FAILOVER=XRAY_EXACT_FRESH_HTTPS_UNVERIFIED" >&2
    return 2
  fi
  # A standby repair while AWG is active MUST NOT mutate its routes.
  # READY has a distinct evidence contract and is not covered by this canary.
  local operating_mode
  operating_mode="$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)"
  if [[ "${MIHOMO_STANDBY_REPAIR:-0}" == 1 ||
        "$MIHOMO_READY_AUTO_CANARY" != 0 ||
        ( "$_xray_auto_mode" != 1 && "$(hostname)" != awg-upgrade ) ||
        ( "$operating_mode" != transit && "$operating_mode" != selective ) ||
        ( "$operating_mode" == selective && "${MIHOMO_XRAY_SELECTIVE_CANARY:-0}" != 1 ) ]]; then
    echo "MIHOMO_NODE_FAILOVER=XRAY_AUTO_PREFLIGHT_REJECTED" >&2
    return 2
  fi
  executor="${MIHOMO_XRAY_TRANSACTION_CLI:-/usr/local/sbin/awg-xray-live-backend}"
  if [[ ! -x "$executor" ]]; then
    echo "MIHOMO_NODE_FAILOVER=XRAY_TRANSACTION_EXECUTOR_MISSING" >&2
    return 2
  fi
  if [[ "$operating_mode" == selective ]] &&
     ! "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet "$MIHOMO_AUTO_SERVICE"; then
    # In Selective a stopped incumbent can still leave fwmark 0x100 bound to
    # its dead TUN. The Xray executor CORRECTLY refuses this unsafe baseline.
    # Make the existing Selective FAIL-OPEN transition first; no AWG, DNS or
    # SSH mutation. Only the explicit test Pi canary reaches this point.
    if [[ "$("$MIHOMO_AUTO_TRANSPORT_CLI" get 2>/dev/null || true)" != mihomo ||
          "$("$MIHOMO_AUTO_TRANSPORT_CLI" check awg 2>/dev/null || true)" != healthy ]] ||
       ! "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet ssh.service ||
       ! "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet dnsmasq.service ||
       ! "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet awg-quick@awg0.service ||
       [[ "$(cat "$MIHOMO_AUTO_VPN_ENABLED_FILE" 2>/dev/null)" != 1 ]]; then
      echo 'MIHOMO_NODE_FAILOVER=XRAY_SELECTIVE_BASELINE_UNSAFE_AWG_FALLBACK' >&2
      return 1
    fi
    if ip -4 rule show | grep -Eq 'fwmark[[:space:]]+(0x100|256)[[:space:]]+lookup[[:space:]]+100'; then
      if ! "$MIHOMO_AUTO_FAILOPEN" >/dev/null; then
        echo 'MIHOMO_NODE_FAILOVER=XRAY_SELECTIVE_FAILOPEN_FAILED_AWG_FALLBACK' >&2
        return 1
      fi
    fi
    if ip -4 rule show | grep -Eq 'fwmark[[:space:]]+(0x100|256)[[:space:]]+lookup[[:space:]]+100'; then
      echo 'MIHOMO_NODE_FAILOVER=XRAY_SELECTIVE_STALE_POLICY_RULE_AWG_FALLBACK' >&2
      return 1
    fi
    # Print only a fixed, non-secret diagnostic. Do not log provider/node names.
    logger -t awg-xray-auto 'SELECTIVE_FAILOPEN=PREPARED_BEFORE_XRAY'
  fi
  if AWG_XRAY_EXPERIMENTAL_APPLY=TEST_PI_AUTHORIZED "$executor" apply "$current" "$candidate" >/dev/null; then
    printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
    return 0
  fi
  # An aborted transaction may have quiesced the old, known-dead transport.
  # Stop node recovery here; allow the normal selection monitor to try AWG.
  echo "MIHOMO_NODE_FAILOVER=XRAY_AUTO_TRANSACTION_ABORTED_AWG_FALLBACK" >&2
  return 1
}


# A dead Xray SOCKS bridge must not prevent known-good native Mihomo nodes.
# No unsafe legacy node selector may run while the Xray bridge is installed.
xray_bridge_present(){
  systemctl is-active --quiet awg-xray-vless.service ||
    [[ -e /etc/systemd/system/awg-mihomo.service.d/61-awg-xray-bridge.conf ||
       -e /run/systemd/system/awg-mihomo.service.d/61-awg-xray-bridge.conf ||
       -e /etc/systemd/system/awg-mihomo.service.d/62-awg-xray-manual.conf ||
       -e /var/lib/awg-pbr/xray-vless/selected.json ]]
}

failover_dead_xray_native(){
  local current="$1" candidate resolved engine rc attempt=0 item
  local -a excludes=("$current") best_args=()
  local executor="${MIHOMO_XRAY_NATIVE_RECOVERY_CLI:-/usr/local/sbin/awg-xray-manual-switch}"
  [[ -x "$executor" && -x "$MIHOMO_POOL_CLI" &&
     -x "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]] || {
    echo 'MIHOMO_NODE_FAILOVER=DEAD_XRAY_RECOVERY_COMPONENT_MISSING' >&2
    return 1
  }
  # Three distinct native profiles, strictly by current AUTO pool ranking.
  "$MIHOMO_POOL_CLI" ensure live --geo-if-policy >/dev/null 2>&1 || return 1
  while (( attempt < 3 )); do
    best_args=(best live)
    for item in "${excludes[@]}"; do best_args+=(--exclude "$item"); done
    candidate="$("$MIHOMO_POOL_CLI" "${best_args[@]}" 2>/dev/null)" || candidate=""
    [[ -n "$candidate" ]] || break
    validate_node_name "$candidate" || return 1
    for item in "${excludes[@]}"; do
      if [[ "$candidate" == "$item" ]]; then
        echo 'MIHOMO_NODE_FAILOVER=DEAD_XRAY_REPEATED_CANDIDATE' >&2
        return 1
      fi
    done
    attempt=$((attempt + 1))
    excludes+=("$candidate")
    resolved="$("${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" resolve "$candidate" 2>/dev/null)" || continue
    engine="$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolved")"
    [[ "$engine" == MIHOMO ]] || continue
    # RC=2: no mutation; RC=1: native activation failed, AWG takes over.
    if "$executor" dead-xray-native "$candidate" >/dev/null; then
      printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
      return 0
    else
      rc=$?
      if (( rc != 2 )); then
        echo 'MIHOMO_NODE_FAILOVER=DEAD_XRAY_NATIVE_ABORT_AWG_FALLBACK' >&2
        return 1
      fi
    fi
  done
  echo 'MIHOMO_NODE_FAILOVER=DEAD_XRAY_NO_VERIFIED_NATIVE_AWG_FALLBACK' >&2
  return 1
}


# One current-provider pass, NOT a fixed number of Mihomo or Xray candidates.
# Each candidate is freshly probed and a live Mihomo TUN postcheck is required
# before any recovery is reported. Tracing emits only stable failure codes.
# If the guarded transaction cannot prove cleanup, abort immediately to AWG.
unified_recovery_candidates(){
  local helper="${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}"
  [[ -x "$helper" ]] || {
    echo 'MIHOMO_NODE_FAILOVER=UNIFIED_INVENTORY_UNAVAILABLE' >&2
    return 1
  }
  "$helper" candidates | python3 -c '
import json,sys
for line in sys.stdin:
    if not line.startswith("CANDIDATE="):continue
    try:
        c=json.loads(line.partition("=")[2])
        name=c["name"];engine=c["engine"];sha=c["provider_sha256"]
        index=c["index"]
        if (not isinstance(name,str) or not 1<=len(name)<=240 or
            any(ch in name for ch in "\t\n\r\0") or
            engine not in ("MIHOMO","XRAY") or
            not isinstance(index,int) or not 1<=index<=10000 or
            not isinstance(sha,str) or len(sha)!=64):continue
        print(engine+"\t"+str(index)+"\t"+sha+"\t"+name)
    except (KeyError,ValueError,TypeError):
        continue
'
}

unified_native_tun_postcheck(){
  local code route current mode
  current="$("$MIHOMO_AUTO_TRANSPORT_CLI" get 2>/dev/null || true)"
  [[ "$current" == mihomo ]] || return 1
  [[ "$("$MIHOMO_AUTO_SYSTEMCTL" is-active "$MIHOMO_AUTO_SERVICE" 2>/dev/null || true)" == active ]] || return 1
  route="$(ip -4 route show table 100)"
  [[ "$route" =~ ^default[[:space:]]+dev[[:space:]]+mihomo0([[:space:]].*)?$ ]] || return 1
  route="$(ip -4 route show table 101)"
  [[ "$route" =~ ^default[[:space:]]+dev[[:space:]]+mihomo0([[:space:]].*)?$ ]] || return 1
  code="$(curl -q -4 -sS --noproxy '*' --interface mihomo0 --connect-timeout 5 --max-time 12 \
     -o /dev/null -w '%{http_code}' https://api.openai.com/v1/models 2>/dev/null)" || return 1
  [[ "$code" == 401 ]] || return 1
  mode="$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)"
  if [[ "$mode" == transit ]]; then
    "$MIHOMO_AUTO_TRANSIT_ROUTING" apply >/dev/null || return 1
    local report
    report="$("$MIHOMO_AUTO_TRANSIT_ROUTING" status 2>/dev/null)" || return 1
    grep -Fxq 'Transit guard: SAFE' <<<"$report" || return 1
    grep -Fxq 'Transit policy rule: ACTIVE' <<<"$report" || return 1
    grep -Fxq 'Transit VPN table: READY' <<<"$report" || return 1
  elif [[ "$mode" == selective ]]; then
    # The existing PBR health service alone may re-arm selective rules.
    "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet awg-pbr-health.service || return 1
  else
    return 1
  fi
  "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet ssh.service &&
    "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet dnsmasq.service
}

unified_native_quiesce(){
  local mode
  [[ "$("$MIHOMO_AUTO_TRANSPORT_CLI" get 2>/dev/null || true)" == mihomo ]] || return 1
  mode="$(cat "$MIHOMO_AUTO_MODE_FILE" 2>/dev/null || true)"
  case "$mode" in
    transit) "$MIHOMO_AUTO_TRANSIT_ROUTING" disable >/dev/null || return 1 ;;
    selective) "$MIHOMO_AUTO_FAILOPEN" >/dev/null || return 1 ;;
    *) return 1 ;;
  esac
  "$MIHOMO_AUTO_SYSTEMCTL" stop "$MIHOMO_AUTO_SERVICE" >/dev/null || return 1
  ! "$MIHOMO_AUTO_SYSTEMCTL" is-active --quiet "$MIHOMO_AUTO_SERVICE"
}

failover_unified(){
  local current="$1" mode engine idx provider_sha candidate resolved resolved_sha
  local active_bridge=0 rc=0 attempts=0 start_epoch now line item selected=0
  local xray_guard_rejected=0
  local native_cli="${MIHOMO_XRAY_NATIVE_RECOVERY_CLI:-/usr/local/sbin/awg-xray-manual-switch}"
  local -a rows=() prioritized=() normalized=() order=()
  # The caller is the node-policy monitor, not manual node selection.
  mode="$(mode_get 2>/dev/null || echo invalid)"
  [[ "$mode" == auto ]] || return 1
  xray_bridge_present && active_bridge=1
  mapfile -t rows < <(unified_recovery_candidates)
  [[ "${#rows[@]}" -gt 0 ]] || {
    echo 'MIHOMO_NODE_FAILOVER=UNIFIED_EMPTY_OR_STALE_AWG_FALLBACK' >&2
    return 1
  }
  # AUTO visits every current-provider candidate without FIXED ordering.
  for line in "${rows[@]}"; do
    candidate="${line#*$'\t'}"
    candidate="${candidate#*$'\t'}"
    candidate="${candidate#*$'\t'}"
    [[ "$candidate" == "$current" ]] && continue
    prioritized+=("$line")
  done

  start_epoch="$(date +%s)"
  for line in "${prioritized[@]}"; do
    now="$(date +%s)"
    # With huge provider lists, safety wins over indefinite outage. Time
    # expiry is explicitly INFRASTRUCTURE_TIMEOUT, NOT "all nodes dead".
    if (( now-start_epoch > 600 )); then
      echo 'MIHOMO_NODE_FAILOVER=UNIFIED_DEADLINE_AWG_FALLBACK' >&2
      return 1
    fi
    IFS=$'\t' read -r engine idx provider_sha candidate <<<"$line"
    validate_node_name "$candidate" || continue
    resolved="$("${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" resolve "$candidate" 2>/dev/null)" || continue
    resolved_sha="$(sed -n 's/^NODE_PROVIDER_SHA256=//p' <<<"$resolved")"
    [[ "$resolved_sha" == "$provider_sha" ]] || {
      echo 'MIHOMO_NODE_FAILOVER=SUBSCRIPTION_CHANGED_DURING_RECOVERY' >&2
      return 1
    }
    [[ "$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolved")" == "$engine" ]] || continue
    attempts=$((attempts+1))
    if (( active_bridge == 1 )); then
      [[ -x "$native_cli" ]] || return 1
      rc=0
      if [[ "$engine" == MIHOMO ]]; then
        "$native_cli" dead-xray-native "$candidate" >/dev/null || rc=$?
      elif [[ "$engine" == XRAY ]]; then
        "$native_cli" dead-xray-xray "$idx" >/dev/null || rc=$?
      else
        continue
      fi
      if (( rc == 0 )); then
        printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
        printf 'MIHOMO_UNIFIED_RECOVERY_ATTEMPTS=%s ENGINE=%s\n' "$attempts" "$engine" >&2
        return 0
      fi
      (( rc == 2 )) && continue
      echo 'MIHOMO_NODE_FAILOVER=UNIFIED_TRANSACTION_ABORT_AWG_FALLBACK' >&2
      return 1
    fi

    if [[ "$engine" == MIHOMO ]]; then
      # Every candidate needs a fresh HTTPS proof. Historical pool "OK" and
      # UI status alone never qualify a current provider profile for a switch.
      "$native_cli" probe-native "$candidate" >/dev/null 2>&1 || continue
      service_candidate_allowed "$candidate" || continue
      rc=0
      MIHOMO_NODE_FAILOVER_RECOVERY=1 "$MIHOMO_CONFIGURE" node select-auto "$candidate" >/dev/null || rc=$?
      if (( rc == 0 )) && unified_native_tun_postcheck; then
        printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
        printf 'MIHOMO_UNIFIED_RECOVERY_ATTEMPTS=%s ENGINE=%s\n' "$attempts" "$engine" >&2
        return 0
      fi
      # A failed activation/TUN postcheck is not proof that the remaining
      # provider nodes are dead. A quiesced Mihomo service cannot safely
      # run another native transaction; stop this recovery event explicitly.
      # The monitor may use AWG only as a guarded transport fallback.
      echo 'MIHOMO_NODE_FAILOVER=UNIFIED_NATIVE_ACTIVATION_UNVERIFIED' >&2
      unified_native_quiesce || {
        echo 'MIHOMO_NODE_FAILOVER=UNIFIED_NATIVE_CLEANUP_FAILED' >&2
        return 1
      }
      return 1
    elif [[ "$engine" == XRAY ]]; then
      # The certified Xray dispatcher performs a fresh isolated HTTPS test
      # for the exact index even when cached health is expired/UNKNOWN/FAIL.
      # The certified executor handles the cross-core watchdog and guard.
      # This is not the legacy native selector for Reality VLESS profiles.
      if auto_xray_candidate "$current" "$candidate" "$resolved"; then
        printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
        printf 'MIHOMO_UNIFIED_RECOVERY_ATTEMPTS=%s ENGINE=%s\n' "$attempts" "$engine" >&2
        return 0
      else
        rc=$?
        # rc=2 means candidate untouched; rc=1 means guarded abort to AWG.
        if (( rc == 2 )); then
          # The Xray auto executor can reject a candidate because its
          # independent safety canary is disabled, not because that node
          # was proved dead. Keep trying other engines, but never report
          # "all nodes failed" after such an unattempted Xray profile.
          xray_guard_rejected=1
          continue
        fi
        echo 'MIHOMO_NODE_FAILOVER=UNIFIED_XRAY_ABORT_AWG_FALLBACK' >&2
        return 1
      fi
    fi
  done
  # Confirm the previous broken dataplane no longer forwards. AWG is
  # attempted by selection-monitor afterwards, never from this loop.
  if (( active_bridge == 1 )); then
    "$native_cli" dead-xray-exhausted >/dev/null 2>&1 || {
      echo 'MIHOMO_NODE_FAILOVER=UNIFIED_XRAY_QUIESCE_UNCONFIRMED_AWG_FALLBACK' >&2
      return 1
    }
  else
    unified_native_quiesce || {
      echo 'MIHOMO_NODE_FAILOVER=UNIFIED_NATIVE_QUIESCE_UNCONFIRMED_AWG_FALLBACK' >&2
      return 1
    }
  fi
  if (( xray_guard_rejected == 1 )); then
    echo 'MIHOMO_NODE_FAILOVER=UNIFIED_XRAY_GUARD_UNAVAILABLE_AWG_FALLBACK' >&2
  else
    echo 'MIHOMO_NODE_FAILOVER=UNIFIED_EXHAUSTED_NO_VERIFIED_CANDIDATE_AWG_FALLBACK' >&2
  fi
  return 1
}

failover_auto(){
  local current="$1" candidate item attempts=0 from_ready=0 candidate_visits=0 resolved engine xray_rc
  local xray_visits=0 max_xray_visits=2 max_candidate_visits=3
  # A dead Xray bridge cannot be handled by the normal native selector.
  # Try qualified native recovery first; then let the transport monitor use AWG.
  if xray_bridge_present; then
    failover_dead_xray_native "$current"
    return $?
  fi
  # Keep the legacy non-READY AUTO bound unchanged. READY AUTO may inspect
  # all four prepared reserves before a small fresh-qualified fallback.
  local max_checks=3
  [[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]] && max_checks=6
  max_candidate_visits="$max_checks"
  if [[ "${MIHOMO_XRAY_AUTO_FAILOVER_CANARY:-0}" == 1 && "$MIHOMO_READY_AUTO_CANARY" == 0 ]]; then
    # Bounded recovery: two independently validated Xray candidates before
    # AWG fallback. Time-rotated nomination covers a changing subscription
    # across incidents without a dangerous unbounded outage loop.
    max_candidate_visits=$((max_checks + max_xray_visits))
  fi
  local -a excludes=("$current") best_args=() hot_args=()
  local -a union_args=(--provider "$MIHOMO_READY_UNION_PROVIDER"
     --pool "$MIHOMO_READY_UNION_POOL" --state "$MIHOMO_READY_UNION_STATE")

  # Canary requires an independent post-activation verifier; missing verifier
  # must fail closed rather than silently accept a localhost proxy test.
  if [[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]]; then
    [[ -x "$MIHOMO_READY_POSTCHECK_BIN" && -f "$MIHOMO_READY_GUARD_BIN" ]] || {
      echo "READY_AUTO=POSTCHECK_OR_GUARD_UNAVAILABLE" >&2
      return 1
    }
    [[ "$MIHOMO_SERVICE_GATE_MODE" == balanced || "$MIHOMO_SERVICE_GATE_MODE" == require ]] || {
      echo "READY_AUTO=SERVICE_GATE_DISABLED" >&2
      return 1
    }
    # Missing Hot Pool is a broken canary installation, not "zero READY".
    # Fail closed rather than silently claiming READY-priority behavior.
    [[ -x "$MIHOMO_HOT_POOL_CLI" ]] || {
      echo "READY_AUTO=HOT_POOL_UNAVAILABLE" >&2
      return 1
    }
  fi

  "$MIHOMO_POOL_CLI" ensure live --geo-if-policy >/dev/null 2>&1 || return 1
  "$MIHOMO_POOL_CLI" cooldown add "$current" >/dev/null 2>&1 || true

  while true; do
    best_args=(best live)
    for item in "${excludes[@]}"; do best_args+=(--exclude "$item"); done
    candidate=""
    from_ready=0
    if [[ "$MIHOMO_READY_AUTO_CANARY" == 1 && -x "$MIHOMO_HOT_POOL_CLI" ]]; then
      hot_args=("${union_args[@]}" best)
      for item in "${excludes[@]}"; do hot_args+=(--exclude "$item"); done
      candidate="$("$MIHOMO_HOT_POOL_CLI" "${hot_args[@]}" 2>/dev/null)" || candidate=""
      [[ -z "$candidate" ]] || from_ready=1
    fi
    if [[ -z "$candidate" && "$candidate_visits" -lt "$max_checks" ]]; then
      candidate="$("$MIHOMO_POOL_CLI" "${best_args[@]}" 2>/dev/null)" || candidate=""
    fi
    if [[ -z "$candidate" && "${MIHOMO_XRAY_AUTO_FAILOVER_CANARY:-0}" == 1 &&
          "$MIHOMO_READY_AUTO_CANARY" == 0 && "$xray_visits" -lt "$max_xray_visits" ]]; then
      # The native Mihomo health pool can exclude XHTTP/REALITY candidates.
      # Only when it is exhausted, nominate one exact Xray candidate from
      # the independent provider/fingerprint-aware network health inventory.
      xray_visits=$((xray_visits+1))
      if [[ -x "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]]; then
        local -a unified_args=(best --engine XRAY --rotate)
        for item in "${excludes[@]}"; do unified_args+=(--exclude "$item"); done
        candidate="$("${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" "${unified_args[@]}" 2>/dev/null)" || candidate=""
      fi
    fi
    [[ -n "$candidate" ]] || break
    # Bound ALL candidates, including resolver-rejected cross-core nodes.
    # A pool helper can repeatedly return the same excluded candidate.
    (( candidate_visits < max_candidate_visits )) || { echo "MIHOMO_NODE_FAILOVER=CANDIDATE_LIMIT" >&2; break; }
    candidate_visits=$((candidate_visits+1))
    validate_node_name "$candidate" || return 1
    # A faulty pool helper must not return an excluded dead/failed node.
    for item in "${excludes[@]}"; do
      [[ "$candidate" != "$item" ]] || {
        echo 'READY_AUTO=EXCLUDED_NODE_RETURNED' >&2
        return 1
      }
    done

    # READY only: reject missing/renamed/duplicated or credential-changed
    # profiles. Staged/archived nodes are NOT automatically live-selectable.
    if (( from_ready == 1 )); then
      if ! python3 -B "$MIHOMO_READY_GUARD_BIN" \
        --live "$MIHOMO_READY_LIVE_PROVIDER" \
        --union "$MIHOMO_READY_UNION_PROVIDER" \
        --node "$candidate" >/dev/null; then
        echo "READY_AUTO=IDENTITY_REJECTED" >&2
        excludes+=("$candidate")
        continue
      fi
    fi

    if [[ "$MIHOMO_SERVICE_GATE_MODE" == require || "$MIHOMO_SERVICE_GATE_MODE" == balanced ]]; then
      # Four prepared READY reserves plus bounded freshly checked fallback.
      (( attempts < max_checks )) || break
      attempts=$((attempts + 1))
    fi
    # READY already has TWO fresh isolated OpenAI/ChatGPT-network/YouTube24
    # proofs, and its exact live credentials were matched above. Don't rerun
    # the expensive media scan for that same READY proof during an outage.
    # Freshly discovered non-READY candidates (and strict REQUIRE mode) still
    # must pass an independent new service check before touching live traffic.
    if (( from_ready == 0 )) || [[ "$MIHOMO_SERVICE_GATE_MODE" == require ]]; then
      if ! service_candidate_allowed "$candidate"; then
        if [[ "$MIHOMO_SERVICE_GATE_MODE" == balanced ]]; then
          "$MIHOMO_POOL_CLI" cooldown add "$candidate" --seconds 180 >/dev/null 2>&1 || true
        fi
        excludes+=("$candidate")
        continue
      fi
    fi

    # The legacy configure path cannot activate the Xray sidecar safely.
    # Explicitly exclude cross-core candidates until a guarded transactional
    # switch with independent no-return recovery is certified.
    if [[ -e "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]]; then
      [[ -x "${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" ]] || { echo "MIHOMO_NODE_FAILOVER=ENGINE_RESOLVER_UNAVAILABLE" >&2; continue; }
      resolved="$("${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}" resolve "$candidate" 2>/dev/null)" || { excludes+=("$candidate"); continue; }
      engine="$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolved")"
      if [[ "$engine" == XRAY ]]; then
        if auto_xray_candidate "$current" "$candidate" "$resolved"; then
          return 0
        else
          xray_rc=$?
          # An aborted live transaction is not a normal failed candidate:
          # it owns independent recovery and requires transport-level AWG.
          (( xray_rc == 2 )) || return 1
          excludes+=("$candidate")
          continue
        fi
      fi
      if [[ "$engine" != MIHOMO ]]; then
        echo "MIHOMO_NODE_FAILOVER=ENGINE_UNSUPPORTED" >&2
        excludes+=("$candidate")
        continue
      fi
    fi
    # When recovering from an already FAILED live node, the configure
    # transaction must not restart that old node if candidate activation fails.
    # In experimental cross-core AUTO, a rejected native candidate must
    # never re-activate the already failed original before trying Xray/AWG.
    # Preserve the legacy behavior when the experiment is disabled.
    local recovery_guard="$MIHOMO_READY_AUTO_CANARY"
    [[ "${MIHOMO_XRAY_AUTO_FAILOVER_CANARY:-0}" != 1 ]] || recovery_guard=1
    if MIHOMO_NODE_FAILOVER_RECOVERY="$recovery_guard"       "$MIHOMO_CONFIGURE" node select-auto "$candidate" >/dev/null; then
      # Only the canary adds this additional validation; the underlying
      # configure command already provides its own rollback on failure.
      if [[ "$MIHOMO_READY_AUTO_CANARY" != 1 ]]; then
        printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
        return 0
      fi
      local post_summary="" post_reason="NODE_CHANGED"
      if [[ "$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || true)" == "$candidate" ]]; then
        if [[ "${MIHOMO_STANDBY_REPAIR:-0}" == 1 ]]; then
          post_summary="$(standby_postcheck "$candidate" 2>&1)" && post_rc=0 || post_rc=$?
        else
          post_summary="$("$MIHOMO_READY_POSTCHECK_BIN" "$candidate" 2>&1)" && post_rc=0 || post_rc=$?
        fi
        if (( post_rc == 0 )); then
          printf 'READY_AUTO_POSTCHECK=PASS\n' >&2
          printf 'MIHOMO_NODE_FAILOVER=%s->%s\n' "$current" "$candidate"
          return 0
        fi
        post_reason="$(grep -oE 'READY_TUN_CHECK=(IF_DOWN|ROUTE_MISSING|MARK_MISMATCH|EGRESS_FAILED|EGRESS_INVALID|OPENAI_NETWORK_FAILED|OPENAI_NOT_QUALIFIED|NODE_CHANGED)' <<<"$post_summary" | tail -1 || true)"
        post_reason="${post_reason#READY_TUN_CHECK=}"
        [[ -n "$post_reason" ]] || post_reason=UNKNOWN
      fi
      echo "READY_AUTO=POSTCHECK_FAILED REASON=$post_reason" >&2
      # A missing/late Transit route, mark or TUN is an infrastructure
      # fault, NOT evidence that the candidate endpoint failed. Do NOT
      # quarantine healthy nodes because of our own routing transition.
      case "$post_reason" in
        EGRESS_INVALID)
          if (( from_ready == 1 )); then
            "$MIHOMO_HOT_POOL_CLI" "${union_args[@]}" quarantine "$candidate" --reason active-health-failed >/dev/null 2>&1 || true
          fi
          ;;
        EGRESS_FAILED|OPENAI_NETWORK_FAILED|OPENAI_NOT_QUALIFIED)
          # Transient network and challenge/HTTP 403 remain uncertain;
          # use short cooldown, not a 2-hour shared-endpoint quarantine.
          "$MIHOMO_POOL_CLI" cooldown add "$candidate" --seconds 180 >/dev/null 2>&1 || true
          ;;
        ROUTE_MISSING|MARK_MISMATCH|IF_DOWN|NODE_CHANGED|UNKNOWN)
          # Infrastructure readiness; no candidate penalty.
          ;;
      esac
      # The previous node was already declared FAILED by selection-monitor.
      # Never switch back to it as a supposed recovery. Reject this candidate,
      # keep it excluded, and try the next READY candidate in the same event.
      # Transient infrastructure errors are not grounds for quarantining the
      # shared endpoint. Bound all attempts and keep the Transit guard.
      excludes+=("$candidate")
      echo "READY_AUTO=RETRY_NEXT_READY REASON=$post_reason" >&2
      continue
    else
      if (( from_ready == 1 )); then
        "$MIHOMO_HOT_POOL_CLI" "${union_args[@]}" quarantine "$candidate" --reason activation-failed >/dev/null 2>&1 || true
      fi
    fi
    "$MIHOMO_POOL_CLI" cooldown add "$candidate" >/dev/null 2>&1 || true
    excludes+=("$candidate")
  done
  # If a candidate activated but failed the *actual TUN* postcheck (or the
  # original node has failed and no candidate could be committed), do not
  # leave that unverified transport serving forwarded traffic. The transport
  # monitor can now activate a configured AWG, otherwise Transit stays closed.
  if [[ "${MIHOMO_STANDBY_REPAIR:-0}" == 1 ]]; then
    # The active transport is AWG. Never disable AWG Transit routing or
    # fail-open the healthy dataplane when repairing an unused standby.
    standby_routes_safe || { echo 'STANDBY_REPAIR=AWG_ROUTE_CHANGED' >&2; return 1; }
    "$MIHOMO_AUTO_SYSTEMCTL" stop "$MIHOMO_AUTO_SERVICE" >/dev/null || return 1
    echo 'STANDBY_REPAIR=UNVERIFIED_STANDBY_STOPPED' >&2
    return 1
  fi
  if [[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]]; then
    quiesce_failed_mihomo || {
      echo 'READY_AUTO=QUIESCE_FAILED' >&2
      return 1
    }
  fi
  return 1
}

failover(){
  local current mode unified_cli
  mode="$(mode_get 2>/dev/null || echo invalid)"
  [[ "$mode" == auto ]] || return 1
  is_enabled || return 1
  current="$(cat "$MIHOMO_NODE_NAME_FILE" 2>/dev/null || true)"
  [[ -n "$current" ]] || return 1
  unified_cli="${MIHOMO_UNIFIED_NODE_CLI:-/usr/local/sbin/awg-mihomo-unified-nodes}"
  [[ -x "$unified_cli" ]] || {
    echo 'MIHOMO_NODE_FAILOVER=UNIFIED_INVENTORY_MISSING' >&2
    return 1
  }
  failover_unified "$current"
}

case "${1:-status}" in
  standby-repair)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    standby_repair
    ;;
  xray-auto)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    case "$2" in
      status) printf 'MIHOMO_XRAY_AUTO=%s\n' "$([[ "$_xray_auto_mode" == 1 ]] && echo enabled || echo disabled)" ;;
      enable)
        [[ "$(mode_get)" == auto ]] || { echo XRAY_AUTO_REQUIRES_NODE_AUTO >&2; exit 1; }
        # Xray AUTO is independent of the retired READY policy.
        for f in /usr/local/sbin/awg-xray-live-backend /usr/local/sbin/awg-xray-activation-transaction /usr/local/sbin/awg-mihomo-unified-nodes /usr/local/sbin/awg-xray-vless;do
          [[ -x "$f" ]] || { echo XRAY_AUTO_MISSING_ENGINE_COMPONENT >&2;exit 1; }
        done
        [[ -s /etc/amnezia/amneziawg/awg0.conf ]] || { echo XRAY_AUTO_REQUIRES_CONFIGURED_AWG_BACKUP >&2;exit 1; }
        tmp="$(mktemp "${MIHOMO_XRAY_AUTO_MODE_FILE}.XXXXXX")"
        printf '1\n' > "$tmp"
        chmod 600 "$tmp"
        mv -f "$tmp" "$MIHOMO_XRAY_AUTO_MODE_FILE"
        echo MIHOMO_XRAY_AUTO=enabled
        ;;
      disable)
        mkdir -p "$(dirname "$MIHOMO_XRAY_AUTO_MODE_FILE")"
        tmp="$(mktemp "${MIHOMO_XRAY_AUTO_MODE_FILE}.XXXXXX")"
        printf '0\n' > "$tmp"
        chmod 600 "$tmp"
        mv -f "$tmp" "$MIHOMO_XRAY_AUTO_MODE_FILE"
        echo MIHOMO_XRAY_AUTO=disabled
        ;;
      *) usage >&2;exit 2;;
    esac
    ;;
  auto-strategy)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    case "$2" in
      status) strategy_status ;;
      ready|classic) select_auto_strategy "$2" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  ready-auto)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    case "$2" in
      enable|disable) set_ready_auto "$2" ;;
      status) printf 'MIHOMO_READY_AUTO=%s\n' "$([[ "$MIHOMO_READY_AUTO_CANARY" == 1 ]] && echo enabled || echo disabled)" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  status)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    status
    ;;
  manual-selection)
    case "${2:-}" in
      preview)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        manual_selection_order "$3"
        ;;
      apply)
        [[ $# -eq 3 ]] || { usage >&2; exit 2; }
        manual_selection_apply "$3"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  mode)
    case "${2:-}" in
      manual)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        set_manual
        ;;
      fixed)
        [[ $# -ge 3 ]] || { usage >&2; exit 2; }
        shift 2
        set_fixed "$@"
        ;;
      auto)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        set_auto
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  enabled)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    is_enabled
    ;;
  failover)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    failover
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

