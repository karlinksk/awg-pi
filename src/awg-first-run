#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

TTY="${AWG_FIRST_RUN_TTY:-/dev/tty}"
AWG_ROUTE="${AWG_ROUTE_BIN:-/usr/local/sbin/awg-route}"
AWG_TRANSPORT="${AWG_TRANSPORT_BIN:-/usr/local/sbin/awg-transport}"
MIHOMO_CONFIGURE="${MIHOMO_CONFIGURE_BIN:-/usr/local/sbin/awg-mihomo-configure}"
MIHOMO_INSTALLER="${MIHOMO_INSTALLER_BIN:-/usr/local/sbin/awg-mihomo-install}"
MIHOMO_NODE_POLICY="${MIHOMO_NODE_POLICY_BIN:-/usr/local/sbin/awg-mihomo-node-policy}"
MIHOMO_ENV_FILE="${MIHOMO_ENV_FILE:-/etc/awg-pbr/transports/mihomo/provider.env}"
MIHOMO_BIN="${MIHOMO_BIN:-/usr/local/bin/mihomo}"
export MIHOMO_ENV_FILE MIHOMO_BIN

ui_print(){
  if ! { printf '%s\n' "$*" >"$TTY"; } 2>/dev/null; then
    printf '%s\n' "$*"
  fi
}

usage(){
  cat <<'USAGE'
Usage:
  awg-first-run wizard
  awg-first-run awg-file FILE
  awg-first-run mihomo-url URL [standard|remnawave] [auto|mihomo|vless|base64]
  awg-first-run mihomo-file FILE [auto|mihomo|vless|base64]
  awg-first-run mihomo-engine-file PINNED_ASSET.gz
  awg-first-run status

The wizard configures the first transport backend only. Operating Mode
(Selective/Transit) is intentionally chosen afterward by the installer/user.
USAGE
}

ask(){
  local prompt="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default]: " value <"$TTY"
    REPLY="${value:-$default}"
  else
    read -r -p "$prompt: " value <"$TTY"
    REPLY="$value"
  fi
}

secret_ask(){
  local prompt="$1" value
  read -r -s -p "$prompt: " value <"$TTY"
  printf '\n' >"$TTY"
  REPLY="$value"
}

paste_to_temp(){
  local label="$1" tmp
  tmp="$(mktemp /run/awg-pbr/first-run.XXXXXX)"
  chmod 600 "$tmp"
  printf '%s\n' "$label" >"$TTY"
  printf '%s\n' 'Завершите отдельной строкой __END__' >"$TTY"
  : >"$tmp"
  while IFS= read -r line <"$TTY"; do
    [[ "$line" == "__END__" ]] && break
    printf '%s\n' "$line" >>"$tmp"
  done
  sed -i 's/\r$//' "$tmp"
  [[ -s "$tmp" ]] || {
    rm -f "$tmp"
    echo "Pasted profile is empty" >&2
    return 1
  }
  printf '%s\n' "$tmp"
}

transport_state(){
  "$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured
}

ensure_fresh_target(){
  local state
  state="$(transport_state)"
  [[ "$state" == unconfigured ]] || {
    echo "A transport is already selected: $state. Use the normal transport/configuration menus." >&2
    return 1
  }
}

activate_awg_file(){
  local file="$1"
  ensure_fresh_target
  [[ -f "$file" && -r "$file" && ! -L "$file" ]] || {
    echo "AWG/WireGuard profile is not a readable regular file: $file" >&2
    return 2
  }
  "$AWG_ROUTE" config check "$file"
  "$AWG_ROUTE" config replace "$file" --yes
  "$AWG_TRANSPORT" select awg
  printf 'FIRST_TRANSPORT=awg\n'
}

configure_mihomo_node_chain(){
  local primary="$1" answer next chain node existing
  local -a nodes=("$primary")
  [[ "${AWG_FIRST_RUN_INTERACTIVE:-0}" == 1 ]] || return 0

  ask "Настроить резервную последовательность Mihomo nodes сейчас? (y/N)" "N"
  answer="$REPLY"
  if [[ ! "$answer" =~ ^([Yy]|[Дд][Аа]?)$ ]]; then
    "$MIHOMO_NODE_POLICY" mode manual >/dev/null
    ui_print "Mihomo node failover: MANUAL"
    return 0
  fi

  while true; do
    ui_print "$(printf '\n=== Live Mihomo nodes ===\n%s\n' "$("$MIHOMO_CONFIGURE" node list)")"
    ask "Следующий fallback node (ТОЧНОЕ имя; пусто = закончить)" ""
    next="$REPLY"
    [[ -n "$next" ]] || break

    for existing in "${nodes[@]}"; do
      if [[ "$existing" == "$next" ]]; then
        ui_print "Этот node уже есть в цепочке: $next"
        next=""
        break
      fi
    done
    [[ -n "$next" ]] || continue

    if ! "$MIHOMO_CONFIGURE" node prepare "$next" >/dev/null; then
      ui_print "Node не найден/не готов: $next"
      continue
    fi
    nodes+=("$next")
    chain="$(printf ' -> %s' "${nodes[@]}")"
    ui_print "Текущая цепочка: ${chain# -> }"
  done

  if (( ${#nodes[@]} < 2 )); then
    "$MIHOMO_NODE_POLICY" mode manual >/dev/null
    ui_print "Fallback nodes не добавлены; Mihomo node failover остаётся MANUAL."
    return 0
  fi

  chain="$(printf ' -> %s' "${nodes[@]}")"
  ui_print "Итоговая exact-node chain: ${chain# -> }"
  "$MIHOMO_NODE_POLICY" mode fixed "${nodes[@]}"
}

choose_mihomo_node(){
  local source="${1:-live}" nodes name prepared endpoint
  case "$source" in
    live)
      nodes="$("$MIHOMO_CONFIGURE" node list)" || return
      ;;
    candidate)
      nodes="$("$MIHOMO_CONFIGURE" provider candidate list)" || return
      ;;
    *)
      return 2
      ;;
  esac
  ui_print "$(printf '\n=== Доступные Mihomo nodes ===\n%s\n' "$nodes")"
  name="${AWG_FIRST_RUN_NODE:-}"
  if [[ -z "$name" ]]; then
    ask "Введите точное имя первого Mihomo node"
    name="$REPLY"
  fi
  [[ -n "$name" ]] || {
    echo "Node name is required" >&2
    return 2
  }

  if [[ "$source" == candidate ]]; then
    prepared="$("$MIHOMO_CONFIGURE" provider candidate prepare "$name")" || return
  else
    prepared="$("$MIHOMO_CONFIGURE" node prepare "$name")" || return
  fi
  ui_print "$prepared"
  endpoint="${AWG_FIRST_RUN_ENDPOINT:-}"
  if [[ -z "$endpoint" ]]; then
    ask "Введите один IPv4 из Resolved IPv4 endpoints"
    endpoint="$REPLY"
  fi
  [[ -n "$endpoint" ]] || {
    echo "Endpoint IPv4 is required" >&2
    return 2
  }

  if [[ "$source" == candidate ]]; then
    "$MIHOMO_CONFIGURE" provider candidate commit "$name" "$endpoint"
  else
    "$MIHOMO_CONFIGURE" node select "$name" "$endpoint"
  fi
  "$AWG_TRANSPORT" select mihomo
  configure_mihomo_node_chain "$name"
  printf 'FIRST_TRANSPORT=mihomo\n'
}

ensure_mihomo_binary(){
  local interactive="${1:-0}" path rc
  [[ -x "$MIHOMO_BIN" ]] && return 0

  if "$MIHOMO_INSTALLER"; then
    return 0
  fi
  rc=$?
  (( interactive == 1 )) || return "$rc"

  ui_print "AUTO-загрузка Mihomo не удалась. Можно указать локальный pinned .gz этой версии."
  ask "Полный путь к локальному Mihomo .gz (пусто = отменить)" ""
  path="$REPLY"
  [[ -n "$path" ]] || return "$rc"
  "$MIHOMO_INSTALLER" --file "$path"
}

activate_mihomo_url(){
  local url="$1" profile="${2:-standard}" format="${3:-auto}" tmp rc
  ensure_fresh_target
  ensure_mihomo_binary "${AWG_FIRST_RUN_INTERACTIVE:-0}"
  case "$profile" in standard|remnawave) ;; *) echo "Unsupported provider profile: $profile" >&2; return 2 ;; esac
  case "$format" in auto|mihomo|vless|base64) ;; *) echo "Unsupported provider format: $format" >&2; return 2 ;; esac
  [[ "$url" =~ ^https?://[^[:space:]]+$ ]] || {
    echo "Mihomo subscription URL must be http(s) without whitespace" >&2
    return 2
  }

  mkdir -p /run/awg-pbr
  chmod 700 /run/awg-pbr
  tmp="$(mktemp /run/awg-pbr/first-run-mihomo.XXXXXX)"
  {
    printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
    printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
    printf 'MIHOMO_PROVIDER_FORMAT=%q\n' "$format"
  } >"$tmp"
  chmod 600 "$tmp"
  if "$MIHOMO_CONFIGURE" init "$tmp"; then
    rm -f "$tmp"
  else
    rc=$?
    rm -f "$tmp"
    return "$rc"
  fi
  choose_mihomo_node candidate
}

activate_mihomo_file(){
  local file="$1" format="${2:-auto}"
  ensure_fresh_target
  [[ -f "$file" && -r "$file" && ! -L "$file" ]] || {
    echo "Mihomo provider is not a readable regular file: $file" >&2
    return 2
  }
  case "$format" in auto|mihomo|vless|base64) ;; *) echo "Unsupported provider format: $format" >&2; return 2 ;; esac

  ensure_mihomo_binary "${AWG_FIRST_RUN_INTERACTIVE:-0}"
  "$MIHOMO_CONFIGURE" provider stage-file "$file" local-only "$format"
  choose_mihomo_node candidate
}

wizard(){
  local choice path tmp profile format url rc
  export AWG_FIRST_RUN_INTERACTIVE=1
  ensure_fresh_target || return
  cat >"$TTY" <<'TEXT'

=== Первичная настройка transport ===
Что у вас уже есть?

1) AmneziaWG / WireGuard native .conf — файл
2) AmneziaWG / WireGuard native .conf — вставить текст
3) Mihomo / VLESS subscription URL
4) Mihomo provider/subscription — локальный файл
5) Mihomo provider/subscription — вставить текст
6) Пока ничего не настраивать

Transport не выбирается автоматически. После успешной настройки отдельно
выбирается Operating Mode: Selective или Transit.
TEXT
  ask "Выбор" "6"
  choice="$REPLY"

  case "$choice" in
    1)
      ask "Полный путь к AmneziaWG .conf"
      activate_awg_file "$REPLY"
      ;;
    2)
      tmp="$(paste_to_temp 'Вставьте native AmneziaWG / WireGuard .conf')" || return
      if activate_awg_file "$tmp"; then
        rm -f "$tmp"
      else
        rc=$?
        rm -f "$tmp"
        return "$rc"
      fi
      ;;
    3)
      secret_ask "Вставьте полный subscription URL"
      url="$REPLY"
      printf '%s\n' 'Provider mode: 1=standard/generic, 2=Remnawave-compatible' >"$TTY"
      ask "Provider mode" "1"
      case "$REPLY" in
        1) profile=standard ;;
        2) profile=remnawave ;;
        *) echo "Invalid provider mode" >&2; return 2 ;;
      esac
      format=auto
      activate_mihomo_url "$url" "$profile" "$format"
      unset url
      ;;
    4)
      ask "Полный путь к Mihomo YAML / VLESS / Base64 subscription"
      path="$REPLY"
      activate_mihomo_file "$path" auto
      ;;
    5)
      tmp="$(paste_to_temp 'Вставьте Mihomo YAML, VLESS URI(s) или Base64 subscription')" || return
      if activate_mihomo_file "$tmp" auto; then
        rm -f "$tmp"
      else
        rc=$?
        rm -f "$tmp"
        return "$rc"
      fi
      ;;
    6)
      printf 'FIRST_TRANSPORT=unconfigured\n'
      ;;
    *)
      echo "Invalid first transport choice: $choice" >&2
      return 2
      ;;
  esac
}

case "${1:-wizard}" in
  wizard)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    wizard
    ;;
  awg-file)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    activate_awg_file "$2"
    ;;
  mihomo-url)
    [[ $# -ge 2 && $# -le 4 ]] || { usage >&2; exit 2; }
    activate_mihomo_url "$2" "${3:-standard}" "${4:-auto}"
    ;;
  mihomo-file)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
    activate_mihomo_file "$2" "${3:-auto}"
    ;;
  mihomo-engine-file)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    "$MIHOMO_INSTALLER" --file "$2"
    ;;
  status)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    "$AWG_TRANSPORT" status
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
