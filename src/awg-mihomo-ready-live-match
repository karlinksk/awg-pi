#!/usr/bin/env python3
"""Read-only exact READY-to-live transport credential match. No secret output."""
import argparse
import sys
from pathlib import Path
import yaml

def unique_profile(path, name):
    p = Path(path)
    if not p.is_file() or p.is_symlink() or p.stat().st_size > 5_000_000:
        raise ValueError("invalid provider")
    obj = yaml.safe_load(p.read_text())
    if not isinstance(obj, dict) or not isinstance(obj.get("proxies"), list):
        raise ValueError("invalid proxies")
    matches = [x for x in obj["proxies"] if isinstance(x, dict) and x.get("name") == name]
    if len(matches) != 1:
        raise ValueError("missing or duplicate")
    return matches[0]

def check(live, union, name):
    if not name or len(name) > 100 or any(ord(c) < 32 for c in name):
        return False
    a = unique_profile(live, name)
    b = unique_profile(union, name)
    return {k:v for k,v in a.items() if k != "name"} == {k:v for k,v in b.items() if k != "name"}

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--live", required=True)
    parser.add_argument("--union", required=True)
    parser.add_argument("--node", required=True)
    args = parser.parse_args()
    try:
        ok = check(args.live, args.union, args.node)
    except (OSError, ValueError, TypeError, yaml.YAMLError):
        ok = False
    print("READY_LIVE_MATCH=" + ("PASS" if ok else "REJECT"))
    sys.exit(0 if ok else 1)

