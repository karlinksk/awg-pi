#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

# Re-exec from a temporary copy so an installer may safely replace /usr/local/sbin/awg-update.
if [[ "${AWG_UPDATE_REEXEC:-0}" != 1 ]]; then
  _self_tmp="$(mktemp /tmp/awg-update.XXXXXX)"
  cp "$0" "$_self_tmp"
  chmod 700 "$_self_tmp"
  export AWG_UPDATE_REEXEC=1
  exec "$_self_tmp" "$@"
fi
trap 'rm -f "$0" 2>/dev/null || true' EXIT

REPO=karlinksk/awg-pi
API="https://api.github.com/repos/$REPO/releases/latest"
RAW="https://raw.githubusercontent.com/$REPO"
VERSION_FILE=/etc/awg-pbr/version
PUBLIC_VERSION_FILE=/usr/share/awg-pbr/version
BACKUP_ROOT=/var/backups/awg-gateway
CORE_UPDATE=/usr/local/sbin/awg-core-update
MIHOMO_INSTALLER=/usr/local/sbin/awg-mihomo-install
XRAY_INSTALLER=/usr/local/sbin/awg-xray-install
ASSUME_YES=0

confirm(){
  local p="$1" ans
  if (( ASSUME_YES == 1 )); then return 0; fi
  read -r -p "$p [Y/n]: " ans </dev/tty
  ans="${ans:-Y}"
  [[ "$ans" =~ ^[YyДд] ]]
}
current_version(){
  cat "$PUBLIC_VERSION_FILE" 2>/dev/null || cat "$VERSION_FILE" 2>/dev/null || echo "0.0.0"
}
latest_release(){
  curl -4fsSL --retry 3 --connect-timeout 8 --max-time 20 "$API" |
    jq -r '.tag_name // empty' | sed 's/^v//'
}
version_gt(){
  local a="$1" b="$2" top
  [[ "$a" != "$b" ]] || return 1
  top="$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1)"
  [[ "$top" == "$a" ]]
}
