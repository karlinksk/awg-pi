    awg-notify-watch.service \
    awg-notify-daily.service \
    awg-notify-boot.service \
    awg-pbr-health.service \
    2>/dev/null || true

  # Only remove the Node.js link when this gateway itself manages it. Never
  # overwrite/delete an unrelated system-level Node.js installation.
  if [[ -L /usr/local/bin/node ]]; then
    _node_target="$(readlink -- /usr/local/bin/node)"
    if [[ "$_node_target" == /usr/local/lib/awg-pi/node/*/node ]]; then
      rm -f -- /usr/local/bin/node
    fi
  fi
  rm -rf /etc/awg-pbr /var/lib/awg-pbr/xray-vless /var/lib/awg-pbr/mihomo /var/lib/awg-pbr/hot-pool /var/lib/awg-pbr/traffic /usr/local/lib/awg-pi /usr/share/awg-pbr
  rm -rf /var/lib/awg-pbr/stage18-runtime /var/lib/awg-pbr/notify
  # A failed restore must not leave notifier timers or the boot hook enabled.
  systemctl disable --now awg-notify-flush.timer awg-notify-watch.timer awg-notify-daily.timer awg-notify-boot.service 2>/dev/null || true
  rm -f \
    /usr/local/bin/mihomo \
    /usr/local/bin/awg-xray-vless-core \
    /usr/local/bin/awg-dc \
    /usr/local/sbin/awg-mihomo-limits.py \
    /usr/local/sbin/awg-mihomo-service-check.py \
    /usr/local/sbin/awg-mihomo-video-decode.py \
