    /etc/systemd/system/awg-notify-watch.timer \
    /etc/systemd/system.conf.d/99-awg-gateway-watchdog.conf \
    /etc/profile.d/awg-menu.sh

  tar -C / -xzf "$dir/gateway-state.tgz"
  systemctl daemon-reload
  sysctl --system >/dev/null 2>&1 || true
  systemctl restart awg-pbr-setup.service 2>/dev/null || true
  systemctl restart dnsmasq.service 2>/dev/null || true
  systemctl restart awg-quick@awg0.service 2>/dev/null || true
  systemctl restart awg-pbr-health.service 2>/dev/null || true
  [[ -f /etc/systemd/system/awg-selection-monitor.service ]] &&
    systemctl restart awg-selection-monitor.service 2>/dev/null || true
  [[ -f /etc/systemd/system/awg-traffic.service ]] &&
    systemctl restart awg-traffic.service 2>/dev/null || true
  systemctl start awg-opencck-update.timer 2>/dev/null || true
  [[ -f /etc/systemd/system/awg-mihomo.service ]] &&
    systemctl start awg-mihomo.service 2>/dev/null || true
  [[ -f /etc/systemd/system/awg-mihomo-update.timer ]] &&
    systemctl start awg-mihomo-update.timer 2>/dev/null || true
  # Restore the exact prior activation policy: fresh/passive installations
  # must NOT accidentally enable Hot Pool during rollback.
  if [[ -f /etc/systemd/system/awg-mihomo-hot-pool.timer &&
        "$(cat "$dir/hot-pool-timer-state" 2>/dev/null || true)" == enabled ]]; then
    systemctl enable --now awg-mihomo-hot-pool.timer 2>/dev/null || true
  else
    systemctl disable --now awg-mihomo-hot-pool.timer 2>/dev/null || true
  fi
  # Restore notifier opt-in status, never auto-enable on old/passive setups.
  local notify_unit notify_enabled
  for notify_unit in awg-notify-flush.timer awg-notify-watch.timer awg-notify-daily.timer awg-notify-boot.service; do
    notify_enabled="$(cat "$dir/notify-activation-$notify_unit" 2>/dev/null || true)"
    if [[ -f "/etc/systemd/system/$notify_unit" && "$notify_enabled" == enabled ]]; then
      if [[ "$notify_unit" == *.timer ]]; then
        systemctl enable --now "$notify_unit" 2>/dev/null || true
      else
        systemctl enable "$notify_unit" 2>/dev/null || true
      fi
    else
      systemctl disable --now "$notify_unit" 2>/dev/null || true
    fi
  done
  echo "Rollback завершён." >&2
}

gateway_update(){
  local cur latest tag tmp internal bk transit_choice=""
  cur="$(current_version)"
  latest="$(latest_release)"
  [[ -n "$latest" ]] || { echo "Не удалось определить latest release AWG Pi Gateway" >&2; return 1; }

  echo "AWG Pi Gateway: installed=$cur latest=$latest"
  if [[ "$cur" == "$latest" ]] || version_gt "$cur" "$latest"; then
    echo "Обновление AWG Pi Gateway не требуется."
    return 0
  fi
  confirm "Обновить AWG Pi Gateway $cur -> $latest?" || return 0

  if [[ "$cur" == 1.1.0 ]] && version_gt "$latest" "1.1.0"; then
    if (( ASSUME_YES == 1 )); then
      transit_choice=1
      echo "v1.1.0 -> $latest: --yes подтверждает post-upgrade Transit preflight/switch."
    elif confirm "После обновления попытаться включить MikroTik Transit / Backup VPN? При ошибке останется Selective Gateway."; then
      transit_choice=1
    else
      transit_choice=0
      echo "После обновления будет сохранён Selective Gateway."
    fi
  fi

  tag="v$latest"
  tmp="$(mktemp /tmp/awg-pi-install.XXXXXX.sh)"
  curl -4fLsS --retry 3 --connect-timeout 8 --max-time 45 "$RAW/$tag/install.sh" -o "$tmp"
  bash -n "$tmp"
  internal="$(grep -m1 -E '^(AWG_PI_VERSION|VERSION)="[0-9]+\.[0-9]+\.[0-9]+"' "$tmp" | cut -d'"' -f2 || true)"
  [[ "$internal" == "$latest" ]] || {
    echo "Отказ: AWG_PI_VERSION внутри installer ($internal) не совпадает с релизом $latest" >&2
    rm -f "$tmp"
    return 1
  }

  bk="$BACKUP_ROOT/gateway-update-$(date +%Y%m%d-%H%M%S)"
  backup_gateway "$bk"
  echo "Backup: $bk"

  set +e
  if [[ -n "$transit_choice" ]]; then
    AWG_PI_REF="$tag" AWG_PI_UPGRADE_AUTO=1 AWG_PI_UPGRADE_TRANSIT="$transit_choice" bash "$tmp"
  else
    AWG_PI_REF="$tag" AWG_PI_UPGRADE_AUTO=1 bash "$tmp"
  fi
  rc=$?
  set -e
  rm -f "$tmp"

  if (( rc != 0 )); then
    echo "Gateway update failed (rc=$rc)." >&2
    restore_gateway "$bk"
    return "$rc"
  fi

  if [[ "$(current_version)" != "$latest" ]]; then
    echo "После установки версия не изменилась на $latest; выполняется rollback." >&2
    restore_gateway "$bk"
    return 1
  fi

  echo "AWG Pi Gateway update: OK -> $latest"
  /usr/local/sbin/awg-route status || true
  find "$BACKUP_ROOT" -maxdepth 1 -mindepth 1 -type d -name 'gateway-update-*' -printf '%T@ %p\n' 2>/dev/null |
    sort -nr | awk 'NR>5{sub(/^[^ ]+ /,""); print}' | xargs -r rm -rf
}

mihomo_status(){
  if [[ -x "$MIHOMO_INSTALLER" ]]; then
    "$MIHOMO_INSTALLER" status || true
  else
    echo "Mihomo engine updater: missing"
  fi
}

mihomo_ensure(){
  [[ -x "$MIHOMO_INSTALLER" ]] || {
    echo "$MIHOMO_INSTALLER не найден" >&2
    return 1
  }
  "$MIHOMO_INSTALLER" ensure
}

show_status(){
  local cur latest
  cur="$(current_version)"
  latest="$(latest_release 2>/dev/null || true)"
  echo "AWG Pi Gateway: installed=$cur latest=${latest:-unknown}"
  if [[ -x "$CORE_UPDATE" ]]; then
    "$CORE_UPDATE" status || true
  else
    echo "AmneziaWG core updater: missing"
  fi
  mihomo_status
  if [[ -x "$XRAY_INSTALLER" ]]; then
    "$XRAY_INSTALLER" status || true
  else
    echo "Xray engine updater: missing"
  fi
  echo 'Engine status compares versions; it does not attest installed binary hashes.'
  echo 'Subscriptions are separate: engines do not refresh providers or select nodes.'
}

xray_ensure(){
  [[ -x "$XRAY_INSTALLER" ]] || { echo 'Xray engine updater: missing' >&2; return 1; }
  "$XRAY_INSTALLER" ensure
}

all_engines(){
  local engine rc failed=0 helper
  # Gateway installation can restart the dataplane and has its own explicit
  # menu/confirmation. Never sneak that disruptive operation into engine repair.
  show_status
  echo 'Gateway: check only; install separately using awg-update gateway.'
  for engine in core mihomo xray; do
    case "$engine" in
      core) helper="$CORE_UPDATE" ;;
      mihomo) helper="$MIHOMO_INSTALLER" ;;
      xray) helper="$XRAY_INSTALLER" ;;
    esac
    rc=0
    if [[ ! -x "$helper" ]]; then
      rc=127
    elif [[ "$engine" == core ]]; then
      "$helper" --yes || rc=$?
    else
      "$helper" ensure || rc=$?
    fi
    if (( rc == 0 )); then
      echo "ENGINE_RESULT=$engine OK"
    else
      echo "ENGINE_RESULT=$engine FAILED_OR_DEFERRED rc=$rc"
      failed=1
    fi
  done
  return "$failed"
}

cmd="${1:-}"
[[ "$cmd" == "--yes" ]] && { ASSUME_YES=1; shift; cmd="${1:-}"; }
case "$cmd" in
  status)
    show_status
    ;;
  backup)
    umask 077
    install -d -o root -g root -m 0700 "$BACKUP_ROOT"
    manual_backup="$(mktemp -d "$BACKUP_ROOT/gateway-manual-$(date +%Y%m%d-%H%M%S)-XXXXXXXX")"
    if backup_gateway "$manual_backup"; then
      printf "GATEWAY_BACKUP_ARCHIVE=%s\n" "$manual_backup/gateway-state.tgz"
      printf "GATEWAY_BACKUP_BYTES=%s\n" "$(stat -c %s "$manual_backup/gateway-state.tgz")"
    else
      rm -rf -- "$manual_backup"
      exit 1
    fi
    ;;
  gateway)
    gateway_update
    ;;
  core)
    shift || true
    [[ -x "$CORE_UPDATE" ]] || { echo "$CORE_UPDATE не найден" >&2; exit 1; }
    (( ASSUME_YES == 1 )) && exec "$CORE_UPDATE" --yes
    exec "$CORE_UPDATE" "$@"
    ;;
  mihomo)
    mihomo_ensure
    ;;
  xray)
    xray_ensure
    ;;
  all)
    confirm 'Check all engines and repair only inactive engines with release-pinned builds?' || exit 0
    all_engines
    ;;
  "")
    echo "1) AWG Pi Gateway"
    echo "2) AmneziaWG core"
    echo "3) Mihomo engine (supported pinned version)"
    echo "4) Все движки (Gateway — только проверка)"
    echo "5) Только показать версии"
    echo "6) Xray engine (supported pinned version)"
    read -r -p "Выбор [5]: " choice </dev/tty
    case "${choice:-5}" in
      1) gateway_update ;;
      2) exec "$CORE_UPDATE" ;;
      3) mihomo_ensure ;;
      4) all_engines ;;
      5) show_status ;;
      6) xray_ensure ;;
      *) echo "Неверный выбор" >&2; exit 2 ;;
    esac
    ;;
  *)
    echo "Использование: awg-update [--yes] {status|backup|gateway|core|mihomo|xray|all}" >&2
    exit 2
    ;;
esac
