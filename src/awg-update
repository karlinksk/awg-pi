  local -a required=(etc/awg-pbr usr/local/sbin/awg-route usr/local/sbin/awg-update)
  umask 077
  install -d -o root -g root -m 0700 "$dir" || return 1
  # Never silently certify an incomplete or unreadable gateway snapshot.
  for target in "${required[@]}"; do
    if [[ ! -e "/$target" ]]; then
      echo "GATEWAY_BACKUP_ERROR=REQUIRED_PATH_MISSING" >&2
      return 1
    fi
  done
  for target in "${backup_targets[@]}"; do
    if [[ -e "/$target" || -L "/$target" ]]; then
      selected+=("$target")
    fi
  done
  # Only the backup manifest is dynamic. Files from earlier releases may
  # legitimately be absent; a present but unreadable file must FAIL the backup.
  systemctl is-enabled awg-mihomo-hot-pool.timer 2>/dev/null >"$dir/hot-pool-timer-state" || true
  chmod 600 "$dir/hot-pool-timer-state"
  # Preserve explicitly opted-in notifier activation through rollback.
  # Secrets are already included under etc/awg-pbr; queue is under var/lib.
  local unit
  for unit in awg-notify-flush.timer awg-notify-watch.timer awg-notify-daily.timer awg-notify-boot.service; do
    systemctl is-enabled "$unit" 2>/dev/null >"$dir/notify-activation-$unit" || true
    chmod 600 "$dir/notify-activation-$unit"
  done
  archive_tmp="$(mktemp "$dir/.gateway-state.XXXXXXXX")" || return 1
  if ! tar -C / -czf "$archive_tmp" "${selected[@]}" 2>/dev/null; then
    rm -f -- "$archive_tmp"
    echo "GATEWAY_BACKUP_ERROR=ARCHIVE_CREATE_FAILED" >&2
    return 1
  fi
  if ! tar -tzf "$archive_tmp" >/dev/null 2>&1; then
    rm -f -- "$archive_tmp"
    echo "GATEWAY_BACKUP_ERROR=ARCHIVE_INTEGRITY_FAILED" >&2
    return 1
  fi
  mv -fT -- "$archive_tmp" "$dir/gateway-state.tgz" || {
    rm -f -- "$archive_tmp"
    echo "GATEWAY_BACKUP_ERROR=ARCHIVE_PUBLISH_FAILED" >&2
    return 1
  }
  chmod 600 "$dir/gateway-state.tgz"
  echo "GATEWAY_BACKUP=VERIFIED"
}
