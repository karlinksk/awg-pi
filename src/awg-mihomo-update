#!/usr/bin/env bash
set -Eeuo pipefail

MIHOMO_ENV_FILE="${MIHOMO_ENV_FILE:-/etc/awg-pbr/transports/mihomo/provider.env}"
MIHOMO_BIN="${MIHOMO_BIN:-/usr/local/bin/mihomo}"
MIHOMO_PROVIDER_FILE="${MIHOMO_PROVIDER_FILE:-/var/lib/awg-pbr/mihomo/providers/subscription.yaml}"
MIHOMO_SERVICE="${MIHOMO_SERVICE:-awg-mihomo.service}"
CURL_BIN="${CURL_BIN:-curl}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
MIHOMO_PREPARE="${MIHOMO_PREPARE:-/usr/local/sbin/awg-mihomo-prepare}"

[[ -r "$MIHOMO_ENV_FILE" ]] || {
  echo "Missing Mihomo provider environment: $MIHOMO_ENV_FILE" >&2
  exit 2
}
# shellcheck disable=SC1090
source "$MIHOMO_ENV_FILE"

: "${MIHOMO_PROVIDER_URL:?MIHOMO_PROVIDER_URL is required}"

MIHOMO_UPDATE_INTERFACE="${MIHOMO_UPDATE_INTERFACE:-awg0}"
MIHOMO_UPDATE_SUFFIX="${MIHOMO_UPDATE_SUFFIX:-}"
MIHOMO_DEVICE_OS="${MIHOMO_DEVICE_OS:-Linux}"
MIHOMO_DEVICE_VERSION="${MIHOMO_DEVICE_VERSION:-Debian}"
MIHOMO_DEVICE_MODEL="${MIHOMO_DEVICE_MODEL:-AWG Pi Gateway}"
MIHOMO_PROVIDER_USER_AGENT="${MIHOMO_PROVIDER_USER_AGENT:-mihomo/1.19.32}"
MIHOMO_PROVIDER_AUTHORIZATION="${MIHOMO_PROVIDER_AUTHORIZATION:-}"

[[ -x "$MIHOMO_BIN" ]] || {
  echo "Mihomo binary is unavailable: $MIHOMO_BIN" >&2
  exit 2
}

provider_dir="$(dirname "$MIHOMO_PROVIDER_FILE")"
mkdir -p "$provider_dir"
chmod 700 "$provider_dir"

tmp="$(mktemp "$provider_dir/.subscription.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

curl_args=(
  -4 --http1.1 -fsSL
  --connect-timeout 10 --max-time 45
  -A "$MIHOMO_PROVIDER_USER_AGENT"
)

if [[ -n "${MIHOMO_PROVIDER_HWID:-}" ]]; then
  curl_args+=(
    -H "x-hwid: $MIHOMO_PROVIDER_HWID"
    -H "x-device-os: $MIHOMO_DEVICE_OS"
    -H "x-ver-os: $MIHOMO_DEVICE_VERSION"
    -H "x-device-model: $MIHOMO_DEVICE_MODEL"
  )
fi

if [[ -n "$MIHOMO_PROVIDER_AUTHORIZATION" ]]; then
  curl_args+=(-H "Authorization: $MIHOMO_PROVIDER_AUTHORIZATION")
fi

if [[ -n "$MIHOMO_UPDATE_INTERFACE" && "$MIHOMO_UPDATE_INTERFACE" != direct ]]; then
  curl_args+=(--interface "$MIHOMO_UPDATE_INTERFACE")
fi

url="$MIHOMO_PROVIDER_URL"
if [[ -n "$MIHOMO_UPDATE_SUFFIX" ]]; then
  url="${url%/}/${MIHOMO_UPDATE_SUFFIX#/}"
fi
"$CURL_BIN" "${curl_args[@]}" "$url" -o "$tmp"

[[ -s "$tmp" ]] || {
  echo "Downloaded Mihomo provider is empty" >&2
  exit 1
}
grep -Eq '^[[:space:]]*proxies:[[:space:]]*$' "$tmp" || {
  echo "Downloaded subscription is not a Mihomo/Clash profile with proxies" >&2
  exit 1
}

validate_dir="$(mktemp -d)"
trap 'rm -f "$tmp"; rm -rf "$validate_dir"' EXIT
"$MIHOMO_BIN" -t -d "$validate_dir" -f "$tmp" >/dev/null

changed=1
if [[ -r "$MIHOMO_PROVIDER_FILE" ]] && cmp -s "$tmp" "$MIHOMO_PROVIDER_FILE"; then
  changed=0
  echo "MIHOMO_PROVIDER=UNCHANGED"
else
  install -m 600 "$tmp" "$MIHOMO_PROVIDER_FILE"
  echo "MIHOMO_PROVIDER=UPDATED"
fi

if [[ -x "$MIHOMO_PREPARE" ]]; then
  "$MIHOMO_PREPARE"
fi

if (( changed == 1 )) && "$SYSTEMCTL_BIN" is-active --quiet "$MIHOMO_SERVICE" 2>/dev/null; then
  "$SYSTEMCTL_BIN" restart "$MIHOMO_SERVICE"
  echo "MIHOMO_SERVICE=RESTARTED"
fi
