#!/usr/bin/env bash
set -Eeuo pipefail

AWG_ENV_FILE="${AWG_ENV_FILE:-/etc/awg-pbr/env}"
AWG_COMMON_FILE="${AWG_COMMON_FILE:-/usr/local/lib/awg-pi/common.sh}"
# shellcheck disable=SC1090
source "$AWG_ENV_FILE"
# shellcheck disable=SC1090
source "$AWG_COMMON_FILE"

: "${LAN_IF:?LAN_IF is required}"
: "${LAN_CIDR:?LAN_CIDR is required}"
: "${VPN_IF:?VPN_IF is required}"
: "${VPN_MARK:?VPN_MARK is required}"
LOCKDOWN="${AWG_TRANSIT_LOCKDOWN:-0}"
TRANSPORT_ID="$(awg_transport_get)"
TRANSPORT_IF=""
transport_return_rule=""
if awg_transport_backend_valid "$TRANSPORT_ID"; then
  TRANSPORT_IF="$(awg_transport_device "$TRANSPORT_ID")"
  transport_return_rule="    iifname \"$TRANSPORT_IF\" oifname \"$LAN_IF\" ct state established,related accept"
elif [[ "$LOCKDOWN" != 1 ]]; then
  echo "No active transport is configured; only Transit lockdown can be rendered." >&2
  exit 1
fi

forward_rule=""
mark_rule=""
nat_rule=""

case "$LOCKDOWN" in
  0)
    : "${ROUTER_MAC:?ROUTER_MAC is required}"
    if [[ ! "$ROUTER_MAC" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
      echo "Invalid ROUTER_MAC: $ROUTER_MAC" >&2
      exit 2
    fi
    forward_rule="    iifname \"$LAN_IF\" ether saddr $ROUTER_MAC ip saddr @transit4 oifname \"$TRANSPORT_IF\" accept"
    mark_rule="    iifname \"$LAN_IF\" ether saddr $ROUTER_MAC ip saddr @transit4 ip daddr != $LAN_CIDR meta mark set $VPN_MARK"
    nat_rule="    ip saddr @transit4 oifname \"$TRANSPORT_IF\" masquerade"
    ;;
  1)
    # Emergency/boot-safe state: no new forwarded flow is accepted or marked.
    # Input management remains available, but client forwarding is fail-closed.
    ;;
  *)
    echo "Invalid AWG_TRANSIT_LOCKDOWN: $LOCKDOWN" >&2
    exit 2
    ;;
esac

cat <<NFT
# Transit-mode nftables candidate for AWG Pi Gateway v1.3 transport backends.
# This renderer does not apply rules by itself.
table inet awg_pbr {
  set vpn4 {
    type ipv4_addr
    flags timeout
    timeout 15m
  }
  set direct4 {
    type ipv4_addr
    flags timeout
    timeout 15m
  }
  set clients4 {
    type ipv4_addr
  }
  set source4 {
    type ipv4_addr
    flags interval
  }
  set transit4 {
    type ipv4_addr
    flags interval
    elements = { $LAN_CIDR }
  }

  chain input_guard {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    iifname "$LAN_IF" tcp dport 22 accept
    iifname "$LAN_IF" udp dport 53 accept
    iifname "$LAN_IF" tcp dport 53 accept
    iifname "$LAN_IF" ip protocol icmp accept
    iifname "$LAN_IF" meta l4proto ipv6-icmp accept
    iifname "$LAN_IF" udp sport 67 udp dport 68 accept
  }

  chain forward_guard {
    type filter hook forward priority filter; policy drop;

    # Return traffic may leave only from the active transport back toward LAN.
$transport_return_rule

    # Normal Transit accepts only MikroTik-MAC ingress with actual active-transport egress.
    # Lockdown emits no new-flow accept rule.
$forward_rule
  }

  chain prerouting_mark {
    type filter hook prerouting priority mangle; policy accept;

    # Normal Transit marks trusted MikroTik-forwarded Internet traffic.
    # Lockdown emits no mark rule, so no new client flow can enter transport policy.
$mark_rule
  }

  chain dns_redirect {
    type nat hook prerouting priority dstnat; policy accept;
  }

  chain postrouting_nat {
    type nat hook postrouting priority srcnat; policy accept;
$nat_rule
  }
}
NFT
