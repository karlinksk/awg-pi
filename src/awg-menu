      fi
    elif [[ "$current" != mihomo ]]; then
      msg "Профиль Mihomo" "Новый профиль и узел применены. Активный транспорт не изменён; переключение выполняется через «VPN-маршрутизация → Активный транспорт»."
    fi
  else
    msg "Подготовленный профиль Mihomo" "Профиль не применён. Предыдущий рабочий профиль сохранён или восстановлен; подготовленный профиль оставлен для повторной попытки."
  fi
}

