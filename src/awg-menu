restart_active_transport(){
  local transport service label
  transport="$(cat /etc/awg-pbr/transport 2>/dev/null || echo unconfigured)"
  case "$transport" in
    awg)
      service="awg-quick@awg0.service"
      label="AmneziaWG (awg0)"
      ;;
    mihomo)
      service="awg-mihomo.service"
      label="Mihomo"
      ;;
    unconfigured|"")
      msg "VPN" "Активный транспорт пока не настроен.\n\nОткройте «Конфигурация AmneziaWG» либо «Mihomo» → «Подписка / источник». Движки установлены, профили можно добавить позже. Перезапуск не требуется."
      return 0
      ;;
    *)
      msg "VPN" "Неизвестное состояние транспорта: $transport\n\nПерезапуск отменён без изменений."
      return 1
      ;;
  esac

  confirm "Перезапуск" "Перезапустить активный транспорт $label и монитор состояния?" || return 0
  if run_with_progress "Перезапуск $label" systemctl restart "$service"; then
    if run_with_progress "Перезапуск монитора состояния" systemctl restart awg-pbr-health.service; then
      msg "VPN" "$label и монитор состояния перезапущены."
