#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

# Run from a temporary copy so a gateway update can safely replace awg-menu.
if [[ "${AWG_MENU_REEXEC:-0}" != 1 ]]; then
  _menu_tmp="$(mktemp /tmp/awg-menu.XXXXXX)"
  cp "$0" "$_menu_tmp"
  chmod 700 "$_menu_tmp"
  export AWG_MENU_REEXEC=1
  exec "$_menu_tmp" "$@"
fi
command -v dialog >/dev/null 2>&1 || { echo "Не найден dialog" >&2; exit 1; }

AWG_ROUTE=/usr/local/sbin/awg-route
AWG_TRANSPORT=/usr/local/sbin/awg-transport
MIHOMO_CONFIGURE=/usr/local/sbin/awg-mihomo-configure
MIHOMO_INSTALLER=/usr/local/sbin/awg-mihomo-install
MIHOMO_NODE_POLICY=/usr/local/sbin/awg-mihomo-node-policy
AWG_FIRST_RUN=/usr/local/sbin/awg-first-run
AWG_SELECTION=/usr/local/sbin/awg-selection
AWG_UPDATE=/usr/local/sbin/awg-update
AWG_TRAFFIC=/usr/local/sbin/awg-traffic
VERSION="$(cat /etc/awg-pbr/version 2>/dev/null || echo unknown)"
BASE_BACKTITLE="AWG Pi Gateway v$VERSION"
BACKTITLE="$BASE_BACKTITLE"
TMP="$(mktemp)"
PASTE_TMP=""
SELF_TMP=""
if [[ "${AWG_MENU_REEXEC:-0}" == 1 && "$0" == /tmp/awg-menu.* ]]; then
  SELF_TMP="$0"
fi
cleanup(){
  [[ -z "$PASTE_TMP" ]] || rm -f "$PASTE_TMP" 2>/dev/null || true
  rm -f "$TMP" 2>/dev/null || true
  [[ -z "$SELF_TMP" ]] || rm -f "$SELF_TMP" 2>/dev/null || true
}
trap cleanup EXIT

# shellcheck disable=SC1091
[[ -r /etc/awg-pbr/env ]] && source /etc/awg-pbr/env

operating_mode_id(){
  cat /etc/awg-pbr/mode 2>/dev/null || echo selective
}

operating_mode_badge(){
  case "${1:-$(operating_mode_id)}" in
    selective) printf '%s\n' "SELECTIVE" ;;
    transit) printf '%s\n' "TRANSIT" ;;
    *) printf '%s\n' "INVALID" ;;
  esac
}

operating_mode_label(){
  case "${1:-$(operating_mode_id)}" in
    selective) printf '%s\n' "Selective Gateway" ;;
    transit) printf '%s\n' "MikroTik Transit / Backup VPN" ;;
    *) printf '%s\n' "INVALID / unknown" ;;
  esac
}

refresh_backtitle(){
  local mode
  mode="$(operating_mode_id)"
  BACKTITLE="$BASE_BACKTITLE | Режим: $(operating_mode_badge "$mode")"
}

refresh_backtitle

msg(){
  dialog --backtitle "$BACKTITLE" --title "$1" --msgbox "$2" 20 90
}

confirm(){
  dialog --backtitle "$BACKTITLE" --title "$1" --yesno "$2" 10 75
}

input(){
  local title="$1" prompt="$2" initial="${3:-}"
  dialog --backtitle "$BACKTITLE" --title "$title" --inputbox "$prompt" 10 80 "$initial" 3>&1 1>&2 2>&3
}

secret_input(){
  local title="$1" prompt="$2"
  dialog --backtitle "$BACKTITLE" --title "$title" --passwordbox "$prompt" 11 90 3>&1 1>&2 2>&3
}

capture(){
  local rc
  set +e
  "$@" >"$TMP" 2>&1
  rc=$?
  set -e
  dialog --backtitle "$BACKTITLE" --title "${title:-Результат}" --textbox "$TMP" 30 110
  return "$rc"
}

run_interactive(){
  local heading="$1"
  shift
  clear
  printf '=== %s ===\n\n' "$heading"
  set +e
  "$@"
  local rc=$?
  set -e
  echo
  case "$rc" in
    0) echo "Операция завершена." ;;
    20) echo "Операция отменена пользователем." ;;
    *) echo "Операция завершилась с ошибкой (код $rc)." ;;
  esac
  read -r -p "Нажмите Enter для возврата в меню..." _
  return 0
}

current_timezone(){
  timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || echo unknown
}

system_uptime(){
  awk '{s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60);
        if (d>0) printf "%dd %02dh %02dm",d,h,m; else printf "%02dh %02dm",h,m}' /proc/uptime 2>/dev/null || echo n/a
}

cpu_temperature(){
  local path value
  for path in /sys/class/thermal/thermal_zone*/temp; do
    [[ -r "$path" ]] || continue
    value="$(cat "$path" 2>/dev/null || true)"
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    awk -v t="$value" 'BEGIN{printf "%.1f°C",t/1000}'
    return 0
  done
  printf '%s' 'n/a'
}

memory_summary(){
  awk '/^MemTotal:/{t=$2}/^MemAvailable:/{a=$2}END{
    if(t>0){u=t-a; printf "%.0f/%.0f MiB (%.0f%%)",u/1024,t/1024,(u*100)/t}else printf "n/a"
  }' /proc/meminfo 2>/dev/null
}

disk_summary(){
  df -hP / 2>/dev/null | awk 'NR==2{printf "%s/%s (%s)",$3,$2,$5}'
}

quick_summary(){
  local health policy dns awg_state hs oc pi router mode mode_label mode_badge transport
  local now tz temp uptime load mem disk traffic
  health="$(cat /run/awg-pbr/health.state 2>/dev/null || echo unknown)"
  mode="$(operating_mode_id)"
  mode_label="$(operating_mode_label "$mode")"
  mode_badge="$(operating_mode_badge "$mode")"
  transport="$("$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured)"
  if ip -4 rule show 2>/dev/null | grep -Eq '(^| )100:.*fwmark (0x100|256).*lookup (100|awgvpn)'; then
    policy=ACTIVE
  elif [[ "$mode" == transit ]]; then
    policy=CLOSED
  else
    policy=DIRECT
  fi
  systemctl is-active --quiet dnsmasq.service && dns=OK || dns=FAIL
  systemctl is-active --quiet awg-quick@awg0.service && awg_state=UP || awg_state=DOWN
  hs="$(awg show awg0 latest-handshakes 2>/dev/null | awk '$2>m{m=$2}END{print m+0}')"
  if [[ "$hs" -gt 0 ]]; then
    hs="$(( $(date +%s) - hs ))s"
  else
    hs=none
  fi
  systemctl is-active --quiet awg-opencck-update.timer && oc=OK || oc=OFF
  pi="${PI_IP:-?}"
  router="${ROUTER_IP:-?}"
  now="$(date '+%Y-%m-%d %H:%M:%S')"
  tz="$(current_timezone)"
  temp="$(cpu_temperature)"
  uptime="$(system_uptime)"
  load="$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null || echo n/a)"
  mem="$(memory_summary)"
  disk="$(disk_summary)"
  traffic="$("$AWG_TRAFFIC" status compact 2>/dev/null || echo 'Today: n/a | Month: n/a')"
  printf 'ВРЕМЯ: %s | TZ: %s\nСИСТЕМА: Uptime %s | CPU %s | Load %s\nПАМЯТЬ: %s | Disk /: %s\nРЕЖИМ: [%s] %s | Transport: %s\nVPN health: %-7s Policy: %-7s DNS: %-4s | awg0: %-4s HS: %-8s OpenCCK: %s\nTRAFFIC: %s\nPi: %-15s Router: %s' \
    "$now" "$tz" "$uptime" "$temp" "$load" "$mem" "$disk" \
    "$mode_badge" "$mode_label" "$transport" "$health" "$policy" "$dns" "$awg_state" "$hs" "$oc" "$traffic" "$pi" "$router"
}

status_screen(){
  title="Состояние системы"
  capture "$AWG_ROUTE" status || true
}

diagnostics_screen(){
  title="Диагностика"
  capture "$AWG_ROUTE" diagnostics || true
}

logs_screen(){
  title="Журналы"
  capture "$AWG_ROUTE" logs 200 || true
}

domain_menu(){
  local kind="$1" label="$2" choice d path
  while true; do
    choice="$(dialog --backtitle "$BACKTITLE" --title "$label" --item-help --menu \
      "Выберите действие. Подсказка для выделенного пункта показана внизу." 23 96 10 \
      1 "Показать списки" "Показывает ручные VPN/DIRECT-списки и связанные источники; ничего не меняет." \
      2 "Добавить домен" "Добавляет домен в этот список. Запись example.com применяется и к его поддоменам." \
      3 "Удалить домен" "Удаляет домен только из выбранного ручного списка и пересобирает правила." \
      4 "Импортировать файл (добавить)" "Добавляет валидные домены из файла к существующим, не удаляя текущие записи." \
      5 "Импортировать файл (полностью заменить)" "Полностью заменяет выбранный ручной список содержимым файла после проверки." \
      6 "Экспортировать файл" "Сохраняет текущий ручной список в указанный файл с правами только для root." \
      0 "Назад" "Возвращает в главное меню без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="$label"
        capture "$AWG_ROUTE" list || true
        ;;
      2)
        d="$(input "$label" "Введите домен:")" || continue
        title="Добавление"
        capture "$AWG_ROUTE" "$kind" add "$d" || true
        ;;
      3)
        d="$(input "$label" "Введите домен для удаления:")" || continue
        title="Удаление"
        capture "$AWG_ROUTE" "$kind" del "$d" || true
        ;;
      4)
        path="$(input "$label" "Полный путь к файлу:")" || continue
        title="Импорт"
        capture "$AWG_ROUTE" "$kind" import "$path" || true
        ;;
      5)
        path="$(input "$label" "Полный путь к файлу:")" || continue
        confirm "Подтверждение" "Текущий список $label будет полностью заменён. Продолжить?" || continue
        title="Импорт --replace"
        capture "$AWG_ROUTE" "$kind" import --replace "$path" || true
        ;;
      6)
        path="$(input "$label" "Полный путь для сохранения файла:")" || continue
        title="Экспорт"
        capture "$AWG_ROUTE" "$kind" export "$path" || true
        ;;
      0) return 0 ;;
    esac
  done
}

vpn_destination_menu(){
  local choice target method
  while true; do
    choice="$(dialog --backtitle "$BACKTITLE" --title "VPN-сервисы / домены" --item-help --menu \
      "Единая точка добавления Selective VPN-направлений: ручной домен или OpenCCK source. Имя вводится один раз." 23 104 9 \
      1 "Показать всё" "Показывает ручные VPN/DIRECT домены, OpenCCK sources и client allow-list." \
      2 "Добавить VPN-направление" "Введите имя один раз, затем выберите: ручной домен, OpenCCK group или OpenCCK site." \
      3 "Удалить ручной VPN-домен" "Удаляет только запись из ручного VPN domain list." \
      4 "Ручные VPN-домены — расширенно" "Импорт/экспорт/replace и другие операции с ручным domain list." \
      5 "OpenCCK — расширенно" "Полное управление OpenCCK sources, cache, enable/disable/update." \
      0 "Назад" "Возвращает в главное меню." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="VPN назначения"
        capture "$AWG_ROUTE" list || true
        ;;
      2)
        target="$(input "VPN-направление" "Введите домен, имя OpenCCK group или site ОДИН раз:")" || continue
        [[ -n "$target" ]] || continue
        method="$(dialog --backtitle "$BACKTITLE" --title "Источник VPN-направления" --item-help --menu \
          "Значение: $target" 18 100 5 \
          manual "Ручной VPN-домен" "Добавляет domain в локальный VPN list; подходит для точного домена и его поддоменов." \
          group "OpenCCK group" "Добавляет OpenCCK group с type=domains и сразу загружает cache." \
          site "OpenCCK site" "Добавляет OpenCCK site с type=domains и сразу загружает cache." \
          0 "Назад" "Ничего не добавлять." 3>&1 1>&2 2>&3)" || continue
        case "$method" in
          manual)
            title="Добавление VPN-домена"
            capture "$AWG_ROUTE" vpn add "$target" || true
            ;;
          group|site)
            title="Добавление OpenCCK → VPN"
            capture "$AWG_ROUTE" source add opencck "$target" --type domains --kind "$method" || true
            ;;
          0) ;;
        esac
        ;;
      3)
        target="$(input "VPN-домен" "Введите домен для удаления из ручного списка:")" || continue
        [[ -n "$target" ]] || continue
        title="Удаление VPN-домена"
        capture "$AWG_ROUTE" vpn del "$target" || true
        ;;
      4) domain_menu vpn "Домены VPN" ;;
      5) opencck_menu ;;
      0) return 0 ;;
    esac
  done
}

opencck_menu(){
  local choice name type kind action
  while true; do
    choice="$(dialog --backtitle "$BACKTITLE" --title "OpenCCK" --item-help --menu \
      "Управление внешними списками OpenCCK. Подсказка для выделенного пункта показана внизу." 26 100 13 \
      1 "Показать источники" "Показывает имя, тип, состояние, число записей и время последнего успешного обновления." \
      2 "Добавить источник" "Добавляет группу или сайт OpenCCK, загружает данные и включает источник только после успешной первой загрузки." \
      3 "Показать содержимое источника" "Показывает закэшированные домены/IP/CIDR выбранного источника; правила не меняются." \
      4 "Обновить все источники" "Загружает свежие данные для всех настроенных источников OpenCCK." \
      5 "Обновить один источник" "Обновляет только выбранный источник, не затрагивая остальные." \
      6 "Включить источник" "Включает источник в Selective-классификацию; при необходимости сначала обновляет его кэш." \
      7 "Отключить источник" "Исключает источник из активной Selective-классификации, сохраняя его настройки и кэш." \
      8 "Удалить источник" "Удаляет настройки и локальный кэш выбранного источника OpenCCK." \
      0 "Назад" "Возвращает в главное меню без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="OpenCCK sources"
        capture "$AWG_ROUTE" source list || true
        ;;
      2)
        name="$(input "OpenCCK" "Имя группы или сайта (например youtube или youtube.com):")" || continue
        type="$(dialog --backtitle "$BACKTITLE" --title "Тип данных" --item-help --menu "Выберите тип данных OpenCCK" 17 88 4 \
          domains "Домены (рекомендуется)" "Маршрутизация по доменным именам через dnsmasq/nftset; обычно лучший выбор для сайтов и сервисов." \
          ip4 "IPv4-адреса" "Загружает отдельные IPv4-адреса непосредственно в nftables." \
          cidr4 "IPv4-подсети CIDR" "Загружает IPv4-подсети CIDR непосредственно в nftables." 3>&1 1>&2 2>&3)" || continue
        kind="$(dialog --backtitle "$BACKTITLE" --title "Тип источника" --item-help --menu "Как трактовать введённое имя?" 16 88 3 \
          group "Группа OpenCCK" "Ищет именованную группу OpenCCK, например youtube, и использует её набор данных." \
          site "Конкретный сайт/портал" "Ищет данные OpenCCK для конкретного сайта или домена, например youtube.com." 3>&1 1>&2 2>&3)" || continue
        title="Добавление OpenCCK"
        capture "$AWG_ROUTE" source add opencck "$name" --type "$type" --kind "$kind" || true
        ;;
      3)
        name="$(input "OpenCCK" "Имя источника:")" || continue
        title="OpenCCK: $name"
        capture "$AWG_ROUTE" source show opencck "$name" || true
        ;;
      4)
        title="OpenCCK update"
        capture "$AWG_ROUTE" source update || true
        ;;
      5)
        name="$(input "OpenCCK" "Имя источника:")" || continue
        title="OpenCCK update"
        capture "$AWG_ROUTE" source update "$name" || true
        ;;
      6|7|8)
        name="$(input "OpenCCK" "Имя источника:")" || continue
        action=enable
        [[ "$choice" == 7 ]] && action=disable
        [[ "$choice" == 8 ]] && action=del
        if [[ "$action" == del ]]; then
          confirm "Удаление" "Удалить источник $name?" || continue
        fi
        title="OpenCCK $action"
        capture "$AWG_ROUTE" source "$action" opencck "$name" || true
        ;;
      0) return 0 ;;
    esac
  done
}

