      10 "Формат подписки" "AUTO по умолчанию; вручную можно зафиксировать Mihomo YAML, VLESS URI или Base64 VLESS. Изменение транзакционное." \
      0 "Назад" "Возвращает в меню VPN без изменений." 3>&1 1>&2 2>&3)" || return 0

    case "$choice" in
      1)
        title="Mihomo status"
        capture "$MIHOMO_CONFIGURE" status || true
        ;;
      2)
        url="$(secret_input "Mihomo subscription" "Вставьте полный URL подписки.\n\nСсылка не будет показана в итоговом статусе.")" || continue
        [[ -n "$url" ]] || { msg "Mihomo" "Пустая ссылка не применена."; continue; }
        if ! confirm "Mihomo subscription" "Скачать и проверить профиль по новой ссылке через AUTO bootstrap?\n\nПри ошибке текущая ссылка и provider cache останутся без изменений."; then
          unset url
          continue
        fi
        install -d -m 700 /run/awg-pbr
        url_tmp="$(mktemp /run/awg-pbr/mihomo-url.XXXXXX)"
        chmod 600 "$url_tmp"
        printf 'MIHOMO_PROVIDER_URL=%q\n' "$url" >"$url_tmp"
        unset url
        run_interactive "Обновление ссылки Mihomo" "$MIHOMO_CONFIGURE" provider-url set-file "$url_tmp"
        rm -f "$url_tmp"
        url_tmp=""
        ;;
      3)
        run_interactive "Mihomo provider update — AUTO" "$MIHOMO_CONFIGURE" provider update auto
        ;;
      4)
        fetch_mode="$(dialog --backtitle "$BACKTITLE" --title "Bootstrap-канал" --item-help --menu \
          "Выберите путь только для этой загрузки subscription." 20 100 6 \
          mihomo "Текущий Mihomo" "HTTP-запрос идёт через локальный Mihomo proxy 127.0.0.1; работает только если текущий профиль жив." \
          awg "AmneziaWG" "Запрос привязывается к awg0; используется как независимый bootstrap/fallback." \
          router "Router/default" "Обычный путь Pi → MikroTik. Уже MikroTik решает: DIRECT, SSTP или другой router-side VPN." \
          0 "Назад" "Не выполнять обновление." 3>&1 1>&2 2>&3)" || continue
        [[ "$fetch_mode" != 0 ]] || continue
        run_interactive "Mihomo provider update — $fetch_mode" "$MIHOMO_CONFIGURE" provider update "$fetch_mode"
        ;;
      5)
        path="$(input "Mihomo provider" "Полный путь к локальному provider-файлу (Mihomo YAML / VLESS URI / Base64 VLESS):")" || continue
        confirm "Импорт профиля" "Проверить и импортировать локальный профиль?\n\nРабочий cache будет заменён только после успешной проверки." || continue
        run_interactive "Импорт Mihomo provider" "$MIHOMO_CONFIGURE" provider import "$path"
        ;;
      6) mihomo_node_menu ;;
      7)
        confirm "Transport → Mihomo" "Переключить datapath на Mihomo?\n\nСначала выполняются health/preflight. При ошибке останется текущий транспорт." || continue
        run_interactive "Переключение на Mihomo" "$AWG_TRANSPORT" select mihomo
        ;;
      8)
        confirm "Transport → AmneziaWG" "Вернуть datapath на AmneziaWG?\n\nПереключение транзакционное." || continue
        run_interactive "Переключение на AmneziaWG" "$AWG_TRANSPORT" select awg
        ;;
      9)
        profile="$(dialog --backtitle "$BACKTITLE" --title "Тип subscription" --item-help --menu \
          "Выберите профиль первичной настройки." 19 104 5 \
          standard "Обычная Mihomo/Clash subscription" "URL используется как есть; HWID не добавляется." \
          remnawave "Citadel / Remnawave" "Создаётся один стабильный HWID и используется /mihomo profile. HWID сохраняется и не показывается." \
          0 "Назад" "Не выполнять первичную настройку." 3>&1 1>&2 2>&3)" || continue
        [[ "$profile" != 0 ]] || continue
        provider_format="$(mihomo_provider_format_dialog)" || continue
        [[ "$provider_format" != 0 ]] || continue
        url="$(secret_input "Первичная настройка Mihomo" "Вставьте полный URL subscription.\n\nДля Citadel/Remnawave можно вставить базовую ссылку: /mihomo будет добавлен автоматически.")" || continue
        [[ -n "$url" ]] || { msg "Mihomo" "Пустая ссылка не применена."; continue; }

        install -d -m 700 /run/awg-pbr
        init_tmp="$(mktemp /run/awg-pbr/mihomo-init.XXXXXX)"
        chmod 600 "$init_tmp"
        {
          printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
          printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
          printf 'MIHOMO_PROVIDER_FORMAT=%q\n' "$provider_format"
        } >"$init_tmp"
        unset url

        title="Первичная настройка Mihomo"
        if capture "$MIHOMO_CONFIGURE" init "$init_tmp"; then
          rm -f "$init_tmp"
          init_tmp=""
          if confirm "Mihomo provider готов" "Provider cache успешно загружен и проверен. Перейти к выбору точки выхода?"; then
            mihomo_node_menu
          fi
        else
          rm -f "$init_tmp"
          init_tmp=""
        fi
        ;;
      10)
        provider_format="$(mihomo_provider_format_dialog)" || continue
        [[ "$provider_format" != 0 ]] || continue
        confirm "Формат subscription" "Проверить текущую subscription в формате '$provider_format' и применить его только при успешной нормализации?" || continue
        run_interactive "Формат Mihomo provider" "$MIHOMO_CONFIGURE" provider format set "$provider_format"
        ;;
      0) return 0 ;;
    esac
  done
}

vpn_menu(){
