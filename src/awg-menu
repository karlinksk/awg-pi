run_interactive(){
  local heading="$1"
  shift
  # --msgbox has no Cancel button and Esc returns nonzero; under set -e
  # that used to terminate the entire menu. Confirm explicitly, treating
  # Cancel and Esc as a return to the calling submenu without side effects.
  if ! dialog --backtitle "$BACKTITLE" --title "Переход в SSH-терминал" \
       --yes-label "ОК" --no-label "Отмена" \
       --yesno "Для операции «$heading» откроется текстовый интерфейс SSH.\n\nВыполняйте подсказки на экране. После завершения нажмите Enter — меню восстановится автоматически." 20 90; then
    return 0
  fi
  clear
  printf '=== %s ===\n\n' "$heading"
  printf 'Операция запущена. Сообщения и запросы появятся ниже.\n'
  printf 'Если отдельный этап выполняется без вывода, дождитесь его завершения — процесс не завис.\n\n'
  set +e
  "$@"
  local rc=$?
  set -e
  echo
  case "$rc" in
    0) echo "Операция завершена." ;;
    20) echo "Операция отменена пользователем." ;;
    *) echo "Операция завершилась с ошибкой (код $rc)." ;;
  esac
  read -r -p "Нажмите Enter для возврата в меню..." _
  return 0
}

current_timezone(){
  timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || echo неизвестно
}

system_uptime(){
  awk '{s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60);
        if (d>0) printf "%dд %02dч %02dм",d,h,m; else printf "%02dч %02dм",h,m}' /proc/uptime 2>/dev/null || echo н/д
}

cpu_temperature(){
  local path value
  for path in /sys/class/thermal/thermal_zone*/temp; do
    [[ -r "$path" ]] || continue
    value="$(cat "$path" 2>/dev/null || true)"
    [[ "$value" =~ ^[0-9]+$ ]] || continue
    awk -v t="$value" 'BEGIN{printf "%.1f°C",t/1000}'
    return 0
  done
  printf '%s' 'н/д'
}

memory_summary(){
  awk '/^MemTotal:/{t=$2}/^MemAvailable:/{a=$2}END{
    if(t>0){u=t-a; printf "%.0f/%.0f MiB (%.0f%%)",u/1024,t/1024,(u*100)/t}else printf "н/д"
  }' /proc/meminfo 2>/dev/null
}

disk_summary(){
  df -hP / 2>/dev/null | awk 'NR==2{printf "%s/%s (%s)",$3,$2,$5}'
}

# State is derived from installation + profile + service separately.
# A missing profile on fresh install is not a failed VPN.
hot_pool_summary(){
  if [[ ! -x /usr/local/sbin/awg-mihomo-hot-pool ]]; then
    printf 'не установлен'
  elif [[ ! -s /var/lib/awg-pbr/mihomo/providers/subscription.yaml ]]; then
    printf 'ожидает подписку'
  elif ! systemctl is-active --quiet awg-mihomo-hot-pool.timer; then
    printf 'автопроверка выключена'
  else
    # This installation uses the continuity union provider/pool/state for
    # SHADOW checks. The legacy CLI defaults to an independent shadow.json
    # (possibly missing), which can falsely report READY 0/4 in this menu.
    # Detect continuity by its installed wrapper; keep older installs working.
    local info ready target union_dir
    local -a status_args=(status)
    if [[ -x /usr/local/sbin/awg-mihomo-hot-continuity-run ]]; then
      union_dir=/run/awg-pbr/hot-pool/continuity
      if [[ ! -s "$union_dir/provider.yaml" || ! -s "$union_dir/pool.json" ||
            ! -s "$union_dir/state.json" ]]; then
        printf 'ожидает проверки'
        return
      fi
      status_args=(--provider "$union_dir/provider.yaml"
                   --pool "$union_dir/pool.json"
                   --state "$union_dir/state.json" status)
    fi
    info="$(timeout 3 /usr/local/sbin/awg-mihomo-hot-pool "${status_args[@]}" 2>/dev/null)" || {
      printf 'не проверено'
      return
    }
    ready="$(sed -n 's/^HOT_POOL_READY=//p' <<<"$info" | head -n1)"
    target="$(sed -n 's/^HOT_POOL_TARGET_READY=//p' <<<"$info" | head -n1)"
    if [[ "$ready" =~ ^[0-9]+$ && "$target" =~ ^[1-9][0-9]*$ ]]; then
      printf 'READY %s/%s' "$ready" "$target"
    else
      printf 'ожидает проверки'
    fi
  fi
}

quick_summary(){
  local health policy dns awg_state mihomo_state hs oc pi router mode mode_label mode_badge transport
  local now tz temp uptime load mem disk traffic
  health="$(cat /run/awg-pbr/health.state 2>/dev/null || echo unknown)"
  mode="$(operating_mode_id)"
  mode_label="$(operating_mode_label "$mode")"
  mode_badge="$(operating_mode_badge "$mode")"
  transport="$("$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured)"
  case "$transport" in
    awg) transport="AWG" ;;
    mihomo) transport="Mihomo" ;;
    unconfigured) transport="не настроен" ;;
  esac
  if [[ "$transport" == "не настроен" ]]; then
    health="ожидает настройки"
  else
    case "$health" in
      up) health="норма" ;;
      down) health="ошибка соединения" ;;
      unknown|неизвестно) health="не проверено" ;;
    esac
  fi
  if ip -4 rule show 2>/dev/null | grep -Eq '(^| )100:.*fwmark (0x100|256).*lookup (100|awgvpn)'; then
    policy="активна"
  elif [[ "$mode" == transit ]]; then
    policy="блокировка (FAIL-CLOSED)"
  else
    policy="DIRECT (FAIL-OPEN)"
  fi
  if systemctl is-active --quiet dnsmasq.service; then dns="работает"; else dns="не запущен"; fi
  if ! command -v awg >/dev/null 2>&1; then
    awg_state="не установлено"
    hs="—"
  elif [[ ! -s /etc/amnezia/amneziawg/awg0.conf ]]; then
    awg_state="не настроено"
    hs="—"
  else
    if systemctl is-active --quiet awg-quick@awg0.service; then
      awg_state="служба запущена"
    else
      awg_state="не запущен"
    fi
    hs="$(awg show awg0 latest-handshakes 2>/dev/null | awk '$2>m{m=$2}END{print m+0}')"
    if [[ "$hs" -gt 0 ]]; then hs="$(( $(date +%s) - hs )) с"; else hs="нет"; fi
  fi
  if [[ ! -x /usr/local/bin/mihomo ]]; then
    mihomo_state="не установлено"
  elif [[ ! -s /etc/awg-pbr/transports/mihomo/node-name ]]; then
    mihomo_state="не настроено"
  elif systemctl is-active --quiet awg-mihomo.service; then
    mihomo_state="служба запущена"
  elif [[ "$transport" == AWG ]]; then
    mihomo_state="резерв, не запущен"
  else
    mihomo_state="не запущен"
  fi
  systemctl is-active --quiet awg-opencck-update.timer && oc="автообновление включено" || oc="автообновление выключено"
  pi="${PI_IP:-?}"
  router="${ROUTER_IP:-?}"
  now="$(date '+%Y-%m-%d %H:%M:%S')"
  tz="$(current_timezone)"
  temp="$(cpu_temperature)"
  uptime="$(system_uptime)"
  load="$(awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null || echo н/д)"
  mem="$(memory_summary)"
  disk="$(disk_summary)"
  traffic="$("$AWG_TRAFFIC" status compact 2>/dev/null || echo 'Сегодня: н/д | Месяц: н/д')"
  printf 'ВРЕМЯ: %s | ПОЯС: %s\nСИСТЕМА: %s | CPU %s | Нагрузка %s\nПАМЯТЬ: %s | Диск /: %s\nРЕЖИМ: [%s] %s\nVPN: %s | Транспорт: %s\nПолитика: %s | DNS: %s\nAWG: %s | Рукопожатие: %s\nMihomo: %s | OpenCCK: %s\nТРАФИК: %s\nPi: %s | Роутер: %s' \
    "$now" "$tz" "$uptime" "$temp" "$load" "$mem" "$disk" \
    "$mode_badge" "$mode_label" "$health" "$transport" "$policy" "$dns" \
    "$awg_state" "$hs" "$mihomo_state" "$oc" "$traffic" "$pi" "$router"
}

