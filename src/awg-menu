      0 "Назад" "Не менять часовой пояс." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        msg "Часовой пояс" "Timezone: $current\nLocal time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        ;;
      2)
        title="Доступные timezone"
        capture timedatectl list-timezones || true
        ;;
      3)
        zone="$(input "Часовой пояс" "Введите точное IANA имя timezone:" "$current")" || continue
        [[ -n "$zone" ]] || continue
        if ! timedatectl list-timezones 2>/dev/null | grep -Fxq -- "$zone"; then
          msg "Часовой пояс" "Неизвестный timezone: $zone"
          continue
        fi
        confirm "Часовой пояс" "Изменить timezone:\n$current → $zone ?" || continue
        if timedatectl set-timezone "$zone"; then
          msg "Часовой пояс" "Timezone установлен: $zone\nLocal time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        else
          msg "Часовой пояс" "Не удалось изменить timezone."
        fi
        ;;
      0) return 0 ;;
    esac
  done
}

