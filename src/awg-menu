      if confirm "Активировать Mihomo?" "Новый provider/node healthy. Сделать Mihomo активным transport сейчас?"; then
        title="Transport → Mihomo"
        capture "$AWG_TRANSPORT" select mihomo || true
      fi
    fi
  else
    msg "Mihomo candidate" "Commit не выполнен. Предыдущий live provider сохранён/восстановлен; staged candidate оставлен."
  fi
