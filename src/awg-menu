  info_tmp="$(mktemp)"
  if ! "$MIHOMO_CONFIGURE" provider candidate prepare "$node_name" >"$info_tmp" 2>&1; then
    dialog --backtitle "$BACKTITLE" --title "Candidate node" --textbox "$info_tmp" 24 108
    rm -f "$info_tmp"
    return 0
  fi
  dialog --backtitle "$BACKTITLE" --title "Candidate node" --textbox "$info_tmp" 24 108
  endpoint="$(input "Candidate endpoint" "Введите один IPv4 из Resolved IPv4 endpoints:")" || {
    rm -f "$info_tmp"
    return 0
  }
  rm -f "$info_tmp"
  [[ -n "$endpoint" ]] || return 0

  confirm "Commit staged provider?" "Live provider и текущий node будут заменены только после успешного запуска и health-check candidate. При ошибке live автоматически восстановится, а candidate останется для повторной попытки." || return 0

  current="$("$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured)"
