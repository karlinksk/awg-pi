current_mihomo_provider_url(){
  local MIHOMO_PROVIDER_URL=""
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    # Root-owned application state; sourced here only to prefill the setup field.
    # shellcheck disable=SC1090
    source "$MIHOMO_ENV_FILE"
  fi
  printf '%s\n' "${MIHOMO_PROVIDER_URL:-}"
}

current_mihomo_provider_profile(){
  local MIHOMO_PROVIDER_PROFILE="standard"
  if [[ -r "$MIHOMO_ENV_FILE" ]]; then
    # Root-owned application state; sourced only to label the current source type.
    # shellcheck disable=SC1090
    source "$MIHOMO_ENV_FILE"
  fi
  case "${MIHOMO_PROVIDER_PROFILE:-standard}" in
    standard|remnawave) printf '%s\n' "${MIHOMO_PROVIDER_PROFILE:-standard}" ;;
    *) printf '%s\n' standard ;;
  esac
}

awg_option_label(){
  # Mark only a persisted, known choice; never mark an action or a cursor row.
  local label="$1" option="$2" selected="${3:-}"
  if [[ -n "$selected" && "$option" == "$selected" ]]; then
    printf '%s ✓' "$label"
  else
    printf '%s' "$label"
  fi
}
mihomo_source_profile_dialog(){
  local choice current="${1:-}" standard_label="Обычная подписка Mihomo/Clash" remnawave_label="Citadel / Remnawave"
  standard_label="$(awg_option_label "$standard_label" standard "$current")"
  remnawave_label="$(awg_option_label "$remnawave_label" remnawave "$current")"
  choice="$(dialog --backtitle "$BACKTITLE" --title "Тип подписки" --item-help --menu \
    "Выберите тип нового источника. Это важно при переходе между Citadel/Remnawave и обычной подпиской." 20 108 5 \
    1 "$standard_label" "URL используется как есть; HWID и служебный суффикс /mihomo не добавляются." \
    2 "$remnawave_label" "Используется постоянный HWID; к базовой ссылке при необходимости добавляется /mihomo." \
    0 "Назад" "Не менять источник." 3>&1 1>&2 2>&3)" || return 1
  case "$choice" in
    1) printf '%s\n' standard ;;
    2) printf '%s\n' remnawave ;;
    0) printf '%s\n' 0 ;;
    *) return 1 ;;
  esac
}

run_with_progress(){
  local heading="$1"
  shift
  local pid rc elapsed=0 dots tick=0 marker kind pair current total percent phase details
  : >"$TMP"

  set +e
  "$@" >"$TMP" 2>&1 &
  pid=$!
  set -e

  # Fast operations should not flash a progress window. After ~0.4 s the user
  # gets a live heartbeat until the command really exits.
  for _ in 1 2; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done

  while kill -0 "$pid" 2>/dev/null; do
    case $((tick % 4)) in
      0) dots="" ;;
      1) dots="." ;;
      2) dots=".." ;;
      3) dots="..." ;;
    esac

    marker="$(grep -E 'MIHOMO_POOL_(READY|HEALTH_PROGRESS|GEO_PROGRESS)=[0-9]+/[0-9]+' "$TMP" 2>/dev/null | tail -n1 || true)"
    details=""
    if [[ "$marker" =~ ^MIHOMO_POOL_([A-Z_]+)=([0-9]+)/([0-9]+)$ ]]; then
      kind="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      total="${BASH_REMATCH[3]}"
      percent=0
      if (( 10#$total > 0 )); then
        percent=$(( 10#$current * 100 / 10#$total ))
      fi
      case "$kind" in
        READY) phase="Загрузка узлов в проверочный Mihomo" ;;
        HEALTH_PROGRESS) phase="Проверка доступности узлов" ;;
        GEO_PROGRESS) phase="Определение фактической страны выхода" ;;
        *) phase="Проверка узлов Mihomo" ;;
      esac
      details="\n\nЭтап: $phase\nПрогресс: $current из $total ($percent%)"
    fi

    dialog --backtitle "$BACKTITLE" --title "$heading" --infobox \
      "Выполняется$dots$details\n\nПрошло: ${elapsed} с\n\nПожалуйста, дождитесь завершения. SSH-сессию не закрывайте." \
      14 88 || true
    sleep 1
    elapsed=$((elapsed + 1))
    tick=$((tick + 1))
  done

  set +e
  wait "$pid"
  rc=$?
  set -e
  return "$rc"
}

# The SSH client may apply its own bright-green word highlighting to
# literal OK/yes. Native ncurses renders them black-on-cyan, but some
# clients override those tokens. Normalize only a temporary UI copy.
awg_readable_status_text(){
  sed -E \
    -e 's/(^|[[:space:]:=])OK($|[[:space:]])/\1ИСПРАВНО\2/g' \
    -e 's/(:[[:space:]]*|=[[:space:]]*)yes($|[[:space:]])/\1ДА\2/g' "$1"
}

show_operation_result(){
  local rc="$1" heading="$2" label view_tmp dialog_rc=0
  if ((rc == 0)); then label="ВЫПОЛНЕНО"; else label="ОШИБКА (код $rc)"; fi
  [[ -s "$TMP" ]] || printf '%s\n' "Дополнительных сообщений нет." >"$TMP"
  # Present an actionable human explanation before the retained diagnostics.
  # Never interpret a failed operation as success solely from its exit code.
  if ((rc != 0)); then
    local explanation
    if grep -Eq 'XRAY_MANUAL_ERROR=MANAGEMENT_OR_MIHOMO_UNHEALTHY|XRAY_MANUAL_ERROR=ACTIVE_TRANSPORT_NOT_MIHOMO' "$TMP"; then
      explanation="Ручной выбор ноды требует активного и исправного Mihomo. Откройте раздел VPN, выберите транспорт Mihomo и повторите операцию. Действующий VPN не изменён."
    elif grep -Eq 'XRAY_MANUAL_ERROR=FOREIGN_TRANSPORT_DURING_RECOVERY' "$TMP"; then
      explanation="Во время восстановления транспорт уже изменился. Для безопасности рабочий VPN оставлен без изменений. Проверьте активный транспорт в главном меню."
    elif grep -Eq 'XRAY_MANUAL_ERROR=XRAY_ISOLATED_HTTPS_NOT_VERIFIED|UNIFIED_PROBE.*NETWORK_FAIL' "$TMP"; then
      explanation="Выбранная нода не прошла проверку HTTPS. Переключение не выполнено; выберите другую ноду или повторите проверку позднее."
    elif grep -Eq 'XRAY_MANUAL_ERROR=PROVIDER_CHANGED|UNIFIED_ERROR=PROVIDER_CHANGED_DURING_PROBE' "$TMP"; then
      explanation="Подписка изменилась во время проверки. Обновите список нод и повторите выбор."
    elif grep -Eq 'XRAY_MANUAL_ERROR=XRAY_MANUAL_ROLLBACK_UNCONFIRMED|XRAY_MANUAL_ERROR=FOREIGN_' "$TMP"; then
      explanation="Не удалось подтвердить завершение восстановления. Не повторяйте переключения; проверьте активный VPN и состояние шлюза."
    elif grep -Eq 'XRAY_MANUAL_ERROR=|NATIVE_RETURN_ERROR=|UNIFIED_ERROR=' "$TMP"; then
      explanation="Проверка или переключение ноды завершилось ошибкой. Работоспособность выбранной ноды не подтверждена. Проверьте текущий транспорт и технические подробности ниже."
    else
      explanation="Операция не завершилась успешно. Проверьте текущий статус шлюза и прочитайте подробности ниже. Если ошибка повторяется, сохраните её технический код для диагностики."
    fi
    sed -i "1iЧто произошло: $explanation\\nЧто делать: сведения о причине и коде приведены ниже.\\n" "$TMP"
  fi
  sed -i "1iРезультат: $label\\nОперация: $heading\\n" "$TMP"
  view_tmp="$(mktemp)" || return 1
  if ! awg_readable_status_text "$TMP" >"$view_tmp"; then
    rm -f "$view_tmp"
    return 1
  fi
  if dialog --backtitle "$BACKTITLE" --title "$heading — $label" --textbox "$view_tmp" 30 110; then
    dialog_rc=0
  else
    dialog_rc=$?
  fi
  rm -f "$view_tmp"
  return "$dialog_rc"
}

