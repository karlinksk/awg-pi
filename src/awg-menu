mihomo_node_chain_editor(){
  local choice node idx chain current order_file listing node_json
  local -a nodes=()
  order_file=/etc/awg-pbr/transports/mihomo/node-policy.nodes

  if [[ -r "$order_file" ]] && "$MIHOMO_NODE_POLICY" status 2>/dev/null | grep -q '^Mihomo node policy: fixed$'; then
    mapfile -t nodes <"$order_file"
  fi
  if (( ${#nodes[@]} == 0 )); then
    current="$(cat /etc/awg-pbr/transports/mihomo/node-name 2>/dev/null || true)"
    [[ -z "$current" ]] || nodes=("$current")
  fi

  while true; do
    chain="(пусто)"
    if (( ${#nodes[@]} > 0 )); then
      chain="$(mihomo_display_chain "${nodes[@]}")"
    fi
    choice="$(dialog --backtitle "$BACKTITLE" --title "Цепочка резервных узлов Mihomo" --item-help --menu \
      "Текущая цепочка:\n$chain\n\nПри отказе переход выполняется только слева направо; автоматического возврата назад нет." 26 110 10 \
      1 "Добавить узел" "Добавляет выбранный узел в конец резервной цепочки." \
      2 "Удалить узел" "Позволяет выбрать и удалить узел из текущей цепочки." \
      3 "Переместить выше" "Меняет выбранный узел местами с предыдущим." \
      4 "Переместить ниже" "Меняет выбранный узел местами со следующим." \
      5 "Применить цепочку FIXED" "Проверяет все узлы и сохраняет однонаправленную резервную цепочку." \
      6 "Начать с текущего узла" "Сбрасывает редактор к текущему выбранному узлу Mihomo." \
      7 "Показать доступные узлы" "Показывает список доступных узлов без UUID и секретных ключей." \
      0 "Отмена" "Выход без изменения сохранённой политики." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="Проверка живых узлов Mihomo"
        if ! run_with_progress "$title" "$MIHOMO_POOL" ensure live --geo-if-policy; then
          dialog --backtitle "$BACKTITLE" --title "$title" --textbox "$TMP" 30 110
          continue
        fi
        node_json="$(mktemp /run/awg-pbr/mihomo-fixed-catalog.XXXXXX.json)" || continue
        chmod 600 "$node_json"
        if ! "$MIHOMO_POOL" list live --all --ignore-policy --format json >"$node_json" 2>/dev/null; then
          rm -f "$node_json"
          msg "FIXED" "Единый каталог недоступен. Политика не изменена."
          continue
        fi
        listing="$("$MIHOMO_NODE_PICKER" "$node_json" --target live --protocol all --region all 2>/dev/null)" || listing=""
        rm -f "$node_json"
        [[ -n "$listing" ]] || { msg "FIXED" "Единый каталог недоступен. Политика не изменена."; continue; }
        node="$(select_tsv_node_dialog "Добавить резервный узел" "Все профили показаны. Для FIXED разрешены только исправные Mihomo; Xray и неисправные ноды видны, но не добавляются." "$listing" no fixed)" || continue
        [[ -n "$node" ]] || continue
        if printf '%s\n' "${nodes[@]}" | grep -Fxq -- "$node"; then
          msg "Резервирование узлов Mihomo" "Этот узел уже есть в цепочке."
          continue
        fi
        if ! "$MIHOMO_CONFIGURE" node prepare "$node" >/dev/null 2>&1; then
          msg "Резервирование узлов Mihomo" "Узел не найден или его адрес не определяется в текущем источнике Mihomo."
          continue
        fi
        nodes+=("$node")
        ;;
      2)
        (( ${#nodes[@]} > 0 )) || { msg "Резервирование узлов Mihomo" "Цепочка пуста."; continue; }
        idx="$(select_chain_index "Удалить узел" "Выберите узел для удаления." 1 "${#nodes[@]}" "${nodes[@]}")" || continue
        unset 'nodes[idx-1]'
        nodes=("${nodes[@]}")
        ;;
      3)
        (( ${#nodes[@]} > 1 )) || continue
        idx="$(select_chain_index "Переместить выше" "Выберите узел, который нужно поднять на одну позицию." 2 "${#nodes[@]}" "${nodes[@]}")" || continue
        node="${nodes[idx-1]}"; nodes[idx-1]="${nodes[idx-2]}"; nodes[idx-2]="$node"
        ;;
      4)
        (( ${#nodes[@]} > 1 )) || continue
        idx="$(select_chain_index "Переместить ниже" "Выберите узел, который нужно опустить на одну позицию." 1 "$((${#nodes[@]}-1))" "${nodes[@]}")" || continue
        node="${nodes[idx-1]}"; nodes[idx-1]="${nodes[idx]}"; nodes[idx]="$node"
        ;;
      5)
        (( ${#nodes[@]} >= 2 )) || { msg "Резервирование узлов Mihomo" "Для автоматического переключения при отказе нужно минимум два узла."; continue; }
        chain="$(mihomo_display_chain "${nodes[@]}")"
        confirm "Применить цепочку FIXED" "Сохранить цепочку узлов:\n\n$chain\n\nАвтоматический переход разрешён только слева направо; страна узла не определяется автоматически." || continue
        title="Политика узлов Mihomo → FIXED"
        capture "$MIHOMO_NODE_POLICY" mode fixed "${nodes[@]}" || true
        return 0
        ;;
      6)
        current="$(cat /etc/awg-pbr/transports/mihomo/node-name 2>/dev/null || true)"
        [[ -n "$current" ]] && nodes=("$current") || nodes=()
        ;;
      7)
        title="Живые узлы для FIXED"
        if run_with_progress "$title" "$MIHOMO_POOL" ensure live --geo-if-policy; then
          mihomo_pool_results_dialog live || true
        else
          dialog --backtitle "$BACKTITLE" --title "$title" --textbox "$TMP" 30 110
        fi
        ;;
      0) return 0 ;;
    esac
  done
}

