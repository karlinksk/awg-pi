      title="Transport → Mihomo"
      capture "$AWG_TRANSPORT" select mihomo || true
    fi
  elif (( rc != 0 )); then
    msg "Mihomo node" "Новый узел не применён; предыдущая конфигурация сохранена/восстановлена."
  fi
}

mihomo_candidate_menu(){
  local behavior="${1:-normal}" node_name endpoint info_tmp current rc listing

  title="Staged Mihomo provider"
