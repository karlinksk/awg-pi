        capture "$AWG_ROUTE" reload || true
        ;;
      2)
        confirm "Reboot" "Перезагрузить Raspberry Pi?\n\nSSH и Transit backup через эту Pi будут временно недоступны до завершения загрузки." && systemctl reboot
