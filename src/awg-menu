select_tsv_node_dialog(){
  local dialog_title="$1" prompt="$2" listing="$3" pick provider_idx ui_idx name display_name type endpoint duplicate health country delay description tab
  local query="" filtered count total search_prompt advanced=no scope="${5:-manual}"
  local eligible=0 xray_count=0 fail_count=0 xray_fail_count=0 xray_unknown_count=0 mihomo_unknown_count=0 node_health state_label source_total="" shown_total
  local engine_label shown_endpoint shown_delay line_label item_help cols narrow=no
  if (( $# >= 4 )); then advanced="$4"; fi
  local -a items=()
  local -A choice_name=() choice_health=()
  tab="$(printf '\t')"
  total="$(awk -F '\t' '$1 ~ /^[0-9]+$/ {n++} END{print n+0}' <<<"$listing")"
  if [[ "$scope" == live || "$scope" == fixed ]]; then
    source_total="$("$MIHOMO_UNIFIED" list 2>/dev/null | sed -n 's/^UNIFIED_PROVIDER_COUNT=//p' | head -n1)" || source_total=""
  fi
  [[ "$source_total" =~ ^[1-9][0-9]*$ ]] || source_total="$total"
  shown_total="$source_total"
  cols="$(stty size </dev/tty 2>/dev/null | awk '{print $2}' || true)"
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=120
  (( cols < 110 )) && narrow=yes
  while true; do
    if [[ -n "$query" ]]; then
      filtered="$(grep -iF -- "$query" <<<"$listing" || true)"
    else
      filtered="$listing"
    fi
    count="$(awk -F '\t' '$1 ~ /^[0-9]+$/ {n++} END{print n+0}' <<<"$filtered")"
    items=(
      "__search__" "🔎 Поиск / фильтр" "Поиск без учёта регистра по имени, протоколу, адресу, стране точки выхода или задержке."
    )
    if [[ -n "$query" ]]; then
      items+=("__clear__" "Сбросить поиск [$query]" "Вернуть полный список работоспособных узлов текущего географического фильтра.")
    fi
    if [[ "$advanced" == yes ]]; then
      items+=("__advanced__" "⚙ Фильтры / обновление / статистика" "Дополнительные параметры списка; выбор рабочей ноды не меняется.")
    fi
    choice_name=()
    choice_health=()
    eligible=0; xray_count=0; fail_count=0; xray_fail_count=0; xray_unknown_count=0; mihomo_unknown_count=0
    ui_idx=0
    while IFS="$tab" read -r provider_idx name type endpoint duplicate health country delay; do
      [[ "$provider_idx" =~ ^[0-9]+$ && -n "$name" ]] || continue
      ui_idx=$((ui_idx + 1))
      choice_name["$ui_idx"]="$name"
      choice_health["$ui_idx"]="$health"
      # Missing or inconclusive engine evidence is neither OK nor FALL.
      # Duplicate names cannot be counted as independently usable nodes.
      if [[ "$duplicate" != DUPLICATE ]]; then
        case "$health" in
          MIHOMO_OK) eligible=$((eligible + 1)) ;;
          MIHOMO_FAIL) fail_count=$((fail_count + 1)) ;;
          MIHOMO_UNTESTED) mihomo_unknown_count=$((mihomo_unknown_count + 1)) ;;
          XRAY_HTTPS) xray_count=$((xray_count + 1)) ;;
          XRAY_NETWORK_FAIL) xray_fail_count=$((xray_fail_count + 1)) ;;
          XRAY_*) xray_unknown_count=$((xray_unknown_count + 1)) ;;
        esac
      fi
      display_name="$(mihomo_clip_node_label "$(mihomo_display_node_name "$name")" 24)"
      shown_endpoint="$(mihomo_clip_node_label "$endpoint" 25)"
      shown_delay="—"
      if [[ "$delay" =~ ^[0-9]+ms$ ]]; then
        shown_delay="${delay%ms}мс"
      fi
      case "$health" in
        MIHOMO_OK) engine_label="Mihomo"; state_label="OK" ;;
        MIHOMO_FAIL) engine_label="Mihomo"; state_label="FALL" ;;
        MIHOMO_UNTESTED) engine_label="Mihomo"; state_label="НЕ ПРОВ." ;;
        XRAY_HTTPS) engine_label="Xray"; state_label="OK" ;;
        XRAY_NETWORK_FAIL) engine_label="Xray"; state_label="FALL" ;;
        XRAY_*) engine_label="Xray"; state_label="НЕ ПРОВ." ;;
        *) engine_label="—"; state_label="НЕПОДД." ;;
      esac
      # "НЕ ПРОВ." means no trustworthy success/failure verdict, not a
      # third health status and never a gate on manual switching.
      [[ "$duplicate" == DUPLICATE ]] && state_label="ДУБЛЬ"
      if [[ "$narrow" == yes ]]; then
        line_label="$display_name | $engine_label/$type | $shown_delay | $state_label"
      else
        line_label="$display_name | $engine_label | $type | $shown_endpoint | $shown_delay | $state_label"
      fi
      item_help="Полное имя: $name. Адрес сервера: $endpoint. Задержка: $shown_delay. OK/FALL — результат проверки движка; НЕ ПРОВ. — нет достоверного вердикта. Ручной выбор доступен."
      items+=("$ui_idx" "$line_label" "$item_help")
    done <<<"$filtered"
    search_prompt="$prompt\n\nПоказано: $count из $shown_total\nMihomo: OK $eligible | FALL $fail_count | без вердикта $mihomo_unknown_count\nXray: OK $xray_count | FALL $xray_fail_count | без вердикта $xray_unknown_count"
    if [[ "$scope" == fixed ]]; then
      search_prompt="$prompt\n\nПоказано: $count из $shown_total | Для FIXED допустимы только исправные Mihomo: $eligible"
    fi
    search_prompt="$search_prompt\nАдрес — сервер подключения; задержка — тест. НЕ ПРОВ. не означает отказ."
    [[ -z "$query" ]] || search_prompt="$search_prompt | поиск: $query"
    pick="$(dialog --backtitle "$BACKTITLE" --title "$dialog_title" --item-help --menu "$search_prompt" 28 116 17 "${items[@]}" 3>&1 1>&2 2>&3)" || return 1
    case "$pick" in
      __search__)
        query="$(input "$dialog_title — поиск" "Введите часть имени узла, протокол (например vless), hostname/IP, код страны или часть адреса:" "$query")" || continue
        ;;
      __clear__)
        query=""
        ;;
      __advanced__) return 42 ;;
      *)
        [[ -n "${choice_name[$pick]:-}" ]] || continue
        node_health="${choice_health[$pick]:-UNSUPPORTED}"
        if [[ "$scope" == fixed && "$node_health" != MIHOMO_OK ]]; then
          msg "FIXED — доступность узла" "Профиль виден в подписке, но недоступен для FIXED.\n\nВ этой цепочке разрешены только исправные Mihomo; Xray и отказавшие узлы не добавляются."
          continue
        fi
        if [[ "$node_health" == UNSUPPORTED || "$node_health" == DUPLICATE ]]; then
          msg "Точка выхода" "Профиль отображается для полноты подписки, но его выбор запрещён: неподдерживаемый формат или неоднозначное имя."
          continue
        fi
        printf '%s\n' "${choice_name[$pick]}"
        return 0
        ;;
    esac
  done
}

mihomo_protocol_label(){
  case "${1:-all}" in
    all) printf '%s\n' "Все протоколы" ;;
    vless) printf '%s\n' "VLESS" ;;
    trojan) printf '%s\n' "Trojan" ;;
    hysteria2) printf '%s\n' "Hysteria2" ;;
    ss) printf '%s\n' "Shadowsocks (SS)" ;;
    vmess) printf '%s\n' "VMess" ;;
    *) printf '%s\n' "неизвестно" ;;
  esac
}

mihomo_protocol_select(){
  local current="${1:-all}" choice default_item
  case "$current" in
    all) default_item=1 ;;
    vless) default_item=2 ;;
    trojan) default_item=3 ;;
    hysteria2) default_item=4 ;;
    ss) default_item=5 ;;
    vmess) default_item=6 ;;
    *) default_item=1 ;;
  esac
  choice="$(dialog --backtitle "$BACKTITLE" --title "Протокол пула узлов" --default-item "$default_item" --item-help --menu \
    "Какие протоколы показывать при выборе и проверке узлов. «Все протоколы» включены по умолчанию." 23 108 9 \
    1 "$(awg_option_label "Все протоколы" all "$current")" "Показывать все поддерживаемые протоколы." \
    2 "$(awg_option_label "VLESS" vless "$current")" "Проверять и предлагать только VLESS." \
    3 "$(awg_option_label "Trojan" trojan "$current")" "Проверять и предлагать только Trojan." \
    4 "$(awg_option_label "Hysteria2" hysteria2 "$current")" "Проверять и предлагать только Hysteria2." \
    5 "$(awg_option_label "Shadowsocks (SS)" ss "$current")" "Проверять и предлагать только Shadowsocks." \
    6 "$(awg_option_label "VMess" vmess "$current")" "Проверять и предлагать только VMess." \
    0 "Назад" "Не менять протокольный фильтр." 3>&1 1>&2 2>&3)" || return 1
  [[ "$choice" != 0 ]] || return 1
  case "$choice" in
    1) printf '%s\n' all ;;
    2) printf '%s\n' vless ;;
    3) printf '%s\n' trojan ;;
    4) printf '%s\n' hysteria2 ;;
    5) printf '%s\n' ss ;;
    6) printf '%s\n' vmess ;;
    *) return 1 ;;
  esac
}

mihomo_protocol_settings(){
  local current selected
  current="$("$MIHOMO_POOL" protocol get 2>/dev/null || echo all)"
  selected="$(mihomo_protocol_select "$current")" || return 0
  [[ "$selected" == "$current" ]] && return 0
  if "$MIHOMO_POOL" protocol set "$selected" >/dev/null; then
    msg "Протокол пула узлов" "Выбран протокол: $(mihomo_protocol_label "$selected").\n\nНовый фильтр будет использован при следующей проверке пула и режимом AUTO. Текущий активный узел немедленно не переключается."
  else
    msg "Протокол пула узлов" "Не удалось сохранить протокольный фильтр."
  fi
}

mihomo_pool_status_dialog(){
  local target="$1" raw region protocol state age source_total total healthy europe geo region_ru protocol_ru state_ru geo_ru target_ru title_text

  case "$target" in
    live) target_ru="рабочий профиль"; title_text="Статистика рабочего пула Mihomo" ;;
    candidate) target_ru="подготовленный профиль"; title_text="Статистика подготовленного пула Mihomo" ;;
    *) target_ru="$target"; title_text="Статистика пула узлов Mihomo" ;;
  esac

  if ! raw="$("$MIHOMO_POOL" status "$target" 2>&1)"; then
    msg "$title_text" "Не удалось получить состояние пула узлов.\n\n$raw"
    return 1
  fi

  region="$(sed -n 's/^Region filter: //p' <<<"$raw" | head -n1)"
  protocol="$(sed -n 's/^Protocol filter: //p' <<<"$raw" | head -n1)"
  state="$(sed -n 's/^Pool state: //p' <<<"$raw" | head -n1)"
  age="$(sed -n 's/^Pool age: //p' <<<"$raw" | head -n1)"
  source_total="$(sed -n 's/^Provider nodes: //p' <<<"$raw" | head -n1)"
  total="$(sed -n 's/^Nodes total: //p' <<<"$raw" | head -n1)"
  healthy="$(sed -n 's/^Nodes healthy: //p' <<<"$raw" | head -n1)"
  europe="$(sed -n 's/^Nodes Europe: //p' <<<"$raw" | head -n1)"
  geo="$(sed -n 's/^Geo enriched: //p' <<<"$raw" | head -n1)"

  case "$region" in
    europe) region_ru="только Европа" ;;
    all) region_ru="все страны" ;;
    *) region_ru="${region:-неизвестно}" ;;
  esac
  protocol_ru="$(mihomo_protocol_label "${protocol:-all}")"
  case "$state" in
    ready) state_ru="готов" ;;
    missing) state_ru="ещё не создан" ;;
    *) state_ru="${state:-неизвестно}" ;;
  esac
  case "$geo" in
    yes) geo_ru="выполнена" ;;
    no) geo_ru="не выполнена" ;;
    *) geo_ru="${geo:-неизвестно}" ;;
  esac

  [[ -n "$age" ]] || age="—"
  [[ -n "$source_total" ]] || source_total="$total"
  [[ -n "$total" ]] || total="0"
  [[ -n "$healthy" ]] || healthy="0"
  [[ -n "$europe" ]] || europe="0"

  msg "$title_text"     "Пул: $target_ru\nСостояние: $state_ru\nФильтр региона: $region_ru\nПротокол: $protocol_ru\nВозраст последней проверки: $age\n\nУзлов в источнике: $source_total\nУзлов в выбранном протоколе: $total\nРаботоспособных: $healthy\nЕвропейских точек выхода: $europe\n\nОпределение фактической страны выхода: $geo_ru"
}

MIHOMO_POOL_PICKED_NODE=""
XRAY_MANUAL_SWITCH="/usr/local/sbin/awg-xray-manual-switch"

mihomo_pool_pick(){
  local target="$1" dialog_title="$2" prompt="$3" choice region region_label protocol listing node node_json pick_rc
  local direct=no
  if (( $# >= 4 )) && [[ "$4" == direct ]]; then direct=yes; fi
  MIHOMO_POOL_PICKED_NODE=""
  while true; do
    region="$("$MIHOMO_POOL" policy get 2>/dev/null || echo all)"
    case "$region" in
      europe) region_label="$(awg_option_label "Только Европа" europe "$region")" ;;
      all) region_label="$(awg_option_label "Все страны" all "$region")" ;;
      *) region_label="неизвестно" ;;
    esac
    protocol="$("$MIHOMO_POOL" protocol get 2>/dev/null || echo all)"
    if [[ "$direct" == yes && "$target" == live ]]; then
      # Directly open the unified node list; advanced actions stay opt-in.
      choice=1
    else
      choice="$(dialog --backtitle "$BACKTITLE" --title "$dialog_title" --item-help --menu \
      "Выберите ноду из подписки. Непроверенные ноды также доступны для ручного выбора." 26 114 12 \
      1 "Выбрать узел Mihomo / Xray [$region_label]" "Показать все ноды Mihomo и Xray из подписки." \
      2 "Фильтр региона [$region_label]" "Показывать все страны или только подтверждённые европейские." \
      3 "Обновить проверку сейчас" "Обновить результаты проверки без переключения VPN." \
      4 "Статистика пула Mihomo" "Количество нод, их доступность и время последней проверки." \
      5 "Показать все результаты" "Посмотреть результаты проверок Mihomo и Xray." \
      0 "Назад" "Вернуться без выбора узла." 3>&1 1>&2 2>&3)" || return 1
    fi
    case "$choice" in
      1)
        title="Проверка пула Mihomo"
        if ! run_with_progress "$title" "$MIHOMO_POOL" ensure "$target" --geo-if-policy; then
          # A Mihomo-only scan can fail all Reality VLESS nodes while the
          # Xray catalog readiness does not gate manual selection.
          [[ "$target" == live ]] || {
            dialog --backtitle "$BACKTITLE" --title "$title" --textbox "$TMP" 30 110
            continue
          }
        fi
        node_json="$(mktemp /run/awg-pbr/mihomo-node-picker.XXXXXX.json)"
        chmod 600 "$node_json"
        if ! "$MIHOMO_POOL" list "$target" --all --ignore-policy --format json >"$node_json" 2>/dev/null; then
          rm -f "$node_json"
          msg "$dialog_title" "Не удалось прочитать текущий пул узлов."
          [[ "$direct" == yes ]] && return 1
          continue
        fi
        if ! listing="$("$MIHOMO_NODE_PICKER" "$node_json" --target "$target" --protocol "$protocol" --region "$region" 2>/dev/null)"; then
          rm -f "$node_json"
          msg "$dialog_title" "Единый каталог недоступен. Рабочий транспорт не менялся."
          [[ "$direct" == yes ]] && return 1
          continue
        fi
        rm -f "$node_json"
        [[ -n "$listing" ]] || {
          msg "$dialog_title" "Нет подходящих узлов. Проверьте подписку и фильтры региона/протокола."
          [[ "$direct" == yes ]] && return 1
          continue
        }
        if node="$(select_tsv_node_dialog "$dialog_title" "$prompt" "$listing" "$direct" "$target")"; then
          MIHOMO_POOL_PICKED_NODE="$node"
        else
          pick_rc=$?
          if (( pick_rc == 42 )); then
            direct=no
            continue
          fi
          [[ "$direct" == yes ]] && return 1
          continue
        fi
        return 0
        ;;
      2)
        if [[ "$region" == europe ]]; then
          "$MIHOMO_POOL" policy set all >/dev/null
        else
          "$MIHOMO_POOL" policy set europe >/dev/null
          title="Определение европейских точек"
          if ! run_with_progress "$title" "$MIHOMO_POOL" ensure "$target" --geo-if-policy; then
            dialog --backtitle "$BACKTITLE" --title "$title" --textbox "$TMP" 30 110
          fi
        fi
        ;;
      3)
        title="Проверка узлов Mihomo"
        capture "$MIHOMO_POOL" scan "$target" --geo-if-policy || true
        # Do not depend on Mihomo scan success: Reality VLESS may be unusable
        # through Mihomo but succeed via isolated Xray. The scans stay separate.
        if [[ "$target" == live && -x "$MIHOMO_UNIFIED" ]]; then
          capture "$MIHOMO_UNIFIED" probe-vless-all || true
        fi
        ;;
      4)
        mihomo_pool_status_dialog "$target" || true
        ;;
      5)
        mihomo_pool_results_dialog "$target" || true
        ;;
      0) return 1 ;;
    esac
  done
}

select_opencck_source(){
  local dialog_title="$1" prompt="$2" listing line name rest pick
  local -a items=()
  local -A seen=()
  listing="$("$AWG_ROUTE" source list 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "=== OpenCCK sources ===" && "$line" != \(* ]] || continue
    read -r name rest <<<"$line"
    [[ -n "$name" && -z "${seen[$name]:-}" ]] || continue
    seen["$name"]=1
    items+=("$name" "${rest:-источник OpenCCK}" "Выбрать источник $name.")
  done <<<"$listing"
  (( ${#items[@]} > 0 )) || {
    msg "$dialog_title" "Источники OpenCCK пока не настроены."
    return 1
  }
  pick="$(dialog --backtitle "$BACKTITLE" --title "$dialog_title" --item-help --menu "$prompt" 24 112 14 "${items[@]}" 3>&1 1>&2 2>&3)" || return 1
  printf '%s\n' "$pick"
}

select_client(){
  local listing line pick
  local -a items=()
  listing="$("$AWG_ROUTE" client list 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ "$line" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue
    items+=("$line" "Клиент SELECTIVE" "Удалить этот IPv4 из списка клиентов SELECTIVE.")
  done <<<"$listing"
  (( ${#items[@]} > 0 )) || {
    msg "Клиенты" "Список клиентов пуст — удалять нечего."
    return 1
  }
  pick="$(dialog --backtitle "$BACKTITLE" --title "Удалить клиента" --item-help --menu "Выберите IPv4 клиента для удаления." 22 90 12 "${items[@]}" 3>&1 1>&2 2>&3)" || return 1
  printf '%s\n' "$pick"
}


select_manual_domain(){
  local kind="$1" dialog_title="$2" listing domain count
  local -a domains=() items=()
  listing="$("$AWG_ROUTE" list 2>/dev/null)" || return 1
  case "$kind" in
    vpn)
      mapfile -t domains < <(awk '/^=== VPN domains ===$/{show=1;next} /^=== DIRECT exceptions ===$/{show=0} show && NF {print}' <<<"$listing")
      ;;
    direct)
      mapfile -t domains < <(awk '/^=== DIRECT exceptions ===$/{show=1;next} /^=== OpenCCK sources ===$/{show=0} show && NF {print}' <<<"$listing")
      ;;
    *) return 2 ;;
  esac
  count="${#domains[@]}"
  (( count > 0 )) || {
    msg "$dialog_title" "Ручной список пуст — удалять нечего."
    return 1
  }
  if (( count > 200 )); then
    input "$dialog_title" "В списке $count записей. Введите точный домен для удаления:"
    return
  fi
  for domain in "${domains[@]}"; do
    items+=("$domain" "ручная запись" "Удалить этот домен из выбранного ручного списка.")
  done
  dialog --backtitle "$BACKTITLE" --title "$dialog_title" --item-help --menu "Выберите домен для удаления." 26 100 16 "${items[@]}" 3>&1 1>&2 2>&3
}
select_chain_index(){
  local dialog_title="$1" prompt="$2" min="$3" max="$4" i pick display_name
  shift 4
  local -a nodes=("$@") items=()
  for (( i=1; i<=${#nodes[@]}; i++ )); do
    (( i >= min && i <= max )) || continue
    display_name="$(mihomo_display_node_name "${nodes[i-1]}")"
    items+=("$i" "$display_name" "Выбрать этот элемент резервной цепочки.")
  done
  (( ${#items[@]} > 0 )) || return 1
  pick="$(dialog --backtitle "$BACKTITLE" --title "$dialog_title" --item-help --menu "$prompt" 22 100 12 "${items[@]}" 3>&1 1>&2 2>&3)" || return 1
  printf '%s\n' "$pick"
}


mihomo_node_menu(){
  local node_name info_tmp current rc preview fixed_chain="" confirm_text sync_out updated_chain="" resolver engine index proof egress_ip

  if ! mihomo_pool_pick live "Точка выхода Mihomo / Xray" "Выберите ноду Mihomo или Xray. Фильтры и диагностика доступны отдельным пунктом списка." direct; then
    return 0
  fi
  node_name="$MIHOMO_POOL_PICKED_NODE"
  [[ -n "$node_name" ]] || { msg "Выбор узла" "Имя узла не задано."; return 0; }

  # Do not begin a manual Mihomo/Xray node transaction while AUTO is on AWG.
  # The current AWG is intentionally sticky; only the operator may restore Mihomo.
  if [[ "$(cat /etc/awg-pbr/transport 2>/dev/null)" != mihomo ]]; then
    msg "Ручной выбор ноды" "Сейчас активен не Mihomo, а другой VPN-транспорт (например, AWG). Сначала вручную выберите транспорт Mihomo в меню VPN, затем повторите выбор ноды. Действующий VPN не изменён."
    return 0
  fi

  resolver="$("$MIHOMO_UNIFIED" resolve "$node_name" 2>/dev/null)" || {
    msg "Выбор узла" "Профиль изменился или имя неоднозначно. Обновите проверку; переключения не было."
    return 0
  }
  engine="$(sed -n 's/^NODE_ENGINE=//p' <<<"$resolver" | head -n1)"
  if [[ "$engine" == XRAY ]]; then
    index="$(sed -n 's/^NODE_INDEX=//p' <<<"$resolver" | head -n1)"
    [[ "$index" =~ ^[1-9][0-9]*$ ]] || {
      msg "Xray VLESS" "Профиль изменился или индекс неверен. Обновите список."
      return 0
    }
    title="Ручной Xray — проверка конфигурации"
    if ! run_with_progress "$title" "$XRAY_MANUAL_SWITCH" preview "$index"; then
      show_operation_result 1 "$title"
      return 0
    fi
    if grep -Fxq 'XRAY_MANUAL_ALREADY_SELECTED=YES' "$TMP"; then
      msg "Xray VLESS" "Этот Xray-профиль уже выбран, локальный TUN готов. Повторная остановка Xray и переключение не требуются."
      return 0
    fi
    confirm "Переключение на Xray" "Выполнить ручное переключение рабочего VPN на выбранную Xray-ноду?\\n\\nПроверяются конфигурация, сервис Xray, локальный TUN и маршруты. При ошибке выполняется откат к прежней ноде под защитой независимого таймера.\\n\\nDNS, SSH и MikroTik не меняются." || return 0
    title="Ручной переход на Xray"
    if run_with_progress "$title" "$XRAY_MANUAL_SWITCH" apply "$index"; then

      msg "Xray VLESS — выбран" "Движок: Xray VLESS\nУзел: $node_name\nДоступность внешних сайтов не проверялась\n\nАдрес сервера в списке — не IP выхода. Локальная готовность подтверждена; доступность сайтов, LAN и reboot не тестировались."
    else
      show_operation_result 1 "$title"
    fi
    return 0
  fi
  [[ "$engine" == MIHOMO ]] || {
    msg "Выбор узла" "Движок не поддерживается; переключение запрещено."
    return 0
  }

  # One native-target dispatcher from either Mihomo or Xray. It resolves
  # and prepares the requested provider node, proves actual Pi TUN egress,
  # and rolls back all of Mihomo's config under an independent watchdog.
  # Never mistake a stored node-name for the controller's live selection.
  title="Подготовка узла Mihomo"
  if ! run_with_progress "$title" "$MIHOMO_CONFIGURE" node prepare "$node_name"; then
    show_operation_result 1 "$title"
    msg "Ручной выбор Mihomo" "Узел подписки не удалось подготовить. Рабочий транспорт и конфигурация не изменены."
    return 0
  fi
  title="Ручной выбор Mihomo — предварительная проверка"
  if ! run_with_progress "$title" "$XRAY_MANUAL_SWITCH" native-preview "$node_name"; then
    show_operation_result 1 "$title"
    msg "Ручной выбор Mihomo" "Предварительная проверка не пройдена. Действующий выход и политика резервирования не изменены."
    return 0
  fi
  if grep -Fxq 'NATIVE_MANUAL_ALREADY_SELECTED=YES' "$TMP"; then
    msg "Узел Mihomo" "Этот профиль уже выбран и локальный TUN готов. Повторное переключение не требуется."
    return 0
  fi
  confirm "Переключение на Mihomo" "Сделать выбранную ноду рабочим выходом независимо от текущего движка?\n\nНовый профиль и IP подготавливаются под защитой watchdog; возможен короткий перерыв TUN при перезапуске Mihomo. После переключения будут проверены сервис, выбранная нода и маршруты.\n\nПри ошибке прежний Xray/Mihomo и конфигурация восстанавливаются. FIXED/AUTO, READY, DNS, SSH и MikroTik не меняются." || return 0
  title="Защищённый выбор ноды Mihomo"
  if run_with_progress "$title" "$XRAY_MANUAL_SWITCH" native-apply "$node_name"; then

    msg "Mihomo — выбран" "Движок: Mihomo\nУзел: $node_name\nДоступность внешних сайтов не проверялась\n\nАдрес сервера в списке — не IP выхода. Локальная готовность подтверждена; доступность сайтов, LAN и reboot не тестировались."
  else
    show_operation_result 1 "$title"
  fi
}

mihomo_candidate_is_staged(){
  "$MIHOMO_CONFIGURE" status 2>/dev/null | grep -Fqx 'Provider candidate: staged'
}

mihomo_candidate_require(){
  if mihomo_candidate_is_staged; then
    return 0
  fi
  msg "Подготовленный профиль Mihomo" "Подготовленный профиль отсутствует.\n\nПосле успешного применения подготовленные данные становятся рабочими и удаляются из временного хранилища.\n\nДля фильтрации, поиска, статистики и выбора узлов текущего профиля используйте «Точка выхода / узел»."
  return 1
}

mihomo_open_candidate_after_update(){
  if mihomo_candidate_is_staged; then
    mihomo_candidate_menu
  else
    msg "Обновление источника Mihomo" "Новых данных в подписке нет: подготовленный профиль не создавался. Текущая подписка и выбранный узел сохранены."
  fi
}

mihomo_candidate_menu(){
  local behavior="${1:-normal}" node_name info_tmp current rc

  mihomo_candidate_require || return 0

  if ! mihomo_pool_pick candidate "Узел подготовленного профиля" "Выберите основной живой узел подготовленной подписки."; then
    return 0
  fi
  node_name="$MIHOMO_POOL_PICKED_NODE"
  [[ -n "$node_name" ]] || { msg "Mihomo" "Имя узла не задано."; return 0; }

  info_tmp="$(mktemp)"
  title="Проверка узла подготовленного профиля"
  if ! run_with_progress "$title" "$MIHOMO_CONFIGURE" provider candidate prepare "$node_name"; then
    dialog --backtitle "$BACKTITLE" --title "$title — ошибка" --textbox "$TMP" 24 108
    return 0
  fi
  dialog --backtitle "$BACKTITLE" --title "$title — проверен" --textbox "$TMP" 24 108

  confirm "Применить подготовленный профиль?" "Текущий профиль и выбранный узел будут заменены только после успешного запуска и проверки работоспособности.\n\nIPv4 сервера будет выбран автоматически из данных подготовленного профиля — повторно вводить его не нужно.\n\nПроверка Mihomo может занять до ~30 секунд. Нерабочий узел будет автоматически отклонён с восстановлением прежней конфигурации; подготовленный профиль останется для повторной попытки." || return 0

  current="$("$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured)"
  title="Применение профиля Mihomo"
  if capture "$MIHOMO_CONFIGURE" provider candidate commit-auto "$node_name"; then
    rc=0
  else
    rc=$?
  fi

  if (( rc == 0 )); then
    if [[ "$behavior" == secondary ]]; then
      msg "Mihomo добавлен" "Источник и основной узел успешно настроены. Текущий активный транспорт «$current» не изменён."
      if confirm "Резервирование узлов Mihomo" "Настроить резервную цепочку узлов сейчас?\n\nОсновной узел уже выбран: $node_name\nПри отказе переход будет выполняться только слева направо по явно добавленным узлам."; then
        mihomo_node_chain_editor
      else
        "$MIHOMO_NODE_POLICY" mode auto >/dev/null 2>&1 || true
      fi
    elif [[ "$current" != mihomo ]]; then
      msg "Профиль Mihomo" "Новый профиль и узел применены. Активный транспорт не изменён; переключение выполняется через «VPN-маршрутизация → Активный транспорт»."
    fi
  else
    msg "Подготовленный профиль Mihomo" "Профиль не применён: выбранный узел не прошёл финальную проверку работоспособности или запуск Mihomo завершился ошибкой. Предыдущий рабочий профиль и активный транспорт сохранены/восстановлены; подготовленный профиль оставлен для повторной попытки."
  fi
}

