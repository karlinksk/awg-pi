paste_mihomo_provider(){
  local rc source_mode
  install -d -m 700 /run/awg-pbr
  PASTE_TMP="$(mktemp /run/awg-pbr/mihomo-paste.XXXXXX)"
  PASTE_OUT="$(mktemp /run/awg-pbr/mihomo-paste-result.XXXXXX)"
  chmod 600 "$PASTE_TMP" "$PASTE_OUT"

  set +e
  dialog --stdout --backtitle "$BACKTITLE" --title "Вставить профиль / подписку Mihomo" \
    --ok-label "Проверить" --cancel-label "Отмена" \
    --editbox "$PASTE_TMP" 30 110 >"$PASTE_OUT"
  rc=$?
  set -e
  if (( rc != 0 )); then
    rm -f "$PASTE_TMP" "$PASTE_OUT"; PASTE_TMP=""; PASTE_OUT=""; return 0
  fi
  mv -f "$PASTE_OUT" "$PASTE_TMP"
  PASTE_OUT=""

  sed -i 's/\r$//' "$PASTE_TMP"
  if ! grep -q '[^[:space:]]' "$PASTE_TMP"; then
    msg "Mihomo" "Вставленный профиль пуст. Текущая конфигурация не изменена."
    rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0
  fi

  source_mode="$(mihomo_local_source_mode)" || { rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0; }
  [[ "$source_mode" != 0 ]] || { rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0; }

  title="Подготовка профиля Mihomo"
  if capture "$MIHOMO_CONFIGURE" provider stage-file "$PASTE_TMP" "$source_mode"; then
    rm -f "$PASTE_TMP"; PASTE_TMP=""
    mihomo_candidate_menu
  else
    rm -f "$PASTE_TMP"; PASTE_TMP=""
  fi
}

mihomo_provider_format_dialog(){
