paste_awg_config(){
  local rc
  install -d -m 700 /run/awg-pbr
  PASTE_TMP="$(mktemp /run/awg-pbr/config-paste.XXXXXX.conf)"
  PASTE_OUT="$(mktemp /run/awg-pbr/config-paste-result.XXXXXX.conf)"
  chmod 600 "$PASTE_TMP" "$PASTE_OUT"

  set +e
  dialog --stdout --backtitle "$BACKTITLE" --title "Вставить конфигурацию AmneziaWG" \
    --ok-label "Проверить" --cancel-label "Отмена" \
    --editbox "$PASTE_TMP" 30 110 >"$PASTE_OUT"
  rc=$?
  set -e
  if (( rc != 0 )); then
    rm -f "$PASTE_TMP" "$PASTE_OUT"
    PASTE_TMP=""
    PASTE_OUT=""
    return 0
  fi
  mv -f "$PASTE_OUT" "$PASTE_TMP"
  PASTE_OUT=""

  # Text copied from Windows terminals/clipboard may contain CRLF.
  sed -i 's/\r$//' "$PASTE_TMP"
  if ! grep -q '[^[:space:]]' "$PASTE_TMP"; then
    msg "AmneziaWG" "Конфигурация пуста. Рабочий профиль не изменён."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  title="Проверка AmneziaWG"
  if ! capture "$AWG_ROUTE" config check "$PASTE_TMP"; then
    msg "AmneziaWG" "Проверка не пройдена. Рабочая конфигурация не изменена."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  if confirm "Установить AmneziaWG" \
    "Проверка файла .conf и ядра AWG пройдена.\n\nСекретные ключи в итоговом окне не отображаются.\nТекущий профиль будет сохранён для быстрого отката.\n\nУстановить проверенную конфигурацию?"; then
    title="Замена профиля"
    capture "$AWG_ROUTE" config replace "$PASTE_TMP" --yes || true
  fi

  rm -f "$PASTE_TMP"
  PASTE_TMP=""
}

