select_timezone(){
  local current="$1" zone region current_region pick
  local -a zones=() regions=() region_items=() zone_items=()
  local -A seen=() counts=()
  mapfile -t zones < <(timedatectl list-timezones 2>/dev/null)
  (( ${#zones[@]} > 0 )) || return 1

  if [[ "$current" == */* ]]; then
    current_region="${current%%/*}"
  else
    current_region="Прочие"
  fi

  for zone in "${zones[@]}"; do
    if [[ "$zone" == */* ]]; then region="${zone%%/*}"; else region="Прочие"; fi
    counts["$region"]=$(( ${counts[$region]:-0} + 1 ))
    if [[ -z "${seen[$region]:-}" ]]; then
      seen["$region"]=1
      regions+=("$region")
    fi
  done

  for region in "${regions[@]}"; do
    region_items+=("$region" "$(awg_option_label "Часовых поясов: ${counts[$region]}" "$region" "$current_region")" "Открыть часовые пояса этого региона.")
  done
  pick="$(dialog --backtitle "$BACKTITLE" --title "Часовой пояс — регион" --default-item "$current_region" --item-help --menu "Сначала выберите регион." 24 92 14 "${region_items[@]}" 3>&1 1>&2 2>&3)" || return 1
  region="$pick"

  for zone in "${zones[@]}"; do
    if [[ "$region" == "Прочие" ]]; then
      [[ "$zone" != */* ]] || continue
      zone_items+=("$zone" "$(awg_option_label "$zone" "$zone" "$current")" "Выбрать $zone.")
    else
      [[ "$zone" == "$region/"* ]] || continue
      zone_items+=("$zone" "$(awg_option_label "${zone#*/}" "$zone" "$current")" "Выбрать $zone.")
    fi
  done
  (( ${#zone_items[@]} > 0 )) || return 1
  if [[ ("$region" == "Прочие" && "$current" != */*) || "$current" == "$region/"* ]]; then
    dialog --backtitle "$BACKTITLE" --title "Часовой пояс — $region" --default-item "$current" --item-help --menu "Выберите часовой пояс." 28 100 18 "${zone_items[@]}" 3>&1 1>&2 2>&3
  else
    dialog --backtitle "$BACKTITLE" --title "Часовой пояс — $region" --item-help --menu "Выберите часовой пояс." 28 100 18 "${zone_items[@]}" 3>&1 1>&2 2>&3
  fi
}
timezone_menu(){
  local choice current zone
  while true; do
    current="$(current_timezone)"
    choice="$(dialog --backtitle "$BACKTITLE" --title "Часовой пояс" --item-help --menu \
