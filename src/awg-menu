#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"

# Presentation-only dispatcher. Never intercept the Matrix inner dialog instance.
if [[ "${AWG_MENU_REEXEC:-0}" != 1 && "${1:-}" != "--classic" &&
      -t 0 && -t 1 && -f /etc/awg-pbr/menu-appearance ]]; then
  read -r _awg_ui < /etc/awg-pbr/menu-appearance || _awg_ui=classic
  if [[ "$_awg_ui" == matrix && -r /usr/local/lib/awg-pi/awg-matrix-compositor.py ]] &&
     command -v tmux >/dev/null 2>&1; then
    _awg_owner="${SUDO_USER:-}"
    if [[ -n "$_awg_owner" && "$_awg_owner" != root ]] && id "$_awg_owner" >/dev/null 2>&1; then
      # A Matrix inner menu returns 42 to request an in-place switch to
      # classic.  Keep the original SSH terminal and never spawn nested UI.
      if /usr/sbin/runuser -u "$_awg_owner" -- /usr/bin/python3 /usr/local/lib/awg-pi/awg-matrix-compositor.py; then
        exit 0
      else
        _matrix_rc=$?
        if (( _matrix_rc == 42 )); then
          exec /usr/local/sbin/awg-menu --classic
        fi
        exit "$_matrix_rc"
      fi
    fi
  fi
fi
[[ "${1:-}" != "--classic" ]] || shift


# Run from a temporary copy so a gateway update can safely replace awg-menu.
if [[ "${AWG_MENU_REEXEC:-0}" != 1 ]]; then
  _menu_tmp="$(mktemp /tmp/awg-menu.XXXXXX)"
  cp "$0" "$_menu_tmp"
  chmod 700 "$_menu_tmp"
  export AWG_MENU_REEXEC=1
  exec "$_menu_tmp" "$@"
fi
command -v dialog >/dev/null 2>&1 || { echo "Не установлен компонент интерфейса: dialog" >&2; exit 1; }

# SSH sessions may have LANG=C even when Russian text is supported.
# Change only the menu process locale, never global system settings.
if [[ "$(locale charmap 2>/dev/null || true)" != UTF-8 ]] &&
   locale -a 2>/dev/null | grep -Eiq '^C[.]utf8$|^C[.]UTF-8$'; then
  export LC_ALL=C.UTF-8
fi

# Preserve the SSH shell for an undersized terminal instead of logging out.
if [[ -t 0 && -t 1 ]]; then
  _ui_rows=""; _ui_cols=""
  read -r _ui_rows _ui_cols < <(stty size </dev/tty 2>/dev/null) || true
  if [[ "$_ui_rows" =~ ^[0-9]+$ && "$_ui_cols" =~ ^[0-9]+$ ]] &&
     (( _ui_rows < 22 || _ui_cols < 70 )); then
    printf 'Для русского меню требуется окно SSH не меньше 70×22. Сейчас: %s×%s.\n' "$_ui_cols" "$_ui_rows" >&2
    printf 'Вы остаетесь в командной строке SSH. Увеличьте окно и снова запустите awg-menu.\n' >&2
    exit 10
  fi
fi


# Consistent high-contrast, 8-color palette for all AWG menu widgets.
# Termius may highlight words (e.g. OK) green; a light-cyan panel makes those
# hard to read. Deep-blue panels, white text and black selected rows keep
# both terminal-colored words and native dialog labels legible on SSH clients.
# These are terminal ANSI colors, not forced RGB values.
# A process-owned rc file is necessary because the menu can be launched via
# sudo from arbitrary SSH accounts and must not mutate ~/.dialogrc or /etc.
# The surrounding screen uses the former light-cyan dialog background;
# windows remain deep blue for readable highlighted status text.
# Breadcrumbs use dialog's title color: white on deep blue, while the
# position marker, progress gauge and active buttons keep yellow accents.
AWG_DIALOG_STYLE=""
awg_dialog_theme_init(){
  AWG_DIALOG_STYLE="$(mktemp /tmp/awg-dialogrc.XXXXXXXX)"
  chmod 600 "$AWG_DIALOG_STYLE"
  cat > "$AWG_DIALOG_STYLE" <<'AWG_DIALOG_PALETTE'
use_colors = ON
use_shadow = OFF
use_scrollbar = OFF
screen_color = (BLACK,CYAN,OFF)
shadow_color = (BLACK,BLACK,ON)
dialog_color = (WHITE,BLUE,OFF)
title_color = (WHITE,BLUE,ON)
border_color = (CYAN,BLUE,ON)
border2_color = border_color
menubox_color = dialog_color
menubox_border_color = border_color
menubox_border2_color = border_color
item_color = dialog_color
item_selected_color = (WHITE,BLACK,ON)
tag_color = (CYAN,BLUE,ON)
tag_selected_color = (YELLOW,BLACK,ON)
tag_key_color = tag_color
tag_key_selected_color = tag_selected_color
itemhelp_color = (WHITE,BLUE,OFF)
button_active_color = (WHITE,BLACK,ON)
button_inactive_color = (WHITE,BLUE,ON)
button_key_active_color = button_active_color
button_key_inactive_color = button_inactive_color
button_label_active_color = (YELLOW,BLACK,ON)
button_label_inactive_color = (WHITE,BLUE,ON)
inputbox_color = dialog_color
inputbox_border_color = border_color
inputbox_border2_color = border_color
searchbox_color = dialog_color
searchbox_title_color = title_color
searchbox_border_color = border_color
searchbox_border2_color = border_color
position_indicator_color = (YELLOW,BLUE,ON)
uarrow_color = (CYAN,BLUE,ON)
darrow_color = uarrow_color
check_color = dialog_color
check_selected_color = button_active_color
form_active_text_color = button_active_color
form_text_color = dialog_color
gauge_color = (YELLOW,BLUE,ON)
AWG_DIALOG_PALETTE
  export DIALOGRC="$AWG_DIALOG_STYLE"
}


# Breadcrumbs appear in the window title/border, not the dialog body.
# This preserves vertical space on compact 70x22 SSH terminals.
# Derive the path from the Bash call stack to avoid stale navigation state.
awg_dialog_breadcrumb_title(){
  local title="$1" limit="$2" fn label i part route
  shift 2
  [[ "$title" == "Главное меню"* ]] && { printf '%s' "$title"; return; }
  local -a crumbs=("Главная")
  for ((i=$#;i>=1;i--)); do
    fn="${!i}"
    label=""
    case "$fn" in
      vpn_menu) label="VPN" ;;
      mihomo_menu) label="Mihomo" ;;
      mihomo_subscription_menu) label="Подписка / источник" ;;
      mihomo_import_menu) label="Импорт профиля / подписки" ;;
      mihomo_node_menu) label="Точка выхода Mihomo / Xray" ;;
      mihomo_node_policy_menu) label="Резервирование узлов Mihomo" ;;
      mihomo_node_auto_menu) label="AUTO" ;;
      mihomo_xray_auto_menu) label="AUTO Mihomo / Xray" ;;
      mihomo_auto_strategy_menu) label="Hot Pool" ;;
      mihomo_node_chain_editor) label="FIXED" ;;
      mihomo_advanced_menu) label="Дополнительные настройки" ;;
      mihomo_xray_vless_menu) label="Xray" ;;
      awg_config_menu) label="Конфигурация AmneziaWG" ;;
      active_transport_menu) label="Активный транспорт" ;;
      selection_policy_menu) label="Политика выбора транспорта" ;;
      vpn_destination_menu) label="VPN-сервисы / домены" ;;
      opencck_menu) label="OpenCCK" ;;
      domain_menu) label="Домены" ;;
      client_menu) label="Клиенты" ;;
      system_menu) label="Система" ;;
      dns_menu) label="Внешние DNS-серверы" ;;
      timezone_menu) label="Часовой пояс" ;;
      operating_mode_menu) label="Режим работы" ;;
      desktop_commander_menu) label="Desktop Commander" ;;
      notify_menu) label="Telegram" ;;
      notify_types_menu) label="Типы уведомлений" ;;
      update_menu) label="Обновления" ;;
      # The picker is a control widget, not a separate navigation page.
    esac
    if [[ -n "$label" && "${crumbs[-1]}" != "$label" ]]; then
      crumbs+=("$label")
    fi
  done
  # A chooser can expand its parent section title. Avoid repeating it.
  if [[ "${crumbs[-1]}" == "Точка выхода" && "$title" == "Точка выхода "* ]]; then
    crumbs[-1]="$title"
  fi
  # The menu title often expands its section label, e.g. "AUTO — пул".
  # Avoid repeating the section in a path like AUTO › AUTO — пул узлов.
  if [[ "$title" != "${crumbs[-1]}" &&
        "$title" != "${crumbs[-1]} "* &&
        "$title" != "${crumbs[-1]} —"* ]]; then
    crumbs+=("$title")
  fi
  route="${crumbs[0]}"
  for ((i=1;i<${#crumbs[@]};i++)); do route+=" › ${crumbs[i]}"; done
  # Preserve current and immediate parent on narrow terminal widths.
  if (( ${#route} > limit && ${#crumbs[@]} > 3 )); then
    route="Главная › … › ${crumbs[-2]} › ${crumbs[-1]}"
  fi
  if (( ${#route} > limit )); then
    part="${crumbs[-1]}"
    local prefix="Главная › … › "
    if (( ${#part} + ${#prefix} > limit )); then
      part="${part:0:$((limit-${#prefix}-1))}…"
    fi
    route="$prefix$part"
  fi
  printf '%s' "$route"
}

# Shrink oversized dialogs to real SSH TTY; do not modify terminal settings.
dialog(){
  local -a args=("$@")
  local rows cols i hi wi li prompt_lines available
  local line line_width line_rows item_fields item_count remaining desired visible has_help
  # Use Russian button labels in every widget, including --stdout forms.
  args=(--ok-label "ОК" --cancel-label "Отмена" --yes-label "Да" --no-label "Нет" --exit-label "Закрыть" "${args[@]}")
  # A dialog --stdout form returns values via fd1 pipe, painting on fd2.
  # Ordinary selection menus swap fds. Both require breadcrumb rendering.
  if [[ ! -t 0 || ( ! -t 1 && ! -t 2 ) ]]; then command dialog "${args[@]}"; return; fi
  read -r rows cols < <(stty size </dev/tty 2>/dev/null) || { command dialog "${args[@]}"; return; }
  [[ "$rows" =~ ^[0-9]+$ && "$cols" =~ ^[0-9]+$ ]] || { command dialog "${args[@]}"; return; }
  if ((rows < 22 || cols < 70)); then
    printf 'Увеличьте окно SSH минимум до 70×22 (сейчас %s×%s).\n' "$cols" "$rows" >&2
    return 1
  fi
  for ((i=0;i<${#args[@]};i++)); do
    case "${args[i]}" in
      --menu|--checklist|--msgbox|--yesno|--inputbox|--editbox|--textbox|--infobox)
        hi=$((i+2)); wi=$((i+3))
        if [[ "${args[hi]:-}" =~ ^[0-9]+$ && "${args[wi]:-}" =~ ^[0-9]+$ ]]; then
          ((args[hi] > rows-2)) && args[hi]="$((rows-2))"
          ((args[wi] > cols-2)) && args[wi]="$((cols-2))"
          if [[ "${args[i]}" == --menu ]]; then
            li=$((i+4))
            # Count actual entries; the AWG menus use (tag,item,help).
            # Fake selectable spacer items would break numeric navigation.
            has_help=0
            for ((item_fields=0;item_fields<i;item_fields++)); do
              [[ "${args[item_fields]}" == --item-help ]] && has_help=1
            done
            item_fields=2
            ((has_help)) && item_fields=3
            remaining=$((${#args[@]}-li-1))
            item_count=0
            if ((remaining>0 && remaining%item_fields==0)); then
              item_count=$((remaining/item_fields))
            fi
            # Account for wrapped Russian descriptions at terminal width.
            line_width=$((args[wi]-8))
            ((line_width<18)) && line_width=18
            prompt_lines=0
            while IFS= read -r line; do
              line_rows=$(((${#line}+line_width-1)/line_width))
              ((line_rows<1)) && line_rows=1
              prompt_lines=$((prompt_lines+line_rows))
            done <<<"${args[i+1]}"
            if ((item_count>0 && ${args[li]:-0}>0)); then
              visible=$((item_count < args[li] ? item_count : args[li]))
              # ncurses top-aligns rows inside oversized menus; fit the
              # window to its contents so the whole widget centers on screen.
              desired=$((visible+prompt_lines+6))
              ((desired<12)) && desired=12
              ((desired<args[hi])) && args[hi]="$desired"
              ((args[li]>visible)) && args[li]="$visible"
            fi
            available="$((args[hi]-5-prompt_lines))"
            ((available<3)) && available=3
            if [[ "${args[li]:-}" =~ ^[0-9]+$ ]] && ((args[li]>available)); then
              args[li]="$available"
            fi
          fi
        fi
        break;;
    esac
  done
  # The title is available on menus, confirmations, input, and textboxes.
  # The main dashboard remains untouched.
  local title_index=-1 max_title=64
  for ((i=0;i<${#args[@]};i++)); do
    if [[ "${args[i]}" == --title && -n "${args[i+1]:-}" ]]; then
      title_index=$((i+1))
      break
    fi
  done
  if ((title_index>=0)); then
    for ((i=0;i<${#args[@]};i++)); do
      if [[ "${args[i]}" == --menu || "${args[i]}" == --checklist || "${args[i]}" == --msgbox ||
            "${args[i]}" == --yesno || "${args[i]}" == --inputbox ||
            "${args[i]}" == --editbox || "${args[i]}" == --textbox ||
            "${args[i]}" == --infobox ]]; then
        if [[ "${args[i+3]:-}" =~ ^[0-9]+$ ]]; then
          max_title=$((args[i+3]-7))
        fi
        break
      fi
    done
    ((max_title>12)) || max_title=12
    args[title_index]="$(awg_dialog_breadcrumb_title "${args[title_index]}" "$max_title" "${FUNCNAME[@]:1}")"
  fi
  command dialog "${args[@]}"
}

