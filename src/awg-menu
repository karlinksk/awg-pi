      3 "Перезапустить awg0 и health monitor" "Перезапускает туннель AmneziaWG и проверку здоровья; VPN-трафик может кратковременно перейти в FAIL-OPEN/DIRECT." \
      4 "Конфигурация AmneziaWG" "Установка нового native .conf текстом/из файла или rollback предыдущего профиля." \
      5 "Mihomo / Multi-Transport" "Subscription, bootstrap-каналы, локальный импорт и транзакционное переключение AWG ↔ Mihomo." \
      0 "Назад" "Возвращает в главное меню без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="VPN ON"
        capture "$AWG_ROUTE" vpn on || true
        ;;
      2)
        confirm "VPN OFF" "Отключить Selective VPN policy?\n\nВесь маршрутизируемый трафик будет идти DIRECT. Сам туннель awg0 и сохранённые списки не удаляются." || continue
        title="VPN OFF"
        capture "$AWG_ROUTE" vpn off || true
        ;;
      3)
        confirm "Перезапуск" "Перезапустить awg0 и health monitor?" || continue
        systemctl restart awg-quick@awg0.service awg-pbr-health.service
        msg "VPN" "Сервисы перезапущены."
        ;;
      4) awg_config_menu ;;
      5) mihomo_menu ;;
      0) return 0 ;;
    esac
  done
