operating_mode_menu(){
  local choice current current_id selective_label transit_label
  while true; do
    current_id="$(operating_mode_id)"
    current="$(operating_mode_label "$current_id")"
    selective_label="Selective Gateway"
    transit_label="MikroTik Transit / Backup VPN"
    [[ "$current_id" == selective ]] && selective_label="$selective_label [ТЕКУЩИЙ]"
    [[ "$current_id" == transit ]] && transit_label="$transit_label [ТЕКУЩИЙ]"
    refresh_backtitle
    choice="$(dialog --backtitle "$BACKTITLE" --title "Operating mode [$(operating_mode_badge "$current_id")]" --item-help --menu \
      "Текущий режим: $current\n\nВыберите архитектуру маршрутизации. Сохранённые Selective-списки не удаляются при Transit." \
      21 100 6 \
      1 "$selective_label" "Raspberry Pi сама классифицирует VPN/DIRECT/OpenCCK/client трафик и применяет FAIL-OPEN при отказе AWG." \
      2 "$transit_label" "MikroTik выбирает трафик; Pi принимает его только от доверенного роутера и отправляет через AWG с FAIL-CLOSED." \
      0 "Назад" "Возвращает в системное меню без изменения режима." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        confirm "Selective Gateway" "Переключить Pi в Selective Gateway? Списки OpenCCK/VPN/DIRECT и clients будут снова активны." || continue
        title="Operating mode"
        capture "$AWG_ROUTE" mode selective || true
        refresh_backtitle
        ;;
      2)
        confirm "MikroTik Transit" "Переключить Pi в Transit?\n\nПеред включением будет проверен AWG, DIRECT-маршрут endpoint и MikroTik. При ошибке выполнится rollback.\n\nMikroTik должен быть настроен отдельно как источник backup-трафика." || continue
        title="Operating mode"
        capture "$AWG_ROUTE" mode transit || true
        refresh_backtitle
        ;;
      0) return 0 ;;
    esac
  done
}

