mihomo_display_node_name(){
  local name="$1" prefix
  if [[ "$name" == *" "* ]]; then
    prefix="${name%% *}"
    if [[ -n "$prefix" && "$prefix" != *[[:alnum:]]* ]]; then
      printf '%s\n' "${name#* }"
      return 0
    fi
  fi
  printf '%s\n' "$name"
}

mihomo_clip_node_label(){
  local value="$1" limit="${2:-24}"
  if (( ${#value} > limit )); then
    printf '%s…' "${value:0:limit-1}"
  else
    printf '%s' "$value"
  fi
}

mihomo_display_chain(){
  local node shown first=1
  for node in "$@"; do
    shown="$(mihomo_display_node_name "$node")"
    (( first == 1 )) || printf ' → '
    printf '%s' "$shown"
    first=0
  done
  printf '\n'
}

