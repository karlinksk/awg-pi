  fi

  if (( rc == 0 )); then
    if [[ "$behavior" == secondary ]]; then
      msg "Mihomo добавлен" "Provider и primary node успешно настроены. Текущий active transport '$current' НЕ изменён."
      if confirm "Mihomo Node Failover" "Настроить ordered fallback-chain для Mihomo сейчас?\n\nPrimary уже выбран: $node_name\nFailover будет идти только слева направо по явно добавленным nodes."; then
