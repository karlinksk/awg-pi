paste_awg_config(){
  local rc
  install -d -m 700 /run/awg-pbr
  PASTE_TMP="$(mktemp /run/awg-pbr/config-paste.XXXXXX.conf)"
  chmod 600 "$PASTE_TMP"

  set +e
  dialog --backtitle "$BACKTITLE" --title "Вставить конфигурацию AmneziaWG" \
    --ok-label "Проверить" --cancel-label "Отмена" \
    --editbox "$PASTE_TMP" 30 110
  rc=$?
  set -e
  if (( rc != 0 )); then
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  # Text copied from Windows terminals/clipboard may contain CRLF.
  sed -i 's/\r$//' "$PASTE_TMP"
  if ! grep -q '[^[:space:]]' "$PASTE_TMP"; then
    msg "AmneziaWG" "Конфигурация пуста. Рабочий профиль не изменён."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  title="Проверка AmneziaWG"
  if ! capture "$AWG_ROUTE" config check "$PASTE_TMP"; then
    msg "AmneziaWG" "Проверка не пройдена. Рабочая конфигурация не изменена."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  if confirm "Установить AmneziaWG" \
    "Проверка native .conf и AWG core пройдена.\n\nСекретные ключи в итоговом окне не отображаются.\nСтарый профиль будет сохранён для rollback.\n\nУстановить проверенную конфигурацию?"; then
    title="Замена профиля"
    capture "$AWG_ROUTE" config replace "$PASTE_TMP" --yes || true
  fi

  rm -f "$PASTE_TMP"
  PASTE_TMP=""
}

awg_config_menu(){
  local choice path previous rollback_state
  while true; do
    previous="/etc/amnezia/amneziawg/${VPN_IF:-awg0}.conf.previous"
    if [[ -s "$previous" ]]; then
      rollback_state="доступен"
    else
      rollback_state="нет предыдущего профиля"
    fi
    choice="$(dialog --backtitle "$BACKTITLE" --title "Конфигурация AmneziaWG" --item-help --menu \
      "Выберите способ установки native .conf. Перед заменой профиль проходит безопасную проверку." \
      21 110 8 \
      1 "Вставить конфигурацию текстом" "Открывает защищённое многострочное поле: вставьте native AmneziaWG .conf из буфера обмена. Сначала выполняется check." \
      2 "Загрузить конфигурацию из файла" "Использует уже существующий native .conf на Raspberry Pi и запускает транзакционную замену с rollback." \
      3 "Откатить предыдущую конфигурацию [$rollback_state]" "Доступен после первой успешной замены профиля через v1.3; меняет current/previous местами и проверяет handshake/transport." \
      0 "Назад" "Возвращает в меню VPN без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1) paste_awg_config ;;
      2)
        path="$(input "AmneziaWG" "Полный путь к native .conf:")" || continue
        run_interactive "Замена профиля" "$AWG_ROUTE" config replace "$path"
        ;;
      3)
        if [[ ! -s "$previous" ]]; then
          msg "Откат профиля" "Предыдущий AWG-профиль для быстрого rollback отсутствует.\n\nОн появится автоматически после первой успешной замены профиля через этот v1.3 мастер.\n\nАрхивные upgrade/install backups не используются как automatic rollback, чтобы случайно не активировать устаревшую конфигурацию."
          continue
        fi
        run_interactive "Откат профиля" "$AWG_ROUTE" config rollback
        ;;
      0) return 0 ;;
    esac
  done
}

resolve_tsv_node_choice(){
  local listing="$1" choice="$2" resolved
  resolved=""
  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    resolved="$(awk -F '\t' -v pick="$choice" '$1 == pick {print $2; exit}' <<<"$listing")"
  fi
  printf '%s\n' "${resolved:-$choice}"
}

mihomo_node_menu(){
  local node_name endpoint info_tmp current rc listing

  title="Доступные Mihomo nodes"
  capture "$MIHOMO_CONFIGURE" node list || return 0
  listing="$("$MIHOMO_CONFIGURE" node list 2>/dev/null)" || return 0

