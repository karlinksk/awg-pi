selection_policy_menu(){
  local choice status mode primary fallback allowed active_policy=""
  while true; do
    status="$("$AWG_SELECTION" status 2>/dev/null || true)"
    mode="$(sed -n 's/^Selection mode: //p' <<<"$status" | head -n1)"
    primary="$(sed -n 's/^Primary transport: //p' <<<"$status" | head -n1)"
    fallback="$(sed -n 's/^Fallback transports: //p' <<<"$status" | head -n1)"
    allowed="$(sed -n 's/^Allowed transport order: //p' <<<"$status" | head -n1)"
    active_policy=""
    case "$mode" in
      manual) active_policy=manual ;;
      fixed)
        case "$primary:$fallback" in
          awg:mihomo) active_policy=fixed_awg ;;
          mihomo:awg) active_policy=fixed_mihomo ;;
        esac ;;
      auto)
        case "$allowed" in
          awg,mihomo) active_policy=auto_awg ;;
          mihomo,awg) active_policy=auto_mihomo ;;
