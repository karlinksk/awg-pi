paste_mihomo_provider(){
  local rc source_mode
  install -d -m 700 /run/awg-pbr
  PASTE_TMP="$(mktemp /run/awg-pbr/mihomo-paste.XXXXXX)"
  chmod 600 "$PASTE_TMP"

  set +e
  dialog --backtitle "$BACKTITLE" --title "Вставить Mihomo provider/subscription" \
    --ok-label "Проверить" --cancel-label "Отмена" \
    --editbox "$PASTE_TMP" 30 110
  rc=$?
  set -e
  if (( rc != 0 )); then
    rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0
  fi

  sed -i 's/\r$//' "$PASTE_TMP"
  if ! grep -q '[^[:space:]]' "$PASTE_TMP"; then
    msg "Mihomo" "Вставленный provider пуст. Live state не изменён."
    rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0
  fi

  source_mode="$(mihomo_local_source_mode)" || { rm -f "$PASTE_TMP"; PASTE_TMP=""; return 0; }
