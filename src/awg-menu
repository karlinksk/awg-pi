    mode="$(cat /etc/awg-pbr/mode 2>/dev/null || echo selective)"
    if [[ "$mode" == transit ]]; then
      choice="$(dialog --backtitle "$BACKTITLE" --title "AWG / Transit [TRANSIT]" --item-help --menu \
        "Transit: MikroTik выбирает трафик. Health monitor автоматически управляет AWG и применяет FAIL-CLOSED при отказе." \
        21 100 7 \
        1 "Показать состояние режима" "Показывает текущий Operating mode, Transit guard, policy rule и готовность VPN table." \
        2 "Перезапустить awg0 и health monitor" "Перезапускает сам туннель AmneziaWG и его контроль здоровья. Возможен краткий обрыв backup VPN-трафика." \
        3 "Конфигурация AmneziaWG" "Установка нового native .conf текстом/из файла или rollback предыдущего профиля." \
        4 "Mihomo / Multi-Transport" "Subscription, bootstrap, выбор точки выхода и транзакционное переключение AWG ↔ Mihomo." \
        0 "Назад" "Возвращает в главное меню без изменений." 3>&1 1>&2 2>&3)" || return 0
      case "$choice" in
        1)
          title="Transit"
          capture "$AWG_ROUTE" mode status || true
          ;;
        2)
          confirm "Перезапуск" "Перезапустить awg0 и health monitor?" || continue
          systemctl restart awg-quick@awg0.service awg-pbr-health.service
          msg "VPN" "Сервисы перезапущены."
          ;;
        3) awg_config_menu ;;
        4) mihomo_menu ;;
        0) return 0 ;;
      esac
      continue
    fi

    choice="$(dialog --backtitle "$BACKTITLE" --title "VPN policy [SELECTIVE]" --item-help --menu \
      "Управление Selective Gateway. Подсказка для выделенного пункта показана внизу." 21 100 7 \
      1 "Включить VPN policy" "Разрешает выборочную VPN-маршрутизацию. Policy станет ACTIVE только после успешного health-check AWG." \
