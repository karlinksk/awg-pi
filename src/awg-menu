mihomo_initial_setup_flow(){
  local behavior="${1:-secondary}" profile provider_format url init_tmp

  profile="$(dialog --backtitle "$BACKTITLE" --title "Тип подписки" --item-help --menu \
    "Выберите профиль первичной настройки Mihomo." 19 104 5 \
    standard "Обычная подписка Mihomo/Clash" "URL используется как есть; HWID не добавляется." \
    remnawave "Citadel / Remnawave" "Создаётся один постоянный HWID и используется путь /mihomo. HWID сохраняется и не показывается." \
    0 "Назад" "Не выполнять настройку." 3>&1 1>&2 2>&3)" || return 0
  [[ "$profile" != 0 ]] || return 0

  provider_format="$(mihomo_provider_format_dialog)" || return 0
  [[ "$provider_format" != 0 ]] || return 0

  url="$(secret_input "Настройка Mihomo" "Вставьте полный URL подписки.\n\nДля Citadel/Remnawave можно вставить базовую ссылку: /mihomo будет добавлен автоматически.")" || return 0
  [[ -n "$url" ]] || { msg "Mihomo" "Пустая ссылка не применена."; return 0; }

  install -d -m 700 /run/awg-pbr
  init_tmp="$(mktemp /run/awg-pbr/mihomo-init.XXXXXX)"
  chmod 600 "$init_tmp"
  {
    printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
    printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
    printf 'MIHOMO_PROVIDER_FORMAT=%q\n' "$provider_format"
  } >"$init_tmp"
  unset url

  title="Настройка Mihomo"
  if capture "$MIHOMO_CONFIGURE" init "$init_tmp"; then
    rm -f "$init_tmp"
    init_tmp=""
    if confirm "Профиль Mihomo подготовлен" "Источник успешно загружен и проверен. Перейти к выбору основного узла и применению профиля?"; then
      mihomo_candidate_menu "$behavior"
    fi
  else
    rm -f "$init_tmp"
    init_tmp=""
  fi
}

