#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"
command -v dialog >/dev/null 2>&1 || { echo "Не найден dialog" >&2; exit 1; }

AWG_ROUTE=/usr/local/sbin/awg-route
BACKTITLE="AWG Pi Gateway v1.1.0"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

msg(){ dialog --backtitle "$BACKTITLE" --title "$1" --msgbox "$2" 20 90; }
capture(){
  set +e
  "$@" >"$TMP" 2>&1
  rc=$?
  set -e
  dialog --backtitle "$BACKTITLE" --title "${title:-Результат}" --textbox "$TMP" 30 110
  return "$rc"
}
input(){
  local title="$1" prompt="$2" initial="${3:-}"
  dialog --backtitle "$BACKTITLE" --title "$title" --inputbox "$prompt" 10 80 "$initial" 3>&1 1>&2 2>&3
}
confirm(){
  dialog --backtitle "$BACKTITLE" --title "$1" --yesno "$2" 10 70
}

status_screen(){ title="Состояние системы"; capture "$AWG_ROUTE" status || true; }
diagnostics_screen(){ title="Диагностика"; capture "$AWG_ROUTE" diagnostics || true; }
logs_screen(){ title="Журналы"; capture "$AWG_ROUTE" logs 200 || true; }

domain_menu(){
  local kind="$1" label="$2" choice d path
  while true; do
    choice=$(dialog --backtitle "$BACKTITLE" --title "$label" --menu "Выберите действие" 20 85 10       1 "Показать список"       2 "Добавить домен"       3 "Удалить домен"       4 "Импортировать файл (добавить)"       5 "Импортировать файл (заменить)"       6 "Экспортировать файл"       0 "Назад" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in
      1) title="$label"; capture "$AWG_ROUTE" list || true ;;
      2)
        d=$(input "$label" "Введите домен:") || continue
        title="Добавление"; capture "$AWG_ROUTE" "$kind" add "$d" || true ;;
      3)
        d=$(input "$label" "Введите домен для удаления:") || continue
        title="Удаление"; capture "$AWG_ROUTE" "$kind" del "$d" || true ;;
      4)
        path=$(input "$label" "Полный путь к файлу:") || continue
        title="Импорт"; capture "$AWG_ROUTE" "$kind" import "$path" || true ;;
      5)
        path=$(input "$label" "Полный путь к файлу. Текущий список будет заменён:") || continue
        confirm "Подтверждение" "Полностью заменить текущий список?" || continue
        title="Импорт --replace"; capture "$AWG_ROUTE" "$kind" import --replace "$path" || true ;;
      6)
        path=$(input "$label" "Полный путь для сохранения файла:") || continue
        title="Экспорт"; capture "$AWG_ROUTE" "$kind" export "$path" || true ;;
      0) return 0 ;;
    esac
  done
}

opencck_menu(){
  local choice name type kind
  while true; do
    choice=$(dialog --backtitle "$BACKTITLE" --title "OpenCCK" --menu "Управление источниками" 22 90 12       1 "Показать источники"       2 "Добавить источник"       3 "Показать содержимое источника"       4 "Обновить все источники"       5 "Обновить один источник"       6 "Включить источник"       7 "Отключить источник"       8 "Удалить источник"       0 "Назад" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in
      1) title="OpenCCK sources"; capture "$AWG_ROUTE" source list || true ;;
      2)
        name=$(input "OpenCCK" "Имя группы или сайта (например youtube или youtube.com):") || continue
        type=$(dialog --backtitle "$BACKTITLE" --title "Тип данных" --menu "Выберите тип" 14 70 4           domains "Домены (рекомендуется)" ip4 "IPv4" cidr4 "IPv4 CIDR" 3>&1 1>&2 2>&3) || continue
        kind=$(dialog --backtitle "$BACKTITLE" --title "Тип источника" --menu "Как трактовать имя?" 12 70 3           group "Группа OpenCCK" site "Конкретный сайт/портал" 3>&1 1>&2 2>&3) || continue
        title="Добавление OpenCCK"; capture "$AWG_ROUTE" source add opencck "$name" --type "$type" --kind "$kind" || true ;;
      3)
        name=$(input "OpenCCK" "Имя источника:") || continue
        title="OpenCCK: $name"; capture "$AWG_ROUTE" source show opencck "$name" || true ;;
      4) title="OpenCCK update"; capture "$AWG_ROUTE" source update || true ;;
      5)
        name=$(input "OpenCCK" "Имя источника:") || continue
        title="OpenCCK update"; capture "$AWG_ROUTE" source update "$name" || true ;;
      6|7|8)
        name=$(input "OpenCCK" "Имя источника:") || continue
        action=enable; [[ "$choice" == 7 ]] && action=disable; [[ "$choice" == 8 ]] && action=del
        [[ "$action" != del ]] || confirm "Удаление" "Удалить источник $name?" || continue
        title="OpenCCK $action"; capture "$AWG_ROUTE" source "$action" opencck "$name" || true ;;
      0) return 0 ;;
    esac
  done
}

client_menu(){
  local choice ip
  while true; do
    choice=$(dialog --backtitle "$BACKTITLE" --title "Клиенты" --menu "PBR allow-list" 16 75 7       1 "Показать клиентов" 2 "Добавить IPv4" 3 "Удалить IPv4" 0 "Назад" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in
      1) title="Клиенты"; capture "$AWG_ROUTE" client list || true ;;
      2) ip=$(input "Клиенты" "IPv4 клиента:") || continue; title="Добавление клиента"; capture "$AWG_ROUTE" client add "$ip" || true ;;
      3) ip=$(input "Клиенты" "IPv4 клиента:") || continue; title="Удаление клиента"; capture "$AWG_ROUTE" client del "$ip" || true ;;
      0) return 0 ;;
    esac
  done
}

vpn_menu(){
  local choice
  while true; do
    choice=$(dialog --backtitle "$BACKTITLE" --title "VPN policy" --menu "Управление VPN" 15 75 6       1 "Включить VPN policy" 2 "Выключить VPN policy (DIRECT)" 3 "Перезапустить AWG" 0 "Назад" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in
      1) title="VPN ON"; capture "$AWG_ROUTE" vpn on || true ;;
      2) confirm "VPN OFF" "Перевести весь трафик в DIRECT?" || continue; title="VPN OFF"; capture "$AWG_ROUTE" vpn off || true ;;
      3) confirm "Перезапуск" "Перезапустить awg0 и health monitor?" || continue
         systemctl restart awg-quick@awg0.service awg-pbr-health.service
         msg "VPN" "Сервисы перезапущены." ;;
      0) return 0 ;;
    esac
  done
}

system_menu(){
  local choice
  choice=$(dialog --backtitle "$BACKTITLE" --title "Система" --menu "Системные функции" 16 75 7     1 "Перезагрузить конфигурацию AWG Gateway"     2 "Перезагрузить Raspberry Pi"     3 "Выключить Raspberry Pi"     0 "Назад" 3>&1 1>&2 2>&3) || return 0
  case "$choice" in
    1) title="Reload"; capture "$AWG_ROUTE" reload || true ;;
    2) confirm "Reboot" "Перезагрузить Raspberry Pi?" && systemctl reboot ;;
    3) confirm "Poweroff" "Выключить Raspberry Pi?" && systemctl poweroff ;;
  esac
}

while true; do
  choice=$(dialog --clear --backtitle "$BACKTITLE" --title "Главное меню" --menu     "AWG Pi Gateway. Стрелки — выбор, Enter — открыть." 24 90 14     1 "Состояние системы"     2 "VPN-маршрутизация"     3 "Домены VPN"     4 "DIRECT-исключения"     5 "OpenCCK"     6 "Клиенты"     7 "Диагностика"     8 "Обновление AmneziaWG"     9 "Журналы"     10 "Системные функции"     11 "Выйти в Shell"     0 "Завершить SSH-сессию" 3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    1) status_screen ;;
    2) vpn_menu ;;
    3) domain_menu vpn "Домены VPN" ;;
    4) domain_menu direct "DIRECT-исключения" ;;
    5) opencck_menu ;;
    6) client_menu ;;
    7) diagnostics_screen ;;
    8) title="Обновление AmneziaWG"; capture /usr/local/sbin/awg-update || true ;;
    9) logs_screen ;;
    10) system_menu ;;
    11) clear; exec bash -l ;;
    0) clear; exit 0 ;;
  esac
done
