awg_menu_restart_for_appearance(){
  # The compositor owns the real SSH terminal. Its inner tmux dialog exits
  # with an explicit hand-off code; the outer menu starts classic directly.
  if [[ "${AWG_MENU_MATRIX_INNER:-0}" == 1 ]]; then
    exit 42
  fi
  # In classic the menu is a temporary self-copy. Remove temporary files
  # before replacing that process; no SSH session is terminated.
  cleanup
  unset AWG_MENU_REEXEC
  exec /usr/local/sbin/awg-menu
}

appearance_menu(){
  local choice current style_tmp current_label
  while true; do
    current="$(cat /etc/awg-pbr/menu-appearance 2>/dev/null || printf classic)"
    if [[ "$current" == matrix ]]; then current_label="Matrix Gradient"; else current_label="Классическое"; fi
    choice="$(dialog --backtitle "$BACKTITLE" --title "Оформление интерфейса" --item-help --menu \
      "Выберите оформление. Оно переключится сразу." 17 88 3 \
      1 "$(awg_option_label "Классическое" classic "$current")" "Обычное меню без анимации." \
      2 "$(awg_option_label "Matrix Gradient" matrix "$current")" "Зелёные символы на фоне меню." \
      0 "Назад" "Без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      0) return 0 ;;
      1|2)
        if [[ "$choice" == 1 ]]; then choice=classic; else choice=matrix; fi
        [[ "$choice" != "$current" ]] || return 0
        if [[ "$choice" == matrix ]] &&
           { ! command -v tmux >/dev/null 2>&1 || [[ ! -r /usr/local/lib/awg-pi/awg-matrix-compositor.py ]]; }; then
          msg "Оформление интерфейса" "Matrix Gradient не установлен. Используйте классическое оформление."
          continue
        fi
        style_tmp="$(mktemp /etc/awg-pbr/.menu-appearance.XXXXXXXX)"
        printf '%s\n' "$choice" > "$style_tmp"
        chmod 0600 "$style_tmp"
        mv -f "$style_tmp" /etc/awg-pbr/menu-appearance
        awg_menu_restart_for_appearance
        ;;
    esac
  done
}

