  title="Stage Mihomo provider"
  if capture "$MIHOMO_CONFIGURE" provider stage-file "$PASTE_TMP" "$source_mode"; then
    rm -f "$PASTE_TMP"; PASTE_TMP=""
    mihomo_candidate_menu
  else
    rm -f "$PASTE_TMP"; PASTE_TMP=""
  fi
}

