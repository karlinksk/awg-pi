mihomo_node_chain_editor(){
  local choice node idx chain current order_file listing
  local -a nodes=()
  order_file=/etc/awg-pbr/transports/mihomo/node-policy.nodes

  if [[ -r "$order_file" ]] && "$MIHOMO_NODE_POLICY" status 2>/dev/null | grep -q '^Mihomo node policy: fixed$'; then
    mapfile -t nodes <"$order_file"
  fi
  if (( ${#nodes[@]} == 0 )); then
    current="$(cat /etc/awg-pbr/transports/mihomo/node-name 2>/dev/null || true)"
    [[ -z "$current" ]] || nodes=("$current")
  fi

  while true; do
    chain="(пусто)"
    if (( ${#nodes[@]} > 0 )); then
      chain="$(printf ' -> %s' "${nodes[@]}")"
      chain="${chain# -> }"
    fi
    choice="$(dialog --backtitle "$BACKTITLE" --title "Ordered Mihomo node-chain" --item-help --menu \
      "Текущая цепочка:\n$chain\n\nFailover идёт только слева направо; назад не возвращается." 26 110 10 \
      1 "Добавить node" "Добавляет точное имя live-node в конец цепочки." \
      2 "Удалить node" "Удаляет элемент по его номеру в цепочке." \
      3 "Переместить выше" "Меняет выбранный node местами с предыдущим." \
      4 "Переместить ниже" "Меняет выбранный node местами со следующим." \
      5 "Применить FIXED chain" "Проверяет все exact names и сохраняет ordered one-way failover chain." \
      6 "Начать с текущего node" "Сбрасывает редактор к текущей выбранной Mihomo ноде." \
      7 "Показать доступные nodes" "Показывает безопасный live-список name/type/server:port." \
      0 "Отмена" "Выход без изменения сохранённой policy." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        title="Доступные Mihomo nodes"
        capture "$MIHOMO_CONFIGURE" node list || true
        listing="$("$MIHOMO_CONFIGURE" node list 2>/dev/null)" || continue
        node="$(input "Добавить node" "Введите номер или ТОЧНОЕ имя live-node:")" || continue
        node="$(resolve_tsv_node_choice "$listing" "$node")"
        [[ -n "$node" ]] || continue
        if printf '%s\n' "${nodes[@]}" | grep -Fxq -- "$node"; then
          msg "Mihomo Node Failover" "Этот node уже есть в цепочке."
          continue
        fi
        if ! "$MIHOMO_CONFIGURE" node prepare "$node" >/dev/null 2>&1; then
          msg "Mihomo Node Failover" "Node не найден или не резолвится в текущем live provider."
          continue
        fi
        nodes+=("$node")
        ;;
      2)
        (( ${#nodes[@]} > 0 )) || { msg "Mihomo Node Failover" "Цепочка пуста."; continue; }
        idx="$(input "Удалить node" "Номер элемента 1..${#nodes[@]}:")" || continue
        [[ "$idx" =~ ^[0-9]+$ ]] && (( idx>=1 && idx<=${#nodes[@]} )) || { msg "Mihomo Node Failover" "Некорректный номер."; continue; }
        unset 'nodes[idx-1]'
        nodes=("${nodes[@]}")
        ;;
      3)
        (( ${#nodes[@]} > 1 )) || continue
        idx="$(input "Переместить выше" "Номер элемента 2..${#nodes[@]}:")" || continue
        [[ "$idx" =~ ^[0-9]+$ ]] && (( idx>=2 && idx<=${#nodes[@]} )) || { msg "Mihomo Node Failover" "Некорректный номер."; continue; }
        node="${nodes[idx-1]}"; nodes[idx-1]="${nodes[idx-2]}"; nodes[idx-2]="$node"
        ;;
      4)
        (( ${#nodes[@]} > 1 )) || continue
        idx="$(input "Переместить ниже" "Номер элемента 1..$((${#nodes[@]}-1)):")" || continue
        [[ "$idx" =~ ^[0-9]+$ ]] && (( idx>=1 && idx<${#nodes[@]} )) || { msg "Mihomo Node Failover" "Некорректный номер."; continue; }
        node="${nodes[idx-1]}"; nodes[idx-1]="${nodes[idx]}"; nodes[idx]="$node"
        ;;
      5)
        (( ${#nodes[@]} >= 2 )) || { msg "Mihomo Node Failover" "Для automatic failover нужно минимум 2 node."; continue; }
        chain="$(printf ' -> %s' "${nodes[@]}")"; chain="${chain# -> }"
        confirm "Применить FIXED chain" "Сохранить exact-node chain:\n\n$chain\n\nАвтоматический переход разрешён только слева направо; страна не выводится автоматически." || continue
        title="Mihomo node policy → FIXED"
        capture "$MIHOMO_NODE_POLICY" mode fixed "${nodes[@]}" || true
        return 0
        ;;
      6)
        current="$(cat /etc/awg-pbr/transports/mihomo/node-name 2>/dev/null || true)"
        [[ -n "$current" ]] && nodes=("$current") || nodes=()
        ;;
      7)
        title="Доступные Mihomo nodes"
        capture "$MIHOMO_CONFIGURE" node list || true
        ;;
      0) return 0 ;;
    esac
  done
}

