    current="$(current_timezone)"
    choice="$(dialog --backtitle "$BACKTITLE" --title "Часовой пояс" --item-help --menu \
      "Текущий часовой пояс: $current" 20 96 6 \
      1 "Показать текущий часовой пояс" "Показывает текущий системный часовой пояс и местное время." \
      2 "Показать список часовых поясов" "Показывает все часовые пояса IANA, доступные в системе." \
      3 "Изменить часовой пояс" "Введите точное имя IANA, например Asia/Novosibirsk или Europe/Amsterdam." \
      0 "Назад" "Не менять часовой пояс." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      1)
        msg "Часовой пояс" "Часовой пояс: $current\nМестное время: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        ;;
      2)
        title="Доступные часовые пояса"
        capture timedatectl list-timezones || true
        ;;
      3)
        zone="$(input "Часовой пояс" "Введите точное имя часового пояса IANA:" "$current")" || continue
        [[ -n "$zone" ]] || continue
        if ! timedatectl list-timezones 2>/dev/null | grep -Fxq -- "$zone"; then
          msg "Часовой пояс" "Неизвестный часовой пояс: $zone"
          continue
        fi
        confirm "Часовой пояс" "Изменить часовой пояс:\n$current → $zone ? " || continue
        if timedatectl set-timezone "$zone"; then
          msg "Часовой пояс" "Часовой пояс установлен: $zone\nМестное время: $(date '+%Y-%m-%d %H:%M:%S %Z')"
        else
          msg "Часовой пояс" "Не удалось изменить часовой пояс."
        fi
        ;;
      0) return 0 ;;
    esac
  done
}

