    return 0
  fi
  listing="$("$MIHOMO_CONFIGURE" provider candidate list 2>/dev/null)" || return 0

  node_name="$(input "Candidate node" "Введите номер или ТОЧНОЕ имя узла из staged provider:")" || return 0
