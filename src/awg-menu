paste_awg_config(){
  local rc
  install -d -m 700 /run/awg-pbr
  PASTE_TMP="$(mktemp /run/awg-pbr/config-paste.XXXXXX.conf)"
  chmod 600 "$PASTE_TMP"

  set +e
  dialog --backtitle "$BACKTITLE" --title "Вставить конфигурацию AmneziaWG" \
    --ok-label "Проверить" --cancel-label "Отмена" \
    --editbox "$PASTE_TMP" 30 110
  rc=$?
  set -e
  if (( rc != 0 )); then
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  # Text copied from Windows terminals/clipboard may contain CRLF.
  sed -i 's/\r$//' "$PASTE_TMP"
  if ! grep -q '[^[:space:]]' "$PASTE_TMP"; then
    msg "AmneziaWG" "Конфигурация пуста. Рабочий профиль не изменён."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  title="Проверка AmneziaWG"
  if ! capture "$AWG_ROUTE" config check "$PASTE_TMP"; then
    msg "AmneziaWG" "Проверка не пройдена. Рабочая конфигурация не изменена."
    rm -f "$PASTE_TMP"
    PASTE_TMP=""
    return 0
  fi

  if confirm "Установить AmneziaWG" \
    "Проверка native .conf и AWG core пройдена.\n\nСекретные ключи в итоговом окне не отображаются.\nСтарый профиль будет сохранён для rollback.\n\nУстановить проверенную конфигурацию?"; then
    title="Замена профиля"
    capture "$AWG_ROUTE" config replace "$PASTE_TMP" --yes || true
  fi

  rm -f "$PASTE_TMP"
  PASTE_TMP=""
}

awg_config_menu(){
  local choice path
  while true; do
    choice="$(dialog --backtitle "$BACKTITLE" --title "Конфигурация AmneziaWG" --item-help --menu \
      "Выберите способ установки native .conf. Перед заменой профиль проходит безопасную проверку." \
      21 100 8 \
      1 "Вставить конфигурацию текстом" "Открывает защищённое многострочное поле: вставьте native AmneziaWG .conf из буфера обмена. Сначала выполняется check." \
      2 "Загрузить конфигурацию из файла" "Использует уже существующий native .conf на Raspberry Pi и запускает транзакционную замену с rollback." \
      3 "Откатить предыдущую конфигурацию" "Меняет текущий и предыдущий профили местами и проверяет handshake/transport; используется для быстрого возврата." \
      0 "Назад" "Возвращает в меню VPN без изменений." 3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
