# New provider onboarding is unattended after the user provides the URL.
# Candidate commit is transactional and verifies the isolated backend first.
# When no eligible candidate is found, keep the staged source and offer the
# existing manual recovery UI instead of silently selecting an untested node.
mihomo_candidate_auto_apply(){
  local behavior="${1:-secondary}" node current
  node="$("$MIHOMO_POOL" best candidate 2>/dev/null || true)"
  [[ -n "$node" ]] || return 1
  title="Автоматический выбор узла Mihomo"
  capture "$MIHOMO_CONFIGURE" provider candidate commit-auto "$node" || return 1
  "$MIHOMO_NODE_POLICY" mode auto >/dev/null || return 1
  current="$("$AWG_TRANSPORT" get 2>/dev/null || echo unconfigured)"
  if [[ "$current" == unconfigured ]]; then
    capture "$AWG_TRANSPORT" select mihomo || return 1
  fi
  msg "Mihomo готов" "Подписка применена; выбран доступный узел, политика узлов AUTO. Основной работающий транспорт не переключается ради скорости. Hot Pool и READY включаются отдельно через меню; резервирование использует выбранную политику."
}

mihomo_initial_setup_flow(){
  local behavior="${1:-secondary}" profile provider_format url init_tmp

  profile="$(mihomo_source_profile_dialog)" || return 0
  [[ "$profile" != 0 ]] || return 0

  provider_format="$(mihomo_provider_format_dialog)" || return 0
  [[ "$provider_format" != 0 ]] || return 0

  url="$(input "Настройка Mihomo" "Вставьте полный URL подписки. Ввод отображается полностью.\n\nДля Citadel/Remnawave можно вставить базовую ссылку: /mihomo будет добавлен автоматически.")" || return 0
  [[ -n "$url" ]] || { msg "Mihomo" "Пустая ссылка не применена."; return 0; }

  install -d -m 700 /run/awg-pbr
  init_tmp="$(mktemp /run/awg-pbr/mihomo-init.XXXXXX)"
  chmod 600 "$init_tmp"
  {
    printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
    printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
    printf 'MIHOMO_PROVIDER_FORMAT=%q\n' "$provider_format"
  } >"$init_tmp"
  unset url

  title="Настройка Mihomo"
  if capture "$MIHOMO_CONFIGURE" init "$init_tmp"; then
    rm -f "$init_tmp"
    init_tmp=""
    if ! mihomo_candidate_auto_apply "$behavior"; then
      msg "Mihomo: автоматический выбор" "Автоматическое применение не удалось. Подготовленная подписка сохранена; можно выбрать работоспособный узел вручную."
      mihomo_candidate_menu "$behavior"
    fi
  else
    rm -f "$init_tmp"
    init_tmp=""
  fi
}

mihomo_replace_subscription(){
  local url url_tmp status current_url current_profile profile profile_label
  status="$("$MIHOMO_CONFIGURE" status 2>/dev/null || true)"
  if grep -Fqx 'Configured: no' <<<"$status"; then
    if grep -Fqx 'Provider candidate: staged' <<<"$status"; then
      confirm "Первичная настройка Mihomo" "Mihomo ещё не настроен, но есть подготовленный профиль.\n\nДля первой настройки нужно выбрать тип источника (обычный или Citadel / Remnawave). Текущий подготовленный профиль будет удалён и мастер запустится заново. Продолжить?" || return 0
      "$MIHOMO_CONFIGURE" provider candidate clear >/dev/null 2>&1 || true
    else
      msg "Первичная настройка Mihomo" "Mihomo ещё не настроен. Сейчас откроется мастер первичной настройки, где можно выбрать тип источника: обычный или Citadel / Remnawave."
    fi
    mihomo_initial_setup_flow secondary
    return 0
  fi

  current_profile="$(current_mihomo_provider_profile)"
  profile="$(mihomo_source_profile_dialog "$current_profile")" || return 0
  [[ "$profile" != 0 ]] || return 0
  case "$profile" in
    standard) profile_label="Обычная Mihomo/Clash" ;;
    remnawave) profile_label="Citadel / Remnawave" ;;
    *) return 1 ;;
  esac

  current_url="$(current_mihomo_provider_url)"
  url="$(input "Подписка Mihomo" "Введите или отредактируйте полный URL подписки. Ввод отображается полностью.\n\nТип нового источника: $profile_label.\nТекущий URL подставлен в поле, если он сохранён. После применения полный URL не выводится в обычном статусе и диагностике." "$current_url")" || return 0
  unset current_url
  [[ -n "$url" ]] || { msg "Mihomo" "Пустая ссылка не применена."; return 0; }
  if ! confirm "Подписка Mihomo" "Скачать и проверить новый источник через AUTO?\n\nТип: $profile_label\n\nПри ошибке текущая ссылка, тип источника и рабочий кэш останутся без изменений."; then
    unset url
    return 0
  fi
  install -d -m 700 /run/awg-pbr
  url_tmp="$(mktemp /run/awg-pbr/mihomo-url.XXXXXX)"
  chmod 600 "$url_tmp"
  {
    printf 'MIHOMO_PROVIDER_URL=%q\n' "$url"
    printf 'MIHOMO_PROVIDER_PROFILE=%q\n' "$profile"
  } >"$url_tmp"
  unset url
  title="Подготовка нового URL Mihomo"
  if capture "$MIHOMO_CONFIGURE" provider stage-url-file "$url_tmp"; then
    rm -f "$url_tmp"
    mihomo_candidate_menu
  else
    rm -f "$url_tmp"
  fi
}

