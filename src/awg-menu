        capture "$AWG_SELECTION" mode fixed mihomo awg || true
        ;;
      5)
        confirm "AUTO" "Разрешить AUTO: AWG → Mihomo? Исправный транспорт не меняется ради скорости. Смена узлов Mihomo управляется отдельно в «Резервирование узлов Mihomo»." || continue
