#!/usr/bin/env bash
# Deliberately narrow administrative helper. No shell, arbitrary paths or general sudo.
set -Eeuo pipefail
umask 077
[[ "${EUID}" == 0 ]] || { echo 'AWG_GPT=ROOT_REQUIRED' >&2; exit 1; }
case "${1:-}" in
  menu-update)
    [[ "$#" == 1 ]] || exit 2
    base='https://raw.githubusercontent.com/karlinksk/awg-pi'
    ref='0d79c6b995443e38426d47f7e9c420e31c574f06'
    expected='3ff58fd6cab3d14236aacd74e2bbdda25700677809d1ad274eba84d5ead7c129'
    # A menu from this candidate requires all companion executables and units.
    # Never downgrade or partially update a gateway through this narrow helper.
    [[ -x /usr/local/sbin/awg-xray-manual-switch ]] || { echo AWG_GPT=FULL_INSTALLER_UPGRADE_REQUIRED >&2; exit 1; }
    [[ -f /etc/systemd/system/awg-xray-subscription-scan.service ]] || { echo AWG_GPT=FULL_INSTALLER_UPGRADE_REQUIRED >&2; exit 1; }
    tmp="$(mktemp /tmp/awg-gpt-menu.XXXXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    curl -fL --connect-timeout 10 --max-time 60 "$base/$ref/src/awg-menu" -o "$tmp"
    printf '%s  %s\n' "$expected" "$tmp" | sha256sum -c - >/dev/null
    bash -n "$tmp"
    [[ -f /usr/local/sbin/awg-menu && ! -L /usr/local/sbin/awg-menu ]] || exit 3
    cp -a /usr/local/sbin/awg-menu "/usr/local/sbin/awg-menu.bak.$(date +%Y%m%d%H%M%S)"
    install -o root -g root -m 0755 "$tmp" /usr/local/sbin/awg-menu
    cmp -s "$tmp" /usr/local/sbin/awg-menu
    echo 'AWG_GPT_MENU_UPDATE=PASS'
    ;;
  notify-update)
    [[ "$#" == 1 ]] || exit 2
    ref='1b6386d8c77782f1846ed522cc0d62882332d4e3'
    expected='433211e98a08cfc9e05648e37d33562157fa12111c124f79856ee61e40e8aa35'
    target='/usr/local/sbin/awg-notify'
    [[ -f "$target" && ! -L "$target" ]] || { echo AWG_GPT=NOTIFIER_MISSING >&2; exit 3; }
    tmp="$(mktemp /tmp/awg-gpt-notify.XXXXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    curl -fL --connect-timeout 10 --max-time 60 "https://raw.githubusercontent.com/karlinksk/awg-pi/$ref/src/awg-notify" -o "$tmp"
    printf '%s  %s\n' "$expected" "$tmp" | sha256sum -c - >/dev/null
    python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1],encoding="utf-8").read())' "$tmp"
    backup="/var/backups/awg-gateway/awg-notify.$(date +%Y%m%d%H%M%S).bak"
    install -d -m 0700 /var/backups/awg-gateway
    cp -a -- "$target" "$backup"
    if ! install -o root -g root -m 0755 "$tmp" "$target" || ! cmp -s "$tmp" "$target"; then
      cp -a -- "$backup" "$target"
      echo AWG_GPT_NOTIFY_UPDATE=ROLLBACK >&2
      exit 1
    fi
    echo AWG_GPT_NOTIFY_UPDATE=PASS
    ;;
  *) echo 'Usage: sudo awg-gpt {menu-update|notify-update}' >&2; exit 2 ;;
esac
