#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo "$0" "$@"
# Keep aligned with install.sh and the AWG source-build CI job.
GO_TAG=v3.1.20260828
TOOLS_TAG=v3.1.20260812
GO_REVISION=b5928efb6ca19f0153958460c3d141f04abc5c2e
TOOLS_REVISION=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843
GO_REPO=https://github.com/amnezia-vpn/amneziawg-go.git
TOOLS_REPO=https://github.com/amnezia-vpn/amneziawg-tools.git
BIN_ROOT="${AWG_CORE_BIN_ROOT:-/usr/bin}"
# shellcheck disable=SC1090
source "${AWG_COMMON_FILE:-/usr/local/lib/awg-pi/common.sh}"
export PATH=/usr/local/go/bin:$PATH

matches(){
  [[ "$("$BIN_ROOT/amneziawg-go" --version 2>/dev/null | head -n1)" == "amneziawg-go $GO_TAG" &&
     "$("$BIN_ROOT/awg" --version 2>/dev/null | head -n1)" == "amneziawg-tools $TOOLS_TAG - "* &&
     -x "$BIN_ROOT/awg-quick" ]]
}
status(){
  echo "AmneziaWG supported: go=$GO_TAG tools=$TOOLS_TAG"
  "$BIN_ROOT/amneziawg-go" --version 2>/dev/null | head -n1 || true
  "$BIN_ROOT/awg" --version 2>/dev/null | head -n1 || true
  if matches; then echo CORE_UPDATE=VERSION_MATCH; else echo CORE_UPDATE=REPAIR_REQUIRED; return 1; fi
}
ASSUME_YES=0
if [[ "${1:-}" == --yes ]]; then ASSUME_YES=1; shift; fi
command_mode="${1:-ensure}"
(( $# <= 1 )) || exit 2
case "$command_mode" in
  status) status; exit $? ;;
  ensure|reinstall) ;;
  *) echo 'Usage: awg-core-update [--yes] [status|reinstall]' >&2; exit 2 ;;
esac
# Explicit reinstall keeps the normal pinned source and inactive-engine guards.
if [[ "$command_mode" == ensure ]] && matches; then status; exit 0; fi
awg_engine_lock
# Never stop AWG, call failopen, edit vpn-enabled or touch routing, even on
# rollback. Active/selected AWG is deferred; the incumbent stays untouched.
awg_engine_inactive awg awg-quick@awg0.service
if (( ASSUME_YES == 0 )); then
  read -r -p 'Install release-pinned AWG on the inactive engine? [y/N]: ' answer </dev/tty
  [[ "$answer" =~ ^[Yy] ]] || exit 0
fi
command -v go >/dev/null || { echo CORE_UPDATE=MISSING_GO_TOOLCHAIN >&2; exit 1; }
temp="$(mktemp -d)"
AWG_ENGINE_TEMP="$temp"
trap 'rm -rf -- "$temp"' EXIT
checkout(){
  local repo="$1" tag="$2" revision="$3" dir="$4"
  git clone --depth 1 --branch "$tag" "$repo" "$dir"
  [[ "$(git -C "$dir" rev-parse HEAD)" == "$revision" ]]
}
checkout "$GO_REPO" "$GO_TAG" "$GO_REVISION" "$temp/go"
checkout "$TOOLS_REPO" "$TOOLS_TAG" "$TOOLS_REVISION" "$temp/tools"
make -C "$temp/go"
make -C "$temp/tools/src"
[[ "$("$temp/go/amneziawg-go" --version | head -n1)" == "amneziawg-go $GO_TAG" ]]
[[ "$("$temp/tools/src/wg" --version | head -n1)" == "amneziawg-tools $TOOLS_TAG - "* ]]
bash -n "$temp/tools/src/wg-quick/linux.bash"
awg_engine_inactive awg awg-quick@awg0.service
# Existing unit and private profiles are deliberately preserved.
awg_engine_publish awg \
  "$temp/go/amneziawg-go" "$BIN_ROOT/amneziawg-go" \
  "$temp/tools/src/wg" "$BIN_ROOT/awg" \
  "$temp/tools/src/wg-quick/linux.bash" "$BIN_ROOT/awg-quick"
matches
bash -n "$BIN_ROOT/awg-quick"
awg_engine_commit
rm -rf -- "$temp"
echo 'CORE_UPDATE=PINNED_VERIFIED_RESTART_NOT_PERFORMED'
