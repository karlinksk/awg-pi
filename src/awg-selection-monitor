#!/usr/bin/env bash
set -Eeuo pipefail

AWG_COMMON_FILE="${AWG_COMMON_FILE:-/usr/local/lib/awg-pi/common.sh}"
AWG_SELECTION_FILE="${AWG_SELECTION_FILE:-/etc/awg-pbr/selection.env}"
AWG_TRANSPORT_CLI="${AWG_TRANSPORT_CLI:-/usr/local/sbin/awg-transport}"
MIHOMO_NODE_POLICY_CLI="${MIHOMO_NODE_POLICY_CLI:-/usr/local/sbin/awg-mihomo-node-policy}"
AWG_SELECTION_STATE_DIR="${AWG_SELECTION_STATE_DIR:-/run/awg-pbr}"
AWG_SELECTION_FAILURES="${AWG_SELECTION_FAILURES:-$AWG_SELECTION_STATE_DIR/selection.failures}"
AWG_SELECTION_INTERVAL="${AWG_SELECTION_INTERVAL:-10}"
AWG_SELECTION_FAILURE_THRESHOLD="${AWG_SELECTION_FAILURE_THRESHOLD:-3}"
LOGGER_BIN="${LOGGER_BIN:-logger}"
SLEEP_BIN="${SLEEP_BIN:-sleep}"
MAINTENANCE_LOCK="${AWG_LOCK_FILE:-/run/awg-maintenance.lock}"
# Opt-in only. Existing transport health checks stay unchanged by default.
MIHOMO_SERVICE_GATE_MODE_FILE="${MIHOMO_SERVICE_GATE_MODE_FILE:-/etc/awg-pbr/transports/mihomo/service-eligibility.mode}"
if [[ -z "${MIHOMO_SERVICE_GATE_MODE+x}" ]]; then
  MIHOMO_SERVICE_GATE_MODE="$(cat "$MIHOMO_SERVICE_GATE_MODE_FILE" 2>/dev/null || echo off)"
fi
MIHOMO_SERVICE_CHECK_BIN="${MIHOMO_SERVICE_CHECK_BIN:-/usr/local/sbin/awg-mihomo-service-check.py}"
MIHOMO_SERVICE_NODE_FILE="${MIHOMO_SERVICE_NODE_FILE:-/etc/awg-pbr/transports/mihomo/node-name}"
MIHOMO_SERVICE_CHECK_INTERVAL="${MIHOMO_SERVICE_CHECK_INTERVAL:-60}"
SERVICE_LAST_TS=0
SERVICE_BAD_PROBES=0
SERVICE_LAST_NODE=""


# shellcheck disable=SC1090
source "$AWG_COMMON_FILE"

mkdir -p "$AWG_SELECTION_STATE_DIR"

log_event(){
  "$LOGGER_BIN" -t awg-selection "$*" 2>/dev/null || true
}

load_policy(){
  SELECTION_MODE=manual
  SELECTION_PRIMARY=""
  SELECTION_ORDER=""
  if [[ -r "$AWG_SELECTION_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$AWG_SELECTION_FILE"
  fi
  case "${SELECTION_MODE:-}" in manual|fixed|auto) return 0 ;; *) return 1 ;; esac
}

read_failures(){
  local n
  n="$(cat "$AWG_SELECTION_FAILURES" 2>/dev/null || echo 0)"
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  printf '%s\n' "$n"
}

write_failures(){
  printf '%s\n' "$1" >"$AWG_SELECTION_FAILURES"
}

reset_failures(){
  write_failures 0
}

maintenance_in_progress(){
  exec 8>"$MAINTENANCE_LOCK"
  if flock -n 8; then
    flock -u 8
    return 1
  fi
  return 0
}

transport_healthy(){
  local t="$1"
  awg_transport_backend_valid "$t" || return 1
  "$AWG_TRANSPORT_CLI" check "$t" >/dev/null 2>&1 || return 1
  if [[ "$t" == mihomo ]]; then
    "$AWG_TRANSPORT_CLI" network-check >/dev/null 2>&1
  fi
}

service_probe_verdict(){
  # Checker exit code alone cannot tell explicit regional denial from an
  # anonymous Cloudflare/YouTube UNKNOWN: only JSON verdict FAIL is negative.
  # Limit/parse strictly. Malformed/empty responses return UNKNOWN.
  local response
  response="$("$MIHOMO_SERVICE_CHECK_BIN" --proxy-port 7890 --timeout 4 2>/dev/null)" || true
  printf '%s' "${response:0:8192}" | python3 -c '
import json,sys
try:
    obj=json.loads(sys.stdin.read(8192))
    state=obj.get("status") if isinstance(obj,dict) else None
    print(state if state in ("PASS","FAIL","UNKNOWN") else "UNKNOWN")
except (ValueError,UnicodeError):
    print("UNKNOWN")
' 2>/dev/null || printf 'UNKNOWN\n'
}

service_healthy_mihomo(){
  # Persisted legacy service eligibility must not veto a transport.
  return 0
}

policy_csv(){
  case "$SELECTION_MODE" in
    fixed)
      if [[ -n "$SELECTION_PRIMARY" && -n "$SELECTION_ORDER" ]]; then
        printf '%s,%s\n' "$SELECTION_PRIMARY" "$SELECTION_ORDER"
      else
        printf '%s\n' "${SELECTION_PRIMARY:-$SELECTION_ORDER}"
      fi
      ;;
    auto)
      printf '%s\n' "${SELECTION_ORDER:-}"
      ;;
    *)
      printf '\n'
      ;;
  esac
}

current_is_allowed(){
  local current="$1" csv item
  csv="$(policy_csv)"
  IFS=',' read -ra _items <<<"$csv"
  for item in "${_items[@]}"; do
    [[ -n "$item" && "$item" == "$current" ]] && return 0
  done
  return 1
}

try_failover(){
  local current="$1" csv candidate
  csv="$(policy_csv)"
  IFS=',' read -ra _items <<<"$csv"
  for candidate in "${_items[@]}"; do
    [[ -n "$candidate" && "$candidate" != "$current" ]] || continue
    # An unconfigured AWG backend is NOT a standby. In particular, don't
    # attempt awg-quick every ten seconds when awg0.conf is absent.
    # A configured cold standby may still be started by awg-transport,
    # which validates its handshake/preflight before making it active.
    if [[ "$candidate" == awg &&
          ! -s "${AWG_AUTO_AWG_CONFIG:-/etc/amnezia/amneziawg/awg0.conf}" ]]; then
      continue
    fi
    # A fallback backend may be intentionally stopped while on standby.
    # awg-transport select starts it, validates health/preflight and rolls
    # back safely if activation fails.
    if AWG_NOTIFY_AUTOMATIC=1 "$AWG_TRANSPORT_CLI" select "$candidate" >/dev/null; then
      log_event "Automatic failover: $current -> $candidate (mode=$SELECTION_MODE)"
      reset_failures
      printf 'FAILOVER=%s->%s\n' "$current" "$candidate"
      return 0
    fi
  done
  return 1
}

selection_cycle(){
  local current failures health_rc=0 node_policy_enabled=0 transport_policy_enabled=0

  # Configuration/node transactions hold the same maintenance lock. Never
  # interpret their intentional short outage as a real transport failure.
  if maintenance_in_progress; then
    return 0
  fi

  if ! load_policy; then
    log_event "Invalid transport selection policy; transport auto-switching disabled"
    SELECTION_MODE=manual
    SELECTION_PRIMARY=""
    SELECTION_ORDER=""
  fi

  current="$(awg_transport_get 2>/dev/null || echo unconfigured)"

  if [[ "$current" == unconfigured ]]; then
    # Do not poll unavailable transports on a freshly installed gateway with
    # neither private configuration supplied yet. The same policy becomes
    # effective automatically after the operator adds the first backend.
    if [[ ! -s "${AWG_AUTO_AWG_CONFIG:-/etc/amnezia/amneziawg/awg0.conf}" &&
          ! -s "${AWG_AUTO_MIHOMO_NODE:-/etc/awg-pbr/transports/mihomo/node-name}" ]]; then
      reset_failures
      return 0
    fi
    if [[ "$SELECTION_MODE" != manual ]] && try_failover unconfigured; then
      return 0
    fi
    reset_failures
    return 0
  fi

  if [[ "$current" == mihomo && -x "$MIHOMO_NODE_POLICY_CLI" ]] &&
     "$MIHOMO_NODE_POLICY_CLI" enabled >/dev/null 2>&1; then
    node_policy_enabled=1
  fi

  if [[ "$SELECTION_MODE" != manual ]] && current_is_allowed "$current"; then
    transport_policy_enabled=1
  fi

  # MANUAL transport policy does not disable a separately and explicitly
  # configured Mihomo exact-node failover policy.
  if (( node_policy_enabled == 0 && transport_policy_enabled == 0 )); then
    reset_failures
    return 0
  fi

  transport_healthy "$current" || health_rc=$?
  if (( health_rc == 0 )); then
    if [[ "$current" != mihomo ]] || service_healthy_mihomo; then
      reset_failures
      return 0
    fi
  fi

  if (( health_rc == 2 )); then
    log_event 'AUTO network assessment unavailable or selection changed; no node-failure evidence'
    return 0
  fi

  failures="$(read_failures)"
  failures=$((failures + 1))
  write_failures "$failures"

  if (( failures < AWG_SELECTION_FAILURE_THRESHOLD )); then
    return 0
  fi

  # Exact-node recovery has priority over changing the transport. The node
  # policy can only choose names the user explicitly placed in its allow-list.
  if (( node_policy_enabled == 1 )); then
    node_out="$("$MIHOMO_NODE_POLICY_CLI" failover 2>/dev/null || true)"
    if [[ "$node_out" == MIHOMO_NODE_FAILOVER=* ]]; then
      log_event "Automatic Mihomo node failover: ${node_out#MIHOMO_NODE_FAILOVER=}"
      # Passive notification after the node-policy confirmed the switch.
      # Never hold recovery for a Telegram network request.
      if [[ -s /etc/awg-pbr/notify/telegram.json &&
            -x /usr/local/sbin/awg-notify ]] &&
         systemctl is-enabled --quiet awg-notify-flush.timer 2>/dev/null; then
        printf 'Automatic Mihomo node switch: %s' "${node_out#MIHOMO_NODE_FAILOVER=}" |
          timeout 2s /usr/local/sbin/awg-notify emit --kind NODE_SWITCH \
            --severity info >/dev/null 2>&1 || true
      fi
      reset_failures
      printf '%s\n' "$node_out"
      return 0
    fi
  fi

  if (( transport_policy_enabled == 1 )) && try_failover "$current"; then
    return 0
  fi

  # Keep the counter saturated so a recovered explicitly allowed node/transport
  # can be retried on the next cycle without extra persistent state.
  write_failures "$AWG_SELECTION_FAILURE_THRESHOLD"
  return 0
}

while true; do
  selection_cycle
  [[ "${AWG_SELECTION_ONCE:-0}" == 1 ]] && break
  "$SLEEP_BIN" "$AWG_SELECTION_INTERVAL"
done
